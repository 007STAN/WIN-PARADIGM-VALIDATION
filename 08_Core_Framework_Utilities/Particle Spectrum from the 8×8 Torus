## 10. Reproducible Verification Script

```python
# ==============================================================================
# WIN PARADIGM — PARTICLE SPECTRUM FROM THE 8x8 TORUS
# Verification script
# ==============================================================================

import numpy as np

# Build the 8x8 torus Laplacian
L_size = 8
N = L_size * L_size

def torus_index(x, y):
    return (x % L_size) * L_size + (y % L_size)

L = np.zeros((N, N))
for x in range(L_size):
    for y in range(L_size):
        i = torus_index(x, y)
        L[i, i] = 4.0
        L[i, torus_index(x+1, y)] -= 1.0
        L[i, torus_index(x-1, y)] -= 1.0
        L[i, torus_index(x, y+1)] -= 1.0
        L[i, torus_index(x, y-1)] -= 1.0

eigenvalues, eigenvectors = np.linalg.eigh(L)
idx_14 = np.where(np.abs(eigenvalues - 4.0) < 1e-6)[0]
modes = eigenvectors[:, idx_14]

# Sort by entropy
entropies = []
for i in range(14):
    p = modes[:, i] ** 2
    p = p / np.sum(p)
    S = -np.sum(p * np.log(p + 1e-30))
    entropies.append(S)

order = np.argsort(entropies)[::-1]
modes_sorted = modes[:, order]

# N/4 values
N4_values = np.array([60, 24, 21, 20, 14, 14, 12, 9.5, 9, 7.5, 2, 2, 1, 0.5])
particle_names = ['nu', 'e', 'u', 'd', 's', 'mu', 'dark', 'c', 'tau', 'b', 'W', 'Z', 'H', 't']

# Optimal shells
shell_opt = np.array([0, 1, 1, 1, 1.5, 1.5, 1.5, 2, 2, 2, 3, 3, 3, 3])

# IPR and PR
IPR = np.array([np.sum(modes_sorted[:, i]**4) for i in range(14)])
PR = 1.0 / IPR

# Model parameters
kL = 38.442527
H = 16
d = 4
A = kL / (H + d)
B = np.pi / d

# Predicted N/4
predicted_N4 = A * PR * np.exp(-B * shell_opt)
residuals = N4_values - predicted_N4
rmse = np.sqrt(np.mean(residuals**2))

print("WIN Paradigm — Particle Spectrum from the 8x8 Torus")
print("=" * 60)
print(f"A = kL/(H+d) = {A:.6f}")
print(f"B = pi/d = {B:.6f}")
print(f"RMS = {rmse:.4f}")
print()
print(f"{'Particle':<8} {'Shell':<8} {'N/4':<8} {'Predicted':<12} {'Residual':<12}")
print("-" * 55)
for i in range(14):
    print(f"{particle_names[i]:<8} {shell_opt[i]:<8.1f} {N4_values[i]:<8.1f} "
          f"{predicted_N4[i]:<12.4f} {residuals[i]:<12.4f}")
print()
print(f"RMS = {rmse:.4f}")
```

