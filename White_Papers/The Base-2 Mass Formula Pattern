## Appendix B — Reproducible Verification Script

```python
import numpy as np
from scipy.optimize import brentq

d = 4
N = 64
H = 16
V = 48
kL = 38.442527
ratio_e = 0.025954

A = kL / 7.88
B = H + kL / 26
C = -kL * (d + 4.23)

def m_f(r):
    return A * (r / ratio_e)**B * np.exp(C * (r - ratio_e))

particles = {
    "nu": 0.025277, "e": 0.025954, "u": 0.027005, "d": 0.027909,
    "s": 0.028405, "mu": 0.029813, "c": 0.030461, "tau": 0.031913,
    "b": 0.033079, "W": 0.033236, "Z": 0.033262, "H": 0.041677,
    "t": 0.067489,
}

r_max = -B / C
m_max = m_f(r_max)

def find_crossovers(target):
    solutions = []
    r_lo, r_hi = 0.015, 0.15
    if target > m_max or target <= 0:
        return solutions
    try:
        if (m_f(r_lo) - target) * (m_f(r_max) - target) < 0:
            solutions.append(brentq(lambda r: m_f(r) - target, r_lo, r_max))
    except: pass
    return solutions

print("Base-2 pattern:")
for n in range(0, 4):
    target = kL / (2**n)
    sols = find_crossovers(target)
    if sols:
        r_cross = sols[0]
        nearest = min(particles.items(), key=lambda kv: abs(kv[1] - r_cross))
        error = 100 * abs(nearest[1] - r_cross) / r_cross
        print(f"  n = {n}: target = {target:.4f}, nearest = {nearest[0]} "
              f"(ratio {nearest[1]:.6f}), error = {error:.4f}%")

