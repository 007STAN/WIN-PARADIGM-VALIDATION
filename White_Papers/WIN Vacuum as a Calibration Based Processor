    return 4 - 2*np.cos(2*np.pi*n1/L) - 2*np.cos(2*np.pi*n2/L)

modes = [(n1, n2) for n1 in range(L) for n2 in range(L)
         if abs(lam(n1, n2) - 4) < 1e-9]
