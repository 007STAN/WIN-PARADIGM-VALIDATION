frame_slider = widgets.IntSlider(
    value=0, min=0, max=len(theta_hist) - 1, step=1,
    description="Frame:",
    continuous_update=False,
    layout=widgets.Layout(width="500px"),
)

play_button = widgets.ToggleButton(
    value=False, description="Play",
    button_style="success",
    layout=widgets.Layout(width="100px"),
)

reset_button = widgets.Button(
    description="Reset",
    layout=widgets.Layout(width="100px"),
)

out = widgets.Output()

def render(frame_idx):
    with out:
        clear_output(wait=True)
        fig = build_figure(frame_idx)
        fig.show()

def on_slider_change(change):
    if change["name"] == "value":
        render(change["new"])

frame_slider.observe(on_slider_change, names="value")

def on_reset(_):
    play_button.value = False
    frame_slider.value = 0
    render(0)

reset_button.on_click(on_reset)

def animate():
    while play_button.value:
        new_val = frame_slider.value + 1
        if new_val >= len(theta_hist):
            new_val = 0
        frame_slider.value = new_val
        time.sleep(0.05)

def on_play_change(change):
    if change["name"] == "value":
        if change["new"]:
            play_button.description = "Pause"
            animate()
        else:
            play_button.description = "Play"

play_button.observe(on_play_change, names="value")

