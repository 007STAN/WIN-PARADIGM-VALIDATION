coupling_candidates = [
    ("J = kL/N (derived)", J_derived),
    ("J = 1 (order unity)", 1.0),
    ("J = 1/2 (bare Laplacian)", 0.5),
    ("J = 1/d (dimensional)", 1/d),
    ("J = 1/sqrt(N)", 1/np.sqrt(N)),
    ("J = 1/kL", 1/kL),
    ("J = exp(-kL)", np.exp(-kL)),
]

coupling_results = []
for label, J in coupling_candidates:
    _, r_local, t_local = kuramoto_run(
        L_sim, J, n_steps=1500, dt=0.05,
        record_every=4, seed=42,
    )
    sync_idx_local = np.where(r_local > threshold)[0]
    t_sync = t_local[sync_idx_local[0]] if len(sync_idx_local) > 0 else np.inf
    coupling_results.append((label, J, r_local[-1], t_sync))
    print(f"  {label:>28}: J = {J:.6f}, r_final = {r_local[-1]:.4f}, "
          f"t_sync = {t_sync:.4f}")

print()

# ============================================================
# FIGURE BUILDER
# ============================================================
def build_figure(frame_idx):
    """Build the animation frame."""
    theta = theta_hist[frame_idx]
    L = L_sim

    fig = make_subplots(
        rows=1, cols=3,
        column_widths=[0.35, 0.35, 0.30],
        subplot_titles=(
            f"Phase configuration (step {frame_idx * record_every})",
            "Order parameter r(t)",
            "Phase distribution on unit circle",
        ),
        specs=[[{"type": "xy"}, {"type": "xy"}, {"type": "xy"}]],
        horizontal_spacing=0.10,
    )

    # --- Left: phase grid as heatmap ---
    theta_grid = theta.reshape(L, L)
    fig.add_trace(go.Heatmap(
        z=theta_grid,
        zmin=0, zmax=2*np.pi,
        colorscale="HSV",
        hovertemplate="phase at cell (%{x}, %{y}) = %{z:.2f} rad<extra></extra>",
        showscale=False,
    ), row=1, col=1)

    # Overlay grid lines
    for i in range(L + 1):
        fig.add_shape(type="line", x0=i - 0.5, x1=i - 0.5,
                      y0=-0.5, y1=L - 0.5,
                      line=dict(color="white", width=1),
                      row=1, col=1)
        fig.add_shape(type="line", x0=-0.5, x1=L - 0.5,
                      y0=i - 0.5, y1=i - 0.5,
                      line=dict(color="white", width=1),
                      row=1, col=1)

    # --- Middle: order parameter curve ---
    fig.add_trace(go.Scatter(
        x=t_hist, y=r_hist,
        mode="lines",
        line=dict(color="#4C72B0", width=2),
        hovertemplate="t = %{x:.3f}<br>r = %{y:.4f}<extra></extra>",
        showlegend=False,
    ), row=1, col=2)

    fig.add_trace(go.Scatter(
        x=[t_hist[frame_idx]], y=[r_hist[frame_idx]],
        mode="markers",
        marker=dict(size=14, color="#DD8452",
                    line=dict(width=2, color="black")),
        hovertemplate=f"t = {t_hist[frame_idx]:.3f}<br>"
                      f"r = {r_hist[frame_idx]:.4f}<extra></extra>",
        showlegend=False,
    ), row=1, col=2)

    fig.add_shape(type="line", x0=t_hist[0], x1=t_hist[-1],
                  y0=threshold, y1=threshold,
                  line=dict(color="#C44E52", width=1, dash="dot"),
                  row=1, col=2)

    # --- Right: unit circle phasor diagram ---
    circle_t = np.linspace(0, 2 * np.pi, 200)
    fig.add_trace(go.Scatter(
        x=np.cos(circle_t), y=np.sin(circle_t),
        mode="lines",
        line=dict(color="#CCC", width=1),
        hoverinfo="skip", showlegend=False,
    ), row=1, col=3)

    # Plot each oscillator on the unit circle
    for th in theta:
        fig.add_trace(go.Scatter(
            x=[np.cos(th)], y=[np.sin(th)],
            mode="markers",
            marker=dict(size=6, color="#4C72B0",
                        line=dict(width=0.5, color="black")),
            hoverinfo="skip", showlegend=False,
        ), row=1, col=3)

    # Mean field vector
    z = np.mean(np.exp(1j * theta))
    r_now = np.abs(z)
    phi = np.angle(z)
    fig.add_trace(go.Scatter(
        x=[0, r_now * np.cos(phi)], y=[0, r_now * np.sin(phi)],
        mode="lines+markers",
        line=dict(color="#C44E52", width=3),
        marker=dict(size=[0, 12], color=["rgba(0,0,0,0)", "#C44E52"]),
        hoverinfo="skip", showlegend=False,
    ), row=1, col=3)

    # Axes
    fig.update_xaxes(range=[-0.5, L - 0.5], showgrid=False,
                     showticklabels=False, row=1, col=1)
    fig.update_yaxes(range=[L - 0.5, -0.5], showgrid=False,
                     showticklabels=False, scaleanchor="x",
                     scaleratio=1, row=1, col=1)

    fig.update_xaxes(title_text="time (natural units)",
                     showgrid=True, gridcolor="#EEE", row=1, col=2)
    fig.update_yaxes(title_text="order parameter r",
                     range=[0, 1.05], showgrid=True, gridcolor="#EEE",
                     row=1, col=2)

    fig.update_xaxes(range=[-1.3, 1.3], showgrid=False,
                     zeroline=False, showticklabels=False, row=1, col=3)
    fig.update_yaxes(range=[-1.3, 1.3], showgrid=False,
                     zeroline=False, showticklabels=False,
                     scaleanchor="x", scaleratio=1, row=1, col=3)

    fig.update_layout(
        title=dict(
            text=f"<b>Mesh Synchronization with J = kL/N = {J_derived:.4f}</b><br>"
                 f"<sub>Frame {frame_idx+1}/{len(theta_hist)} &middot; "
                 f"r = {r_hist[frame_idx]:.4f}</sub>",
            x=0.5, xanchor="center",
        ),
        height=520,
        margin=dict(l=40, r=40, t=100, b=50),
        plot_bgcolor="white",
        showlegend=False,
        hovermode="closest",
    )
    return fig

