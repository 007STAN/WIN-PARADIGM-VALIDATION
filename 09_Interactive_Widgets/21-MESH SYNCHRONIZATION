# ============================================================
# KURAMOTO SIMULATION
# ============================================================
def make_neighbors(L):
    neighbors = [[] for _ in range(L * L)]
    for i in range(L):
        for j in range(L):
            idx = i * L + j
            for di, dj in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                ni = (i + di) % L
                nj = (j + dj) % L
                neighbors[idx].append(ni * L + nj)
    return neighbors

def kuramoto_run(L, J, n_steps, dt, seed=42,
                 record_every=1, theta_init=None):
    rng = np.random.default_rng(seed)
    N_cells = L * L
    if theta_init is None:
        theta = rng.uniform(0, 2 * np.pi, N_cells)
    else:
        theta = theta_init.copy()

    neighbors = make_neighbors(L)
    omega = np.full(N_cells, omega_0)

    theta_history, r_history, times = [], [], []

    for step in range(n_steps):
        if step % record_every == 0:
            z = np.mean(np.exp(1j * theta))
            theta_history.append(theta.copy())
            r_history.append(np.abs(z))
            times.append(step * dt)

        dtheta = np.zeros(N_cells)
        for i in range(N_cells):
            coupling = sum(np.sin(theta[j] - theta[i])
                           for j in neighbors[i])
            dtheta[i] = omega[i] + J * coupling
        theta += dtheta * dt

    return (np.array(theta_history), np.array(r_history),
            np.array(times))

# ============================================================
# RUN AT DERIVED COUPLING
# ============================================================
L_sim = 8
n_steps = 800
dt = 0.05
record_every = 4
threshold = 0.9

print("=" * 70)
