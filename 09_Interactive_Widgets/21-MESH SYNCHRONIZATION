print(f"  J (derived coupling): {J_derived:.6f}")
print(f"  Steps: {n_steps}, dt: {dt}")
print()

theta_hist, r_hist, t_hist = kuramoto_run(
    L_sim, J_derived, n_steps, dt,
    record_every=record_every, seed=42,
)

sync_idx = np.where(r_hist > threshold)[0]
sync_time = t_hist[sync_idx[0]] if len(sync_idx) > 0 else None

print(f"  Final order parameter: r = {r_hist[-1]:.4f}")
if sync_time is not None:
    print(f"  Sync time: {sync_time:.4f} natural units")
else:
    print(f"  Sync not reached within {n_steps} steps")
print()

