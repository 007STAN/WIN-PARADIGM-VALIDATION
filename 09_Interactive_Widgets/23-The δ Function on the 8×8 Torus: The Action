# ------------------------------------------------------------
# The δ function
# ------------------------------------------------------------
def delta_rule(n1, n2, support):
    """The piecewise δ function on the 8×8 torus."""
    diff = abs(n2 - n1)
    if support == 64:
        if n1 == 0: return +33.0   # 2d² + 1
        if n1 == 4: return +6.0    # d + 2
    if support == 48:
        if n1 == 1: return +3.0    # d − 1
        if n1 == 3: return -3.0    # −(d − 1)
        if n1 in (5, 7):
            if diff == 2: return 0.0
            if diff == 4: return +0.5   # 2/d
    if support == 32:
        if n1 == 6 and n2 == 6: return +0.5   # 2/d
        return 0.0
    return None

# ------------------------------------------------------------
# The framework expressions for each δ value
# ------------------------------------------------------------
delta_expressions = {
    +33.0:  ("2d² + 1", f"2·{d}² + 1 = {2*d**2+1}"),
    +6.0:   ("d + 2",   f"{d} + 2 = {d+2}"),
    +3.0:   ("d − 1",   f"{d} − 1 = {d-1}"),
    -3.0:   ("−(d − 1)", f"−({d} − 1) = {-(d-1)}"),
    +0.5:   ("2/d",     f"2/{d} = {2/d}"),
    0.0:    ("0",       "0"),
}

# ------------------------------------------------------------
# Color map for the modes by support
# ------------------------------------------------------------
support_colors = {
    64: "#d62728",   # red
    48: "#1f77b4",   # blue
    32: "#2ca02c",   # green
}

support_names = {
    64: "Support 64 = N",
    48: "Support 48 = V",
    32: "Support 32 = N/2",
}

# ------------------------------------------------------------
# Figure
# ------------------------------------------------------------
def make_figure(mode_index=0, show_all=True, show_rule=True, show_expressions=True):
    fig = plt.figure(figsize=(16, 10))
    fig.suptitle("Widget #23 — The δ Function on the 8×8 Torus",
                 fontsize=16, fontweight="bold", y=0.98)

    # ============================================================
    # Panel 1 — The 8×8 torus with the 14 modes
    # ============================================================
    ax1 = fig.add_axes([0.05, 0.55, 0.40, 0.38])
    ax1.set_title("The 8×8 torus and the 14 modes at λ = 4", fontsize=12)
    ax1.set_xlim(-0.6, 7.6)
    ax1.set_ylim(-0.6, 7.6)
    ax1.set_aspect("equal")
    ax1.set_xticks(range(8))
    ax1.set_yticks(range(8))
    ax1.grid(True, alpha=0.3)
    ax1.set_xlabel("n₁")
    ax1.set_ylabel("n₂")

    # Draw the grid points
    for i in range(8):
        for j in range(8):
            ax1.plot(i, j, "o", color="lightgray", markersize=4, zorder=1)

    # Draw the diagonal n₂ = n₁
    ax1.plot([-0.6, 7.6], [-0.6, 7.6], "--", color="gray", alpha=0.5,
             linewidth=1, label="diagonal n₂ = n₁")

    # Highlight the 14 modes
    for idx, (name, n1, n2, support, base, delta, N4) in enumerate(modes):
        color = support_colors[support]
        # Highlight the selected mode
        if show_all or idx == mode_index:
            size = 300 if idx == mode_index else 120
            alpha = 1.0 if idx == mode_index else 0.5
            ax1.scatter(n1, n2, s=size, color=color, alpha=alpha,
                        edgecolor="black", linewidth=1.5, zorder=3)
        ax1.annotate(name, (n1, n2), fontsize=8, ha="center", va="center",
                     color="white", fontweight="bold", zorder=4)

    # Legend
    from matplotlib.lines import Line2D
    legend_elements = [
        Line2D([0], [0], marker="o", color="w", markerfacecolor=support_colors[64],
               markersize=10, label=support_names[64]),
        Line2D([0], [0], marker="o", color="w", markerfacecolor=support_colors[48],
               markersize=10, label=support_names[48]),
        Line2D([0], [0], marker="o", color="w", markerfacecolor=support_colors[32],
               markersize=10, label=support_names[32]),
    ]
    ax1.legend(handles=legend_elements, loc="upper left", fontsize=8)

    # ============================================================
    # Panel 2 — The δ function's branches
    # ============================================================
    ax2 = fig.add_axes([0.55, 0.55, 0.40, 0.38])
    ax2.set_title("The δ function's branches", fontsize=12)
    ax2.set_xlim(-0.5, 8.5)
    ax2.set_ylim(-5, 38)
    ax2.set_xlabel("n₁")
    ax2.set_ylabel("δ")
    ax2.grid(True, alpha=0.3)

    # Plot each mode as a point
    for idx, (name, n1, n2, support, base, delta, N4) in enumerate(modes):
        color = support_colors[support]
        size = 200 if idx == mode_index else 80
        alpha = 1.0 if idx == mode_index else 0.5
        ax2.scatter(n1, delta, s=size, color=color, alpha=alpha,
                    edgecolor="black", linewidth=1.5, zorder=3)
        # Label the selected mode
        if idx == mode_index:
            ax2.annotate(f"{name} ({n1},{n2})",
                         (n1, delta), textcoords="offset points",
                         xytext=(10, 10), fontsize=9, fontweight="bold")

    # Draw the linear rule for n₁ ∈ {1, 2, 3}
    n1_linear = np.array([1, 2, 3])
    delta_linear = 3 * (2 - n1_linear)
    ax2.plot(n1_linear, delta_linear, "--", color="black", alpha=0.7,
             linewidth=2, label="δ = 3(2 − n₁) for n₁ ∈ {1,2,3}")

    ax2.legend(loc="upper right", fontsize=8)

    # ============================================================
    # Panel 3 — The decomposition: base + δ = N/4
    # ============================================================
    ax3 = fig.add_axes([0.05, 0.08, 0.90, 0.38])
    ax3.set_title("The decomposition: N/4 = base + δ", fontsize=12)

    # Prepare data
    names = [m[0] for m in modes]
    bases = np.array([m[4] for m in modes])
    deltas_arr = np.array([m[5] for m in modes])
    n4s = np.array([m[6] for m in modes])
    supports = [m[3] for m in modes]

    x = np.arange(len(names))
    width = 0.6

    # Bars for base
    bars_base = ax3.bar(x, bases, width, label="base (from d, H)",
                        color="lightblue", edgecolor="black", linewidth=0.5)

    # Bars for δ (stacked on top)
    colors_delta = [support_colors[s] for s in supports]
    bars_delta = ax3.bar(x, deltas_arr, width, bottom=bases,
                         label="δ (from the δ function)",
                         color=colors_delta, edgecolor="black",
                         linewidth=0.5, alpha=0.8)

    # Markers for N/4
    ax3.scatter(x, n4s, color="black", s=80, zorder=5,
                label="N/4 (observed)", marker="D")

    ax3.set_xticks(x)
    ax3.set_xticklabels(names, fontsize=9)
    ax3.set_ylabel("Value")
    ax3.set_xlabel("Particle")
    ax3.axhline(0, color="black", linewidth=0.5)
    ax3.legend(loc="upper right", fontsize=9)
    ax3.grid(True, alpha=0.3, axis="y")

    # Highlight the selected mode
    ax3.axvspan(mode_index - 0.4, mode_index + 0.4, color="yellow",
                alpha=0.2, zorder=0)

    # ============================================================
    # Panel 4 — Framework expressions
    # ============================================================
    if show_expressions:
        ax4 = fig.add_axes([0.05, -0.02, 0.90, 0.08])
        ax4.axis("off")
        ax4.set_xlim(0, 1)
        ax4.set_ylim(0, 1)

        # Header
        ax4.text(0.5, 0.9, "Framework expressions for the δ values",
                 fontsize=11, fontweight="bold", ha="center")

        # List the expressions
        x_pos = 0.05
        y_pos = 0.4
        for delta_val, (expr, evaluation) in delta_expressions.items():
            ax4.text(x_pos, y_pos, f"δ = {delta_val:+.1f}: {expr} = {evaluation}",
                     fontsize=9, ha="left", va="center")
            x_pos += 0.16

    return fig

# ------------------------------------------------------------
# Interactive widget
# ------------------------------------------------------------
@interact(
    mode_index=IntSlider(min=0, max=13, step=1, value=0,
                         description="Mode index"),
    show_all=Checkbox(value=True, description="Show all modes"),
    show_rule=Checkbox(value=True, description="Show linear rule"),
    show_expressions=Checkbox(value=True, description="Show expressions"),
)
def update(mode_index=0, show_all=True, show_rule=True, show_expressions=True):
    fig = make_figure(mode_index, show_all, show_rule, show_expressions)
    plt.show()

