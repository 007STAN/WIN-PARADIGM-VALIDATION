# ============================================================
# FRAMEWORK CONSTANTS
# ============================================================

kL_observed = 38.442488
pi = np.pi

def five_six(d):
    N = d * 2**d
    return (N - 2*d) / (2 * (d + 1))

def five_four_four(d):
    return five_six(d) - d / (d + 1)**2

def kL_from_formula(d, sin2):
    N = d * 2**d
    return N * (d - 1) / (d + 1) + sin2 / five_four_four(d)

def sin2_from_formula(d, kL):
    return 3/8 - 0.165460 + kL / (5.6 * pi * 100)

# ============================================================
# STEP 1 — kL FROM d = 4
# ============================================================

d = 4
N = d * 2**d
H = 2**d
V = (d - 1) * 2**d
sin2_exp = 0.23122

kL_derived = kL_from_formula(d, sin2_exp)

print("=" * 74)
print("Step 1 — kL from d = 4")
print("=" * 74)
print(f"N = {N}, H = {H}, V = {V}")
print(f"5.6  = (N - 2d)/(2(d+1)) = {five_six(d):.6f}")
print(f"5.44 = 5.6 - d/(d+1)^2   = {five_four_four(d):.6f}")
print()
print(f"sin^2 theta_W (experimental) = {sin2_exp}")
print(f"kL = {N}*3/5 + {sin2_exp}/5.44")
print(f"   = {N*3/5:.6f} + {sin2_exp/five_four_four(d):.6f}")
print(f"   = {kL_derived:.6f}")
print()
print(f"kL (observed) = {kL_observed}")
print(f"Relative error = {abs(kL_derived - kL_observed)/kL_observed:.2e}")
print()

# ============================================================
# STEP 2 — ITERATION HISTORY
# ============================================================

MAX_ITER = 20
kL_iter = 38.4
sin2_iter = sin2_exp

history = [{"iter": 0, "kL": kL_iter, "sin2": sin2_iter, "delta": None}]

for i in range(1, MAX_ITER + 1):
    kL_new = kL_from_formula(d, sin2_iter)
    sin2_new = sin2_from_formula(d, kL_new)
    delta = abs(kL_new - kL_iter)
    history.append({
        "iter": i,
        "kL": kL_new,
        "sin2": sin2_new,
        "delta": delta,
    })
    kL_iter = kL_new
    sin2_iter = sin2_new

kL_fixed = kL_iter
sin2_fixed = sin2_iter

print("=" * 74)
print("Step 2 — Self-consistency")
print("=" * 74)
print(f"{'iter':>5} {'kL':>18} {'sin^2 theta_W':>18} {'|delta|':>14}")
print("-" * 74)
for h in history:
    delta_str = f"{h['delta']:.2e}" if h['delta'] is not None else "—"
    print(f"{h['iter']:>5} {h['kL']:>18.10f} {h['sin2']:>18.10f} {delta_str:>14}")
print()
print(f"Fixed point: kL = {kL_fixed:.10f}")
print()

# ============================================================
# STEP 3 — d-DEPENDENCE
# ============================================================

d_scan = []
for dd in [2, 3, 4, 5, 6, 7]:
    N_d = dd * 2**dd
    kL_d = kL_from_formula(dd, sin2_exp)
    err = abs(kL_d - kL_observed) / kL_observed
    d_scan.append({"d": dd, "N": N_d, "kL": kL_d, "err": err})

print("=" * 74)
print("Step 3 — kL for different d")
print("=" * 74)
print(f"{'d':>3} {'N':>6} {'kL':>16} {'error':>20}")
print("-" * 74)
for r in d_scan:
    marker = "  <-- d = 4" if r["d"] == 4 else ""
    print(f"{r['d']:>3} {r['N']:>6} {r['kL']:>16.4f} {r['err']:>20.2e}{marker}")
print()

