            <th style="padding:6px 12px; text-align:center;">N</th>
            <th style="padding:6px 12px; text-align:right;">kL</th>
            <th style="padding:6px 12px; text-align:right;">error vs obs</th>
          </tr>
        </thead>
        <tbody>{rows}</tbody>
      </table>
      <p style="color:#666; font-size:12px; margin-top:8px;">
        Only d = 4 gives kL ≈ 38.44. The formula is d-specific.
      </p>
    </div>
    """

# -- Figure --
def build_figure():
    fig = make_subplots(
        rows=1, cols=3,
        column_widths=[0.34, 0.33, 0.33],
        subplot_titles=(
            "kL self-consistency iteration",
            "kL = leading + correction",
            "kL for various d",
        ),
        specs=[[{"type": "xy"}, {"type": "xy"}, {"type": "xy"}]],
        horizontal_spacing=0.10,
    )

    iters = [h["iter"] for h in history]
    kLs = [h["kL"] for h in history]
    fig.add_trace(go.Scatter(
        x=iters, y=kLs,
        mode="lines+markers",
        line=dict(color="#4C72B0", width=2),
        marker=dict(size=8),
        hovertemplate="iter %{x}: kL=%{y:.10f}<extra></extra>",
        showlegend=False,
    ), row=1, col=1)
    fig.add_hline(y=kL_observed, line=dict(color="#C44E52", dash="dash", width=1.5),
                  row=1, col=1)
    fig.update_xaxes(title_text="iteration", row=1, col=1)
    fig.update_yaxes(title_text="kL", row=1, col=1)

    leading = N * 3 / 5
    correction = sin2_exp / five_four_four(d)
    fig.add_trace(go.Bar(
        x=["leading", "correction"],
        y=[leading, correction],
        marker=dict(color=["#4C72B0", "#DD8452"]),
        text=[f"{leading:.4f}", f"{correction:.6f}"],
        textposition="outside",
        hovertemplate="%{x}: %{y:.6f}<extra></extra>",
        showlegend=False,
    ), row=1, col=2)
    fig.add_hline(y=kL_observed, line=dict(color="#C44E52", dash="dash", width=1.5),
                  row=1, col=2)
    fig.update_yaxes(title_text="value", range=[0, 42], row=1, col=2)
    fig.update_xaxes(showgrid=False, row=1, col=2)

    ds_str = [str(r["d"]) for r in d_scan]
    kLs_d = [r["kL"] for r in d_scan]
    colors_d = ["#C44E52" if r["d"] == 4 else "#4C72B0" for r in d_scan]
    fig.add_trace(go.Bar(
        x=ds_str, y=kLs_d,
        marker=dict(color=colors_d),
        text=[f"{k:.2f}" for k in kLs_d],
        textposition="outside",
        hovertemplate="d=%{x}: kL=%{y:.4f}<extra></extra>",
        showlegend=False,
    ), row=1, col=3)
    fig.add_hline(y=kL_observed, line=dict(color="#2E8B57", dash="dash", width=1.5),
                  row=1, col=3)
    fig.update_xaxes(title_text="d", showgrid=False, row=1, col=3)
    fig.update_yaxes(title_text="kL", row=1, col=3)

    fig.update_layout(
        title=dict(
            text="<b>Widget 8 — The kL Derivation</b><br>"
                 "<sub>kL from d = 4 and the Weinberg angle</sub>",
            x=0.5, xanchor="center",
        ),
        height=500,
        margin=dict(l=60, r=40, t=100, b=60),
        plot_bgcolor="white",
    )
    return fig

