    ctrl_ax = ax6.inset_axes([0.05, 0.35, 0.90, 0.35])
    ctrl_ax.hist(ctrl, bins=25, color="#ff7f0e", alpha=0.6,
                 edgecolor="#666")
    ctrl_ax.axvline(1.0, color="red", ls="--", lw=2)
    ctrl_ax.set_xlabel("match fraction", fontsize=7)
    ctrl_ax.set_yticks([])
    ctrl_ax.set_xlim(0.3, 1.05)
    ctrl_ax.tick_params(axis="x", labelsize=7)
    ctrl_ax.grid(True, alpha=0.2)

    ax6.text(0.5, 0.20,
             f"control mean = {ctrl.mean():.3f}   "
             f"control max = {ctrl.max():.3f}",
             fontsize=8, ha="center", family="monospace")
    ax6.text(0.5, 0.05, FALSIFICATION["geometry"]["verdict"],
             fontsize=11, ha="center", fontweight="bold", color="#2ca02c",
             bbox=dict(boxstyle="round", facecolor="#e6fae6", alpha=0.9))

    # =========================================================
    # Panel ⑦ — Robustness across disorder & embeddings
    # =========================================================
