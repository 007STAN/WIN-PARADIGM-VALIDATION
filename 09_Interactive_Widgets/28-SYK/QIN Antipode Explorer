    steps = [
        "1.  Lift U_A to SYK Hilbert space",
        "2.  Melon diagram expansion of G(τ)",
        "3.  Invariance of G under U_A",
        "4.  Extract coefficient k_c′(h)",
    ]
    y = 0.44
    for s in steps:
        ax8.text(0.05, y, s, fontsize=8, family="monospace")
        y -= 0.075

