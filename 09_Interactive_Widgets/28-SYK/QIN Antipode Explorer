            if "visible" in s and "hidden" in s:
                mixed += 1
    ax3.text(0.5, 0.90, f"mixed pairs: {mixed}   (target 5)",
             transform=ax3.transAxes, ha="center",
             fontsize=9, family="monospace", color="#9467bd")

    violations = 0
