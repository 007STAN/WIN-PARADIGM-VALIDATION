                continue  # hidden/hidden is fine
            if s[0] == s[1] and "visible" in s:
                violations += 1
    ax3.text(0.5, 0.80,
             f"violations: {violations}   (target 0)",
             transform=ax3.transAxes, ha="center",
             fontsize=9, family="monospace",
             color="green" if violations == 0 else "red",
             fontweight="bold")

    ax3.text(0.5, 0.03,
             f"embedding = {embedding}\n"
             f"visible = {embed_info['visible']}, "
             f"hidden = {embed_info['hidden']}",
             transform=ax3.transAxes, ha="center",
             fontsize=8, family="monospace", style="italic")

    # =========================================================
    # Panel ④ — Falsification test 1: translation involutions
    # =========================================================
    ax4 = fig.add_axes([0.04, 0.34, 0.29, 0.24])
    ax4.set_title(FALSIFICATION["uniqueness"]["title"],
