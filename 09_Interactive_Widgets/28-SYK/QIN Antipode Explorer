# ------------------------------------------------------------
# The widget
# ------------------------------------------------------------
def run_syk(highlight_group=0, embedding="row",
            show_antipode=True, show_visible_hidden=True,
            show_falsification=True, disorder_seed=0,
            vh_alpha=1.0):

    plt.close("all")

    embed_info = EMBEDDINGS[embedding]

    fig = plt.figure(figsize=(17, 14), facecolor="white")
    fig.suptitle(
        f"SYK/QIN Antipode Explorer  ·  "
        f"embedding = {embedding}  ·  disorder seed = {disorder_seed}  ·  "
        f"N = 16 Majorana  ·  λ = 4",
        fontsize=14, fontweight="bold", y=0.985,
    )

    # =========================================================
    # Panel ① — The 8×8 torus with 14 modes, visible/hidden
    # =========================================================
    ax1 = fig.add_axes([0.04, 0.62, 0.38, 0.32])
    ax1.set_title("① The 14 modes at λ = 4   —   visible / hidden labels",
                  fontsize=11, fontweight="bold", color="#9467bd")
    ax1.set_xlim(-0.8, 7.8); ax1.set_ylim(-0.8, 7.8)
    ax1.set_aspect("equal")
    ax1.set_xticks(range(8)); ax1.set_yticks(range(8))
    ax1.set_xticklabels([f"{i}" for i in range(8)], fontsize=8)
    ax1.set_yticklabels([f"{i}" for i in range(8)], fontsize=8)
    ax1.grid(True, alpha=0.25)
    ax1.set_xlabel("n₁", fontsize=10)
    ax1.set_ylabel("n₂", fontsize=10)

    # background grid points
    for i in range(8):
        for j in range(8):
            ax1.plot(i, j, ".", color="#dddddd", markersize=4)

    # 14 modes
    for idx, label, n1, n2, status, partner in MODES_TABLE:
        is_vis = (status == "visible")
        if show_visible_hidden:
            color = "#d62728" if is_vis else "#1f77b4"
            marker = "o"
        else:
            color = "#888888"
            marker = "o"

        # highlight if in selected group
        in_group = any(m["index"] == idx for m in GROUPS[
            tuple(sorted([(MODES_TABLE[highlight_group][2],
                           MODES_TABLE[highlight_group][3]),
                          antipode(MODES_TABLE[highlight_group][2],
                                   MODES_TABLE[highlight_group][3])]))])

        edge = "gold" if in_group else "black"
        lw = 3.0 if in_group else 1.5
        size = 380 if in_group else 220

        ax1.scatter(n1, n2, s=size, c=color, alpha=vh_alpha,
                    edgecolors=edge, linewidths=lw, zorder=5, marker=marker)
        ax1.text(n1, n2, label, fontsize=7.5, ha="center", va="center",
                 color="white", fontweight="bold", zorder=6)

    # antipode pair lines
    if show_antipode:
        drawn = set()
        for idx, label, n1, n2, status, partner in MODES_TABLE:
            ap = antipode(n1, n2)
            if ap == (n1, n2):
                continue  # self-paired
            key = tuple(sorted([(n1, n2), ap]))
            if key in drawn:
                continue
            drawn.add(key)
            in_group = (highlight_group == idx or
                        MODES_TABLE[highlight_group][2:4] == ap)
            col = "magenta" if in_group else "#999999"
            al = 0.95 if in_group else 0.35
            lw = 2.0 if in_group else 0.8
            ax1.annotate("", xy=ap, xytext=(n1, n2),
                         arrowprops=dict(arrowstyle="<->", color=col,
                                         lw=lw, alpha=al,
                                         connectionstyle="arc3,rad=0.15"),
                         zorder=3)

    # legend
    from matplotlib.lines import Line2D
    leg = [
        Line2D([0], [0], marker="o", color="w", markerfacecolor="#d62728",
               markersize=10, markeredgecolor="black",
               label=f"visible ({embed_info['visible']})"),
        Line2D([0], [0], marker="o", color="w", markerfacecolor="#1f77b4",
               markersize=10, markeredgecolor="black",
               label=f"hidden ({embed_info['hidden']})"),
        Line2D([0], [0], color="magenta", lw=2,
               label="antipode pair"),
        Line2D([0], [0], marker="o", color="w", markerfacecolor="gray",
               markersize=12, markeredgecolor="gold", markeredgewidth=2,
               label="selected group"),
