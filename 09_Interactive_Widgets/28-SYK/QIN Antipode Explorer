    ax9.text(0.05, 0.45, pair_type, fontsize=9, family="monospace",
             color="#2ca02c", fontweight="bold")

    ax9.text(0.03, 0.33, "Antipode map", fontsize=9,
             fontweight="bold", color="#1f77b4")
    n1, n2 = sel_members[0]["n"]
    ap1, ap2 = antipode(n1, n2)
    ax9.text(0.05, 0.23,
             f"A({n1},{n2}) = ({ap1},{ap2})",
             fontsize=9, family="monospace")

    ax9.text(0.03, 0.11, "Checks", fontsize=9,
             fontweight="bold", color="#1f77b4")
    checks = [
        ("3/3 falsification tests passed", "#2ca02c"),
        ("10/10 disorder realizations",    "#2ca02c"),
        ("3/3 embeddings",                 "#2ca02c"),
    ]
    y = 0.03
    for c, col in checks:
        ax9.text(0.05, y, f"✓  {c}", fontsize=8, family="monospace",
                 color=col)
        y -= 0.032

    plt.show()

