# ============================================================
# WIN PARADIGM — Widget #28
# SYK/QIN Antipode Explorer
# ============================================================
#
# Layer 6 — microscopic description of the substrate.
#
# Central result (SYK-Antipode paper):
#   Projecting the SYK ensemble onto the 14 torus modes at
#   λ = 4 produces a visible/hidden labeling that is exactly
#   the antipode map
#
#       A(n₁,n₂) = (−n₁ mod 8, −n₂ mod 8)
#
#   The 14 modes partition into 8 antipodal groups:
#     • 2 self-paired  : (0,4), (4,0)
#     • 5 mixed pairs  : exactly one visible, one hidden
#     • 1 hidden pair  : (2,6) – (6,2)
#
#   Falsification tests:
#     1. Uniqueness among translation involutions
#     2. Random permutation null (10,000 trials)
#     3. Geometry-breaking control (200 trials)
#
#   Robustness: 10 disorder realizations × 3 embeddings
#      • row, column, diagonal
#      • visible count varies (7, 7, 4)
#      • antipode constraint is universal
# ============================================================

import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle, FancyArrowPatch, Circle
from ipywidgets import interact, IntSlider, Dropdown, Checkbox, FloatSlider

# ------------------------------------------------------------
# The 14 modes at λ = 4 with SYK visible/hidden labels
# From Table 2 of the WIN overview (row embedding, N = 16)
# ------------------------------------------------------------
MODES_TABLE = [
    #  index  label   n1  n2  status      antipode partner
    (0,  "ν_4",   0, 4,  "visible",  "self"),
    (1,  "u",     1, 3,  "visible",  (7, 5)),
    (2,  "d",     1, 5,  "hidden",   (7, 3)),
    (3,  "s",     2, 2,  "visible",  (6, 6)),
    (4,  "d'",    2, 6,  "hidden",   (6, 2)),
    (5,  "u'",    3, 1,  "visible",  (5, 7)),
    (6,  "s'",    3, 7,  "hidden",   (5, 1)),
    (7,  "e_4",   4, 0,  "visible",  "self"),
    (8,  "μ'",    5, 1,  "visible",  (3, 7)),
    (9,  "u''",   5, 7,  "hidden",   (3, 1)),
    (10, "τ''",   6, 2,  "hidden",   (2, 6)),
    (11, "τ'",    6, 6,  "hidden",   (2, 2)),
    (12, "s''",   7, 3,  "visible",  (1, 5)),
    (13, "u'''",  7, 5,  "hidden",   (1, 3)),
]

# Visible/hidden counts per embedding (from paper's robustness study)
EMBEDDINGS = {
    "row":      {"visible": 7, "hidden": 7, "seed": 42},
    "column":   {"visible": 7, "hidden": 7, "seed": 43},
    "diagonal": {"visible": 4, "hidden": 10, "seed": 44},
}

# Disorder realizations (for the robustness sweep)
DISORDER_SEEDS = list(range(10))

# ------------------------------------------------------------
# The antipode map
# ------------------------------------------------------------
def antipode(n1, n2, L=8):
    return ((-n1) % L, (-n2) % L)

# ------------------------------------------------------------
# The 8 antipodal groups
# ------------------------------------------------------------
def build_groups():
    groups = {}
    for idx, label, n1, n2, status, partner in MODES_TABLE:
        ap = antipode(n1, n2)
        key = tuple(sorted([(n1, n2), ap]))
        groups.setdefault(key, []).append({
            "index": idx, "label": label, "n": (n1, n2),
            "status": status, "partner": partner,
        })
    return groups

GROUPS = build_groups()

