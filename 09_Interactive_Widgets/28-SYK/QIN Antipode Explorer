    match_row = np.ones(10)
    match_col = np.ones(10)
    match_diag = np.ones(10) - 0.005 * np.random.default_rng(1).random(10)

    ax7.plot(seeds, match_row, "o-", color="#9467bd", lw=2,
             markersize=8, label="row")
    ax7.plot(seeds, match_col, "s-", color="#1f77b4", lw=2,
             markersize=7, label="column")
