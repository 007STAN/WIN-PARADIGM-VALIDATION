             markersize=7, label="diagonal")
    ax7.axhline(1.0, color="red", ls="--", lw=1, alpha=0.6)
    ax7.set_xticks(range(0, 10, 2))
    ax7.set_ylim(0.98, 1.01)
    ax7.legend(fontsize=8, loc="lower right")

    ax7.text(0.05, 0.05,
             "10 disorder realizations\n"
             "× 3 embeddings\n"
             "0 violations across all",
             transform=ax7.transAxes, fontsize=8, va="bottom",
