             fontsize=8, ha="center", family="monospace")
    ax5.text(0.5, 0.05, FALSIFICATION["permutation"]["verdict"],
             fontsize=11, ha="center", fontweight="bold", color="#2ca02c",
             bbox=dict(boxstyle="round", facecolor="#e6fae6", alpha=0.9))

    # =========================================================
    # Panel ⑥ — Falsification test 3: geometry-breaking control
    # =========================================================
    ax6 = fig.add_axes([0.67, 0.34, 0.29, 0.24])
    ax6.set_title(FALSIFICATION["geometry"]["title"],
                  fontsize=10.5, fontweight="bold", color="#d62728")
    ax6.set_xlim(0, 1); ax6.set_ylim(0, 1)
    ax6.axis("off")

    ax6.text(0.5, 0.93, FALSIFICATION["geometry"]["desc"],
             fontsize=8, ha="center", va="top",
             style="italic", color="#444")

