    ax7.set_title("⑦ Robustness  —  disorder × embedding",
                  fontsize=10.5, fontweight="bold", color="#2ca02c")
    ax7.set_xlim(0, 10); ax7.set_ylim(0, 1)
    ax7.set_xlabel("disorder realization", fontsize=9)
    ax7.set_ylabel("match fraction", fontsize=9)
    ax7.grid(True, alpha=0.3)

    # synthetic robustness — all seeds give 1.0 for row/col, ~1.0 for diag
