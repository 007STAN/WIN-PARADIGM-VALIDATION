# ============================================================
# THE MATH
# ============================================================

THETA = np.linspace(0, 2 * np.pi, 600)

# Helicity amplitudes: two independent (Q, P) pairs on the unit circle
Q1 = np.cos(THETA); P1 = np.sin(THETA)
Q2 = np.sin(THETA); P2 = np.cos(THETA)

# Lorentzian metric ds^2(theta) = -Q1^2 + P1^2 + Q2^2 + P2^2
DS2 = -(Q1 ** 2) + P1 ** 2 + Q2 ** 2 + P2 ** 2

# Verify numerically: max |DS2 - 2 sin^2(theta)| should be ~0
RESIDUAL = np.max(np.abs(DS2 - 2 * np.sin(THETA) ** 2))
print("Verification: max |ds^2(theta) - 2*sin^2(theta)| =", RESIDUAL)

# Numerical positions of zeros (big bang points)
ZERO_THRESHOLDS = []
for i in range(len(THETA) - 1):
    if DS2[i] * DS2[i + 1] < 0:
        # sign change between i and i+1 -> zero crossing
        t0, t1 = THETA[i], THETA[i + 1]
        z0, z1 = DS2[i], DS2[i + 1]
        t_star = t0 - z0 * (t1 - t0) / (z1 - z0)
        ZERO_THRESHOLDS.append(t_star)
print("Numerical zero crossings of ds^2(theta) (radians):")
for t in ZERO_THRESHOLDS:
    print(f"  theta = {t:.6f}  (theta/pi = {t/np.pi:.6f})")

# ============================================================
# FIGURE BUILDER
# ============================================================

def build_figure(theta_now=0.0):
    """4-panel figure of the photon -> d = 4 derivation."""
    q1 = np.cos(theta_now); p1 = np.sin(theta_now)
    q2 = np.sin(theta_now); p2 = np.cos(theta_now)
    ds2_now = -(q1 ** 2) + p1 ** 2 + q2 ** 2 + p2 ** 2

    fig = make_subplots(
        rows=2, cols=2,
        subplot_titles=(
            "Right helicity (h = +1): phasor (Q1, P1)",
            "Left helicity (h = -1): phasor (Q2, P2)",
            "Lorentzian metric  ds^2(theta) = 2 sin^2(theta)",
            "Status at the current Wick angle",
        ),
        specs=[
            [{"type": "xy"}, {"type": "xy"}],
            [{"type": "xy"}, {"type": "xy"}],
        ],
        vertical_spacing=0.14,
        horizontal_spacing=0.12,
    )

    # --- Top-left: right helicity phasor ---
    fig.add_trace(go.Scatter(
        x=[0, q1], y=[0, p1],
        mode="lines+markers",
        line=dict(color="#4C72B0", width=3),
        marker=dict(size=[0, 16],
                    color=["rgba(0,0,0,0)", "#4C72B0"]),
        hoverinfo="skip", showlegend=False,
    ), row=1, col=1)
    t = np.linspace(0, 2 * np.pi, 200)
    fig.add_trace(go.Scatter(
        x=np.cos(t), y=np.sin(t),
        mode="lines",
        line=dict(color="#DDDDDD", width=1, dash="dot"),
        hoverinfo="skip", showlegend=False,
    ), row=1, col=1)

    # --- Top-right: left helicity phasor ---
    fig.add_trace(go.Scatter(
        x=[0, q2], y=[0, p2],
        mode="lines+markers",
        line=dict(color="#C44E52", width=3),
        marker=dict(size=[0, 16],
                    color=["rgba(0,0,0,0)", "#C44E52"]),
        hoverinfo="skip", showlegend=False,
    ), row=1, col=2)
    fig.add_trace(go.Scatter(
        x=np.cos(t), y=np.sin(t),
        mode="lines",
        line=dict(color="#DDDDDD", width=1, dash="dot"),
        hoverinfo="skip", showlegend=False,
    ), row=1, col=2)

    # --- Bottom-left: Lorentzian metric curve ---
    fig.add_trace(go.Scatter(
        x=THETA, y=DS2,
        mode="lines",
        line=dict(color="#55A868", width=2.5),
        hovertemplate="theta = %{x:.3f}<br>ds^2 = %{y:.3f}<extra></extra>",
        showlegend=False,
    ), row=2, col=1)

    # Mark the big-bang points
    fig.add_trace(go.Scatter(
        x=[0, np.pi, 2 * np.pi], y=[0, 0, 0],
        mode="markers",
        marker=dict(size=14, color="#C44E52", symbol="x"),
        hovertemplate="big bang<br>theta = %{x:.3f}<extra></extra>",
        showlegend=False,
    ), row=2, col=1)

    # Current position marker
    fig.add_trace(go.Scatter(
        x=[theta_now], y=[ds2_now],
        mode="markers",
        marker=dict(size=18, color="#DD8452",
                    line=dict(width=2, color="black")),
        hovertemplate="theta = %{x:.3f}<br>ds^2 = %{y:.3f}<extra></extra>",
        showlegend=False,
    ), row=2, col=1)

    # --- Bottom-right: status panel ---
    fig.add_trace(go.Scatter(
        x=[0], y=[0], mode="markers",
        marker=dict(size=0.1, color="white"),
        hoverinfo="skip", showlegend=False,
    ), row=2, col=2)

    if ds2_now < 0.02:
        phase = "BIG BANG — metric collapses to zero"
        color = "#C44E52"
    elif ds2_now > 1.98:
        phase = "MAXIMUM — full Lorentzian metric"
        color = "#55A868"
    else:
        phase = "Expanding or contracting"
        color = "#4C72B0"

    fig.add_annotation(
        x=0.5, y=0.85, xref="x4 domain", yref="y4 domain",
        text=f"<b>Wick angle theta</b><br>"
             f"<span style='font-size:20px'>{theta_now:.4f} rad</span><br>"
             f"({theta_now / np.pi:.4f} pi)",
        showarrow=False, align="center",
        font=dict(size=13, color="#222"),
    )
    fig.add_annotation(
        x=0.5, y=0.55, xref="x4 domain", yref="y4 domain",
        text=f"<b>Lorentzian metric</b><br>"
             f"<span style='font-size:20px; color:{color}'>"
             f"ds^2 = {ds2_now:.4f}</span>",
        showarrow=False, align="center",
        font=dict(size=13, color="#222"),
    )
    fig.add_annotation(
        x=0.5, y=0.28, xref="x4 domain", yref="y4 domain",
        text=f"<span style='color:{color}'><b>{phase}</b></span>",
        showarrow=False, align="center", font=dict(size=13),
    )
    fig.add_annotation(
        x=0.5, y=0.08, xref="x4 domain", yref="y4 domain",
        text="ds^2 has period pi in theta.<br>"
             "Big bang every pi.",
        showarrow=False, align="center",
        font=dict(size=11, color="#777"),
    )

    # Axes
    fig.update_xaxes(range=[-1.3, 1.3], showgrid=False,
                     zeroline=True, zerolinecolor="#CCC", row=1, col=1)
    fig.update_yaxes(range=[-1.3, 1.3], showgrid=False,
                     zeroline=True, zerolinecolor="#CCC",
                     row=1, col=1, scaleanchor="x")
    fig.update_xaxes(range=[-1.3, 1.3], showgrid=False,
                     zeroline=True, zerolinecolor="#CCC", row=1, col=2)
    fig.update_yaxes(range=[-1.3, 1.3], showgrid=False,
                     zeroline=True, zerolinecolor="#CCC",
                     row=1, col=2, scaleanchor="x")

    fig.update_xaxes(
        range=[0, 2 * np.pi],
        showgrid=True, gridcolor="#EEE",
        title_text="Wick angle theta (rad)",
        tickvals=[0, np.pi / 2, np.pi, 3 * np.pi / 2, 2 * np.pi],
        ticktext=["0", "pi/2", "pi", "3pi/2", "2pi"],
        row=2, col=1,
    )
    fig.update_yaxes(
        range=[-0.15, 2.2],
        showgrid=True, gridcolor="#EEE",
        title_text="ds^2", row=2, col=1,
    )
    fig.update_xaxes(visible=False, range=[0, 1], row=2, col=2)
    fig.update_yaxes(visible=False, range=[0, 1], row=2, col=2)

    fig.update_layout(
        title=dict(
            text="<b>Photon to d = 4</b><br>"
                 "<sub>Two helicities -> 4D phase space -> "
                 "Wick rotation -> Lorentzian metric with "
                 "period pi</sub>",
            x=0.5, xanchor="center",
        ),
        height=780,
        margin=dict(l=50, r=30, t=100, b=50),
        plot_bgcolor="white",
        showlegend=False,
    )
    return fig

# ============================================================
# INTERACTIVE CONTROLS
# ============================================================

theta_slider = widgets.FloatSlider(
    value=0.0, min=0.0, max=2 * np.pi, step=0.01,
    description="Wick angle:",
    continuous_update=True,
    readout=True, readout_format=".4f",
    layout=widgets.Layout(width="650px"),
)

play_button = widgets.ToggleButton(
    value=False, description="Play",
    button_style="success",
    layout=widgets.Layout(width="100px"),
)

reset_button = widgets.Button(
    description="Reset",
    layout=widgets.Layout(width="100px"),
)

# Use FigureWidget for in-place updates (no flicker)
fig_widget = go.FigureWidget(build_figure(0.0))

def update_figure(theta):
    new_fig = build_figure(theta)
    # Update traces in place where possible; fall back to replace
    # for annotations and layout.
    for i, tr in enumerate(new_fig.data):
        if i < len(fig_widget.data):
            fig_widget.data[i].x = tr.x
            fig_widget.data[i].y = tr.y
        else:
            fig_widget.add_trace(tr)
    # Remove extra traces if new_fig has fewer
    while len(fig_widget.data) > len(new_fig.data):
        fig_widget.data = fig_widget.data[:-1]
    fig_widget.layout = new_fig.layout

def on_slider_change(change):
    if change["name"] == "value":
        update_figure(change["new"])

theta_slider.observe(on_slider_change)

def on_reset(_):
    theta_slider.value = 0.0
    play_button.value = False
    update_figure(0.0)

reset_button.on_click(on_reset)

# --- Animation loop ---
import time

def animate():
    while play_button.value:
        new_val = theta_slider.value + 0.04
        if new_val > 2 * np.pi:
            new_val = 0.0
        theta_slider.value = new_val
        time.sleep(0.03)

def on_play_change(change):
    if change["name"] == "value":
        if change["new"]:
            play_button.description = "Pause"
            animate()
        else:
            play_button.description = "Play"

play_button.observe(on_play_change)

