# ============================================================
# THE PHYSICS
# ============================================================
# From WIN_Derivation_of_d4.pdf:
#
#   1. The photon has two helicity states: h = +1 (right), h = -1 (left).
#   2. Each helicity is a complex amplitude: psi = a + i*b (2 real numbers).
#   3. So the photon's phase space is spanned by (Q1, P1, Q2, P2) in R^4.
#   4. A Wick rotation by angle theta rotates the Euclidean metric
#      into a Lorentzian one.
#   5. The Lorentzian metric is:
#
#         ds^2(theta) = -Q1(theta)^2 + P1(theta)^2
#                      + Q2(theta)^2 + P2(theta)^2
#
#      With Q1 = cos(theta), P1 = sin(theta),
#           Q2 = sin(theta), P2 = cos(theta):
#
#         ds^2(theta) = 2 sin^2(theta)
#
#   6. This oscillates with period pi. It vanishes at
#      theta = 0, pi, 2*pi, ... — the "big bang" moments.
#   7. For the vacuum, theta advances at the Planck rate, so
#      the big bang happens every Planck time (~1e-43 s).
#   8. The 4D phase space + Wick rotation = 4D spacetime. Hence d = 4.
# ============================================================

# Sample the Wick angle densely
THETA = np.linspace(0, 2 * np.pi, 600)

# Helicity amplitudes (rotating phasors in the complex plane)
Q1 = np.cos(THETA)
P1 = np.sin(THETA)
Q2 = np.sin(THETA)
P2 = np.cos(THETA)

# Lorentzian metric as a function of Wick angle
DS2 = -Q1**2 + P1**2 + Q2**2 + P2**2   # = 2 sin^2(theta)

# ============================================================
# FIGURE BUILDER
# ============================================================

def build_animation_figure(theta_now=0.0, playing=False):
    """Build a 2x2 subplot showing the photon -> d=4 derivation.

    Top-left:  right-helicity phasor (Q1, P1)
    Top-right: left-helicity phasor (Q2, P2)
    Bottom-left:  the Lorentzian metric ds^2(theta) vs theta
    Bottom-right: a summary / status panel
    """
    # Current values at theta_now
    q1 = np.cos(theta_now); p1 = np.sin(theta_now)
    q2 = np.sin(theta_now); p2 = np.cos(theta_now)
    ds2_now = 2 * np.sin(theta_now)**2

    fig = make_subplots(
        rows=2, cols=2,
        subplot_titles=(
            "Right helicity (h = +1):  (Q1, P1)",
            "Left helicity (h = -1):  (Q2, P2)",
            "Lorentzian metric  ds^2(theta) = -Q1^2 + P1^2 + Q2^2 + P2^2",
            "Status at Wick angle theta",
        ),
        specs=[
            [{"type": "xy"}, {"type": "xy"}],
            [{"type": "xy"}, {"type": "xy"}],
        ],
        vertical_spacing=0.13,
        horizontal_spacing=0.10,
    )

    # --- Top-left: right helicity phasor ---
    fig.add_trace(go.Scatter(
        x=[0, q1], y=[0, p1],
        mode="lines+markers",
        line=dict(color="#4C72B0", width=3),
        marker=dict(size=[0, 14], color=["rgba(0,0,0,0)", "#4C72B0"]),
        name="Right phasor",
        hoverinfo="skip",
        showlegend=False,
    ), row=1, col=1)

    # Unit circle reference
    t = np.linspace(0, 2*np.pi, 200)
    fig.add_trace(go.Scatter(
        x=np.cos(t), y=np.sin(t),
        mode="lines",
        line=dict(color="#DDDDDD", width=1, dash="dot"),
        hoverinfo="skip", showlegend=False,
    ), row=1, col=1)

    # --- Top-right: left helicity phasor ---
    fig.add_trace(go.Scatter(
        x=[0, q2], y=[0, p2],
        mode="lines+markers",
        line=dict(color="#C44E52", width=3),
        marker=dict(size=[0, 14], color=["rgba(0,0,0,0)", "#C44E52"]),
        name="Left phasor",
        hoverinfo="skip",
        showlegend=False,
    ), row=1, col=2)

    fig.add_trace(go.Scatter(
        x=np.cos(t), y=np.sin(t),
        mode="lines",
        line=dict(color="#DDDDDD", width=1, dash="dot"),
        hoverinfo="skip", showlegend=False,
    ), row=1, col=2)

    # --- Bottom-left: the Lorentzian metric vs theta ---
    fig.add_trace(go.Scatter(
        x=THETA, y=DS2,
        mode="lines",
        line=dict(color="#55A868", width=2.5),
        name="ds^2(theta)",
        hovertemplate="theta = %{x:.3f}<br>ds^2 = %{y:.3f}<extra></extra>",
        showlegend=False,
    ), row=2, col=1)

    # Big-bang markers at multiples of pi
    bb_thetas = [0, np.pi, 2*np.pi]
    fig.add_trace(go.Scatter(
        x=bb_thetas, y=[0]*len(bb_thetas),
        mode="markers",
        marker=dict(size=12, color="#C44E52", symbol="x"),
        name="Big bang (ds^2 = 0)",
        hovertemplate="Big bang<br>theta = %{x:.3f}<extra></extra>",
        showlegend=False,
    ), row=2, col=1)

    # Current-position marker on the metric curve
    fig.add_trace(go.Scatter(
        x=[theta_now], y=[ds2_now],
        mode="markers",
        marker=dict(size=16, color="#DD8452", line=dict(width=2, color="black")),
        name="Now",
        hovertemplate="theta = %{x:.3f}<br>ds^2 = %{y:.3f}<extra></extra>",
        showlegend=False,
    ), row=2, col=1)

    # --- Bottom-right: status panel ---
    # We render a clean text block using an invisible scatter + annotations.
    fig.add_trace(go.Scatter(
        x=[0], y=[0], mode="markers",
        marker=dict(size=0.1, color="white"),
        hoverinfo="skip", showlegend=False,
    ), row=2, col=2)

    # Determine phase of the metric
    if ds2_now < 0.02:
        phase = "BIG BANG — metric collapses to zero"
        color = "#C44E52"
    elif ds2_now > 1.98:
        phase = "MAXIMUM — full Lorentzian metric"
        color = "#55A868"
    else:
        phase = "Expanding / contracting"
        color = "#4C72B0"

    fig.add_annotation(
        x=0.5, y=0.85, xref="x4 domain", yref="y4 domain",
        text=f"<b>Wick angle theta</b><br>"
             f"<span style='font-size:20px'>{theta_now:.3f} rad</span><br>"
             f"({theta_now/np.pi:.3f} pi)",
        showarrow=False, align="center",
        font=dict(size=13, color="#222"),
    )
    fig.add_annotation(
        x=0.5, y=0.55, xref="x4 domain", yref="y4 domain",
        text=f"<b>Lorentzian metric</b><br>"
             f"<span style='font-size:20px; color:{color}'>ds^2 = {ds2_now:.4f}</span>",
        showarrow=False, align="center",
        font=dict(size=13, color="#222"),
    )
    fig.add_annotation(
        x=0.5, y=0.28, xref="x4 domain", yref="y4 domain",
        text=f"<span style='color:{color}'>{phase}</span>",
        showarrow=False, align="center",
        font=dict(size=13),
    )
    fig.add_annotation(
        x=0.5, y=0.08, xref="x4 domain", yref="y4 domain",
        text="Period = pi.  Big bang every pi.",
        showarrow=False, align="center",
        font=dict(size=11, color="#777"),
    )

    # --- Layout ---
    fig.update_xaxes(range=[-1.3, 1.3], showgrid=False, zeroline=True,
                     zerolinecolor="#CCC", row=1, col=1)
    fig.update_yaxes(range=[-1.3, 1.3], showgrid=False, zeroline=True,
                     zerolinecolor="#CCC", row=1, col=1, scaleanchor="x")
    fig.update_xaxes(range=[-1.3, 1.3], showgrid=False, zeroline=True,
                     zerolinecolor="#CCC", row=1, col=2)
    fig.update_yaxes(range=[-1.3, 1.3], showgrid=False, zeroline=True,
                     zerolinecolor="#CCC", row=1, col=2, scaleanchor="x")

    fig.update_xaxes(range=[0, 2*np.pi], showgrid=True, gridcolor="#EEE",
                     title_text="Wick angle theta (rad)",
                     tickvals=[0, np.pi/2, np.pi, 3*np.pi/2, 2*np.pi],
                     ticktext=["0", "pi/2", "pi", "3pi/2", "2pi"],
                     row=2, col=1)
    fig.update_yaxes(range=[-0.1, 2.2], showgrid=True, gridcolor="#EEE",
                     title_text="ds^2", row=2, col=1)

    fig.update_xaxes(visible=False, range=[0, 1], row=2, col=2)
    fig.update_yaxes(visible=False, range=[0, 1], row=2, col=2)

    fig.update_layout(
        title=dict(
            text="<b>Photon → d = 4</b><br>"
                 "<sub>Two helicity states -> 4D phase space -> Wick rotation "
                 "-> 4D spacetime</sub>",
            x=0.5, xanchor="center",
        ),
        height=780,
        margin=dict(l=50, r=30, t=90, b=50),
        plot_bgcolor="white",
        showlegend=False,
    )

    return fig

# ============================================================
# INTERACTIVE CONTROLS
# ============================================================

theta_slider = widgets.FloatSlider(
    value=0.0,
    min=0.0,
    max=2 * np.pi,
    step=0.01,
    description="Wick angle:",
    continuous_update=True,
    readout=True,
    readout_format=".3f",
    layout=widgets.Layout(width="650px"),
)

play_button = widgets.ToggleButton(
    value=False,
    description="▶ Play",
    button_style="success",
    layout=widgets.Layout(width="100px"),
)

reset_button = widgets.Button(
    description="↺ Reset",
    layout=widgets.Layout(width="100px"),
)

status_out = widgets.Output()
figure_out = widgets.Output()

# We use a go.FigureWidget so we can update it in place without flicker.
fig_widget = go.FigureWidget(build_animation_figure(0.0))

def update_figure(theta):
    """Redraw the figure at a new theta without rebuilding widgets."""
    new_fig = build_animation_figure(theta)

    # Copy traces and annotations from new_fig into fig_widget
    fig_widget.data = []
    for tr in new_fig.data:
        fig_widget.add_trace(tr)
    fig_widget.layout = new_fig.layout

def on_slider_change(change):
    if change["name"] == "value":
        update_figure(change["new"])

theta_slider.observe(on_slider_change)

def on_reset(_):
    theta_slider.value = 0.0
    play_button.value = False
    update_figure(0.0)

reset_button.on_click(on_reset)

# --- Animation loop ---
import time

def animate():
    """Advance the slider by a small step each frame while Play is on."""
    while play_button.value:
        new_val = theta_slider.value + 0.04
        if new_val > 2 * np.pi:
            new_val = 0.0
        theta_slider.value = new_val
        time.sleep(0.03)

def on_play_change(change):
    if change["name"] == "value":
        if change["new"]:
            play_button.description = "⏸ Pause"
            animate()
        else:
            play_button.description = "▶ Play"

play_button.observe(on_play_change)

