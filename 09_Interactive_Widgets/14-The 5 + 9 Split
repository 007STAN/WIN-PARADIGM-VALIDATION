    description="Sort:",
    layout=widgets.Layout(width="360px"),
)

def render_table(sort_key):
    table_out.clear_output(wait=True)
    view = df.copy()
    if sort_key == "N4_desc":
        view = view.sort_values("N/4", ascending=False)
    elif sort_key == "N4_asc":
        view = view.sort_values("N/4", ascending=True)
    elif sort_key == "type":
        view = view.sort_values(["Type", "N/4"], ascending=[True, False])
    elif sort_key == "n1":
        view = view.sort_values("n1", ascending=True)
    elif sort_key == "delta_abs":
        view = view.assign(ad=view["Delta"].abs())
        view = view.sort_values("ad", ascending=False).drop(columns=["ad"])

    rows_html = ""
    for _, r in view.iterrows():
        is_eigen = r["Type"] == "Eigenmode"
        bg = "#E8F5E9" if is_eigen else "#FFF"
        type_color = "#2E8B57" if is_eigen else "#C44E52"
        rows_html += (
            f"<tr style='background:{bg};'>"
            f"<td style='padding:5px 12px;'><b>{r['Particle']}</b></td>"
            f"<td style='padding:5px 12px;'>{r['(n1,n2)']}</td>"
            f"<td style='padding:5px 12px; text-align:right;'>{r['Support']}</td>"
            f"<td style='padding:5px 12px; text-align:right;'>{r['N/4']:.1f}</td>"
            f"<td style='padding:5px 12px; text-align:right;'>{r['Base']}</td>"
            f"<td style='padding:5px 12px; text-align:right; color:{type_color}; "
            f"font-weight:bold;'>{r['Delta']:+.2f}</td>"
            f"<td style='padding:5px 12px; color:{type_color};'>{r['Type']}</td>"
            f"</tr>"
        )

    html = (
        "<div style='font-family:-apple-system,system-ui,sans-serif; "
        "max-width:900px; margin-top:12px;'>"
        "<table style='border-collapse:collapse; font-size:13px; "
        "width:100%; background:#FFF; border:1px solid #DDD; "
        "border-radius:6px; overflow:hidden;'>"
        "<thead><tr style='background:#EEE;'>"
        "<th style='padding:6px 12px; text-align:left;'>Particle</th>"
        "<th style='padding:6px 12px; text-align:left;'>(n1,n2)</th>"
        "<th style='padding:6px 12px; text-align:right;'>Support</th>"
        "<th style='padding:6px 12px; text-align:right;'>N/4</th>"
        "<th style='padding:6px 12px; text-align:right;'>Base</th>"
        "<th style='padding:6px 12px; text-align:right;'>Delta</th>"
        "<th style='padding:6px 12px; text-align:left;'>Type</th>"
        "</tr></thead><tbody>"
        + rows_html +
        "</tbody></table>"
        "<p style='color:#666; font-size:12px; margin-top:8px;'>"
        "Green rows: Substrate Eigenmodes (delta = 0). "
        "White rows: Mesh Resonances (delta != 0)."
        "</p></div>"
    )
    with table_out:
        display(HTML(html))

def on_change(change):
