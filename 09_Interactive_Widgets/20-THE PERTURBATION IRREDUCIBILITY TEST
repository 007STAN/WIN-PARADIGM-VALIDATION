# ============================================================
# FRAMEWORK CONSTANTS
# ============================================================
d = 4
N = d * 2**d        # 64
H = 2**d            # 16
V = (d - 1) * 2**d  # 48
L = 8
kL = 38.442527

A = kL / 7.88
B = H + kL / 26
C = -kL * (d + 4.23)
r_e = 0.025954

def m_f(r):
    return A * (r / r_e)**B * np.exp(C * (r - r_e))

# ============================================================
# THE 14 MODES
# ============================================================
DATA = [
    ((0, 4), "nu",   0.025277, 64, 6.0, 60.0,  0.0),
    ((4, 0), "e",    0.025954, 64, 6.0, 24.0, -1.0),
    ((1, 3), "u",    0.027005, 48, 5.5, 21.0,  2/3),
    ((1, 5), "d",    0.027909, 48, 5.5, 20.0, -1/3),
    ((3, 1), "s",    0.028405, 48, 5.5, 14.0, -1/3),
    ((3, 7), "mu",   0.029813, 48, 5.5, 14.0, -1.0),
    ((5, 7), "dark", 0.032000, 48, 5.5, 12.0,  0.0),
    ((7, 3), "c",    0.030461, 48, 5.5,  9.5,  2/3),
    ((7, 5), "tau",  0.031913, 48, 5.5,  9.0, -1.0),
    ((5, 1), "b",    0.033079, 48, 5.5,  7.5, -1/3),
    ((2, 2), "W",    0.033236, 32, 5.0,  2.0,  1.0),
    ((2, 6), "Z",    0.033262, 32, 5.0,  2.0,  0.0),
    ((6, 2), "H",    0.041677, 32, 5.0,  1.0,  0.0),
    ((6, 6), "t",    0.067489, 32, 5.0,  0.5,  2/3),
]

REFERENCE_PARTICLES = ["Z", "c", "d", "e"]
references_n4 = {"Z": 2, "c": 9.5, "d": 20, "e": 24}

# Build the data
entries = []
for (n1, n2), p, r, supp, ent, n4, q in DATA:
    w = m_f(r)
    best_n = None; best_dist = np.inf
    for n in range(-4, 8):
        target = kL / (2**n)
        dist = abs(w - target)
        if dist < best_dist:
            best_dist = dist; best_n = n
    target = kL / (2**best_n)
    pert = w - target
    pert_rel = pert / target * 100
    is_ref = p in REFERENCE_PARTICLES
    ref_dist = min(abs(n4 - rn) for rn in references_n4.values())
    entries.append({
        "particle": p, "n1": n1, "n2": n2,
        "support": supp, "entropy": ent, "N4": n4,
        "m_f": w, "ratio": r,
        "pert_rel": pert_rel, "pert_abs": pert,
        "type": "reference" if is_ref else "perturbation",
        "ref_dist": ref_dist,
        "a": n1 - n2, "s": n1 + n2,
        "prod": n1 * n2,
    })

# Non-reference entries for the irreducibility test
perts = [e for e in entries if e["type"] == "perturbation"]
refs = [e for e in entries if e["type"] == "reference"]

# ============================================================
# DIAGNOSTIC PRINTOUT
# ============================================================
print("=" * 80)
print("THE PERTURBATION IRREDUCIBILITY TEST")
print("=" * 80)
print()
print(f"References: {len(refs)} (Z, c, d, e)")
print(f"Perturbations: {len(perts)}")
print()

# ============================================================
# TEST 1: Perturbation vs mode properties
# ============================================================
print("=" * 80)
print("TEST 1: PERTURBATION vs MODE PROPERTIES")
print("=" * 80)
print()

properties = ["n1", "n2", "support", "entropy", "a", "s", "prod", "N4"]
pert_arr = np.array([e["pert_rel"] for e in perts])

results = []
for prop in properties:
    x = np.array([e[prop] for e in perts], dtype=float)
    if np.std(x) < 1e-12:
        continue
    rho, p = stats.spearmanr(x, pert_arr)
    results.append((prop, rho, p))

print(f"{'property':>12} {'Spearman rho':>15} {'p-value':>12} {'sig?':>8}")
print("-" * 50)
for prop, rho, p in results:
    sig = "YES" if p < 0.05 else "no"
    print(f"{prop:>12} {rho:>+15.4f} {p:>12.6f} {sig:>8}")
print()

# Multiple comparison correction
p_values = [r[2] for r in results]
n_tests = len(p_values)

# Bonferroni
bonferroni_threshold = 0.05 / n_tests
bonferroni_sig = [p < bonferroni_threshold for p in p_values]

# Benjamini-Hochberg FDR
sorted_p = sorted(enumerate(p_values), key=lambda x: x[1])
bh_sig = [False] * n_tests
for i, (orig_idx, p) in enumerate(sorted_p):
    threshold = 0.05 * (i + 1) / n_tests
    if p <= threshold:
        bh_sig[orig_idx] = True

print(f"Bonferroni threshold (alpha/n): {bonferroni_threshold:.6f}")
print(f"Bonferroni significant: {sum(bonferroni_sig)}/{n_tests}")
print(f"Benjamini-Hochberg FDR significant: {sum(bh_sig)}/{n_tests}")
print()

# ============================================================
# TEST 2: Hierarchy test - perturbation vs distance from reference
# ============================================================
print("=" * 80)
print("TEST 2: HIERARCHY TEST - PERTURBATION vs DISTANCE FROM REFERENCE")
print("=" * 80)
print()

dist_arr = np.array([e["ref_dist"] for e in perts])
pert_abs_arr = np.array([e["pert_abs"] for e in perts])

rho_rel, p_rel = stats.spearmanr(dist_arr, pert_arr)
rho_abs, p_abs = stats.spearmanr(dist_arr, pert_abs_arr)

print(f"Distance from nearest reference:")
print(f"  min = {dist_arr.min():.1f}, max = {dist_arr.max():.1f}, "
      f"mean = {dist_arr.mean():.2f}")
print()
print(f"Spearman(pert_rel, ref_dist) = {rho_rel:+.4f}, p = {p_rel:.6f}")
print(f"Spearman(pert_abs, ref_dist) = {rho_abs:+.4f}, p = {p_abs:.6f}")
print()
print("If perturbations grew with distance, rho would be significantly > 0.")
print("Both correlations are non-significant. No hierarchy.")
print()

# ============================================================
# TEST 3: Permutation null distributions
# ============================================================
print("=" * 80)
print("TEST 3: PERMUTATION NULL DISTRIBUTIONS (100000 shuffles)")
print("=" * 80)
print()

np.random.seed(42)
n_perm = 100000

# For each property, build a null distribution by shuffling perturbation
# values against the property values

null_distributions = {}
observed_rhos = {}

for prop, rho_obs, _ in results:
    x = np.array([e[prop] for e in perts], dtype=float)
    # Null: shuffle the perturbation values
    null_rhos = np.zeros(n_perm)
    for i in range(n_perm):
        perm = np.random.permutation(pert_arr)
        r_null, _ = stats.spearmanr(x, perm)
        null_rhos[i] = r_null
    null_distributions[prop] = null_rhos
    observed_rhos[prop] = rho_obs
    # Two-sided p-value
    p_perm = np.mean(np.abs(null_rhos) >= np.abs(rho_obs))
    print(f"  {prop:>10}: rho = {rho_obs:+.4f}, "
          f"permutation p = {p_perm:.6f}")

print()

# ============================================================
# FIGURE BUILDER
# ============================================================
def build_figure(highlight_prop=None):
    fig = make_subplots(
        rows=2, cols=2,
        column_widths=[0.5, 0.5],
        row_heights=[0.5, 0.5],
        subplot_titles=(
            "Perturbation vs mode properties (all correlations)",
            "Permutation null distributions",
            "Perturbation vs distance from reference (hierarchy test)",
            "Summary: p-values and significance",
        ),
        specs=[
            [{"type": "xy"}, {"type": "xy"}],
            [{"type": "xy"}, {"type": "xy"}],
        ],
        horizontal_spacing=0.12,
        vertical_spacing=0.15,
    )

    # --- Top-left: bar chart of correlations ---
    props_list = [r[0] for r in results]
    rhos_list = [r[1] for r in results]
    pvals_list = [r[2] for r in results]

    colors = []
    for prop, rho, p in results:
        if prop == highlight_prop:
            colors.append("#2E8B57")
        elif p < 0.05:
            colors.append("#C44E52")
        else:
            colors.append("#888888")

    fig.add_trace(go.Bar(
        x=props_list, y=rhos_list,
        marker=dict(color=colors, line=dict(width=1, color="#333")),
        hovertemplate="%{x}: rho = %{y:+.4f}<extra></extra>",
        showlegend=False,
    ), row=1, col=1)

    # Significance thresholds
    fig.add_shape(type="line", x0=-0.5, x1=len(props_list)-0.5,
                  y0=0, y1=0, line=dict(color="#000", width=1),
                  row=1, col=1)

    # --- Top-right: permutation null distributions ---
    # Use one representative property for clarity
    prop_to_show = highlight_prop if highlight_prop else results[0][0]
    if prop_to_show not in null_distributions:
        prop_to_show = results[0][0]
    null_rhos = null_distributions[prop_to_show]
    rho_obs = observed_rhos[prop_to_show]

    fig.add_trace(go.Histogram(
        x=null_rhos, nbinsx=60,
        marker=dict(color="#BBB", line=dict(width=0.5, color="#888")),
        name=f"null ({prop_to_show})",
        hovertemplate="rho = %{x:.4f}<br>count = %{y}<extra></extra>",
        showlegend=False,
    ), row=1, col=2)

    # Observed rho line
    fig.add_shape(type="line", x0=rho_obs, x1=rho_obs, y0=0, y1=1,
                  yref="y2 domain",
                  line=dict(color="#C44E52", width=3), row=1, col=2)

    # --- Bottom-left: hierarchy test ---
    for e in perts:
        is_hi = (e["particle"] == highlight_prop)
        color = "#2E8B57" if is_hi else "#4C72B0"
        size = 16 if is_hi else 12
        fig.add_trace(go.Scatter(
            x=[e["ref_dist"]], y=[e["pert_rel"]],
            mode="markers+text",
            marker=dict(size=size, color=color,
                        line=dict(width=1.5, color="black")),
            text=[e["particle"]],
            textposition="top center",
            textfont=dict(size=10),
            hovertemplate=(
                f"<b>{e['particle']}</b><br>"
                f"ref dist = {e['ref_dist']:.1f}<br>"
                f"perturbation = {e['pert_rel']:+.2f}%"
                "<extra></extra>"
            ),
            showlegend=False,
        ), row=2, col=1)

    # Zero line
    fig.add_shape(type="line", x0=-0.5, x1=40, y0=0, y1=0,
                  line=dict(color="#CCC", width=1), row=2, col=1)

    # --- Bottom-right: summary table as text ---
    # Show the p-values in text
    summary_text = "<b>Property     rho      p      sig</b><br>"
    for prop, rho, p in results:
        sig = "YES" if p < 0.05 else "no "
        summary_text += (f"{prop:>10}  {rho:+.4f}  {p:.4f}  {sig}<br>")

    fig.add_annotation(
        x=0.05, y=0.95, xref="x4 domain", yref="y4 domain",
        text=summary_text,
        showarrow=False, align="left",
        font=dict(size=11, family="monospace"),
        bgcolor="white", bordercolor="#888", borderwidth=1,
    )

    # Axis labels
    fig.update_xaxes(title_text="property", row=1, col=1)
    fig.update_yaxes(title_text="Spearman rho", range=[-1, 1],
                     showgrid=True, gridcolor="#EEE", row=1, col=1)
    fig.update_xaxes(title_text="null rho distribution",
                     row=1, col=2)
    fig.update_yaxes(title_text="count",
                     showgrid=True, gridcolor="#EEE", row=1, col=2)
    fig.update_xaxes(title_text="distance from nearest reference",
                     range=[-0.5, 40],
                     showgrid=True, gridcolor="#EEE", row=2, col=1)
    fig.update_yaxes(title_text="perturbation [%]", range=[-50, 50],
                     showgrid=True, gridcolor="#EEE", row=2, col=1)
    fig.update_xaxes(visible=False, row=2, col=2)
    fig.update_yaxes(visible=False, row=2, col=2)

    fig.update_layout(
        title=dict(
            text="<b>Perturbation Irreducibility Test</b><br>"
                 "<sub>Perturbations do not correlate with any mode property. "
                 "No hierarchy vs reference distance. The database is flat.</sub>",
            x=0.5, xanchor="center",
        ),
        height=780,
        margin=dict(l=60, r=40, t=100, b=60),
        plot_bgcolor="white",
        showlegend=False,
        hovermode="closest",
    )
    return fig

