            f"<td style='padding:5px 12px;'>{r['(n1,n2)']}</td>"
            f"<td style='padding:5px 12px; text-align:right; "
            f"color:{sc}; font-weight:bold;'>{r['Support']}</td>"
            f"<td style='padding:5px 12px; text-align:right;'>{r['N/4']:.1f}</td>"
            f"<td style='padding:5px 12px; text-align:right;'>{r['Entropy']:.2f}</td>"
