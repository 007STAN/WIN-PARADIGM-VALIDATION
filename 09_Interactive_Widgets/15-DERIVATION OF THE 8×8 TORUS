def mesh_of(support):
    if support in (64, 32):
        return "outer"
    return "middle"

def render_table(sort_key):
    table_out.clear_output(wait=True)
    rows = []
    for m in modes_at_4:
        name, n4, support = assignment[m]
        S = entropy_bits(*m)
        mesh = mesh_of(support)
        rows.append({
            "Particle": name,
            "(n1,n2)": f"({m[0]},{m[1]})",
            "Support": support,
            "N/4": n4,
            "Entropy": S,
            "Mesh": mesh,
            "Charge": {"nu": 0, "e": -1, "u": 2/3, "d": -1/3,
                       "s": -1/3, "mu": -1, "dark": 0, "c": 2/3,
                       "tau": -1, "b": -1/3, "W": 1, "Z": 0,
                       "H": 0, "t": 2/3}[name],
        })
    df = pd.DataFrame(rows)

    if sort_key == "N4_desc":
        df = df.sort_values("N/4", ascending=False)
    elif sort_key == "N4_asc":
        df = df.sort_values("N/4", ascending=True)
    elif sort_key == "support":
        df = df.sort_values(["Support", "N/4"], ascending=[False, False])
    elif sort_key == "entropy":
        df = df.sort_values(["Entropy", "N/4"], ascending=[False, False])
    elif sort_key == "mesh":
        df = df.sort_values(["Mesh", "N/4"], ascending=[True, False])

    rows_html = ""
    for _, r in df.iterrows():
