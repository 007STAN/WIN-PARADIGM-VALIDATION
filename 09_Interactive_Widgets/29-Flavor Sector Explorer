interact(
    run_flavor,
    w_l=FloatSlider(min=0.55, max=0.85, step=0.005, value=0.70,
                    description="w_ℓ",
                    continuous_update=False,
                    style={"description_width": "110px"}),
    w_nu=FloatSlider(min=0.15, max=0.45, step=0.005, value=0.30,
                     description="w_ν",
                     continuous_update=False,
                     style={"description_width": "110px"}),
    phi_gen=FloatSlider(min=0.30, max=0.90, step=0.01, value=0.60,
                        description="φ_gen / π",
                        continuous_update=False,
                        style={"description_width": "110px"}),
    a_phase=FloatSlider(min=0.30, max=0.90, step=0.01, value=0.60,
                        description="a  (winding)",
                        continuous_update=False,
                        style={"description_width": "110px"}),
    show_landscape=Checkbox(value=True,
