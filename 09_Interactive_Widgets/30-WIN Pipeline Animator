# ============================================================
# WIN PARADIGM — Widget #30
# WIN Pipeline Animator v2
# ============================================================
#
# Single λ slider drives the full six-layer chain:
#
#   WIN(w=−1) → DME(γ) → Core(L[ε]) → EFT(w,ζ,m_s)
#            → ENTROPIX(M1,M2) → SYK(antipode)
#
# The vacuum fraction
#
#   f(λ) = 1 − e^(−4γλ)
#
# is the natural progression parameter. It is exactly
# 1 − (ε(λ)/ε₀)² from the Core gradient flow, so it is
# not ad hoc — it is the fraction of perturbation decayed.
#
# At λ = 0:   bare WIN baseline
#   w = −1.0000, ζ = 0, m_s = 0, all residuals maximal
#
# As λ → ∞:   full DME vacuum
#   w = −1.0140540788…, ζ = 0.0046846929…, m_s = 9.02×10⁻²¹ eV
#
# Play button auto-advances λ and lets you watch the whole
# pipeline evolve in real time.
# ============================================================

import numpy as np
import matplotlib.pyplot as plt
import mpmath as mp
from matplotlib.patches import FancyArrowPatch, Rectangle
from ipywidgets import (interact, FloatSlider, IntSlider, Checkbox,
                        Button, HBox, VBox, jslink)
from IPython.display import display

mp.mp.dps = 30

# ------------------------------------------------------------
# Framework constants — γ from the strip integral
# ------------------------------------------------------------
def I_closed(alpha):
    alpha = mp.mpf(alpha)
    a = mp.mpf(-0.5) + mp.mpf(1) / (2 * alpha)
    return (mp.mpf(1) / (2 * alpha)) * (mp.beta(a, mp.mpf(0.5)) - mp.mpf(1) / a)

I2_mp   = I_closed(2)
I2p_mp  = mp.diff(I_closed, mp.mpf(2), 2)
GAMMA   = float((2 * I2p_mp) / I2_mp)

M_P_eV = 1.220890e28

# Fixed vacuum targets
W_VAC    = -1.0 - (1.0 - GAMMA)**2 / (2.0 * np.pi)
ZETA_VAC = (1.0 - GAMMA)**2 / (6.0 * np.pi)
MS_VAC   = (M_P_eV / 64) * np.exp(-5.0 * 64 / 3.0)
H_BOOST  = 1.0 + (GAMMA - 0.5) / (2.0 * np.pi)
ALPHA_C  = 1.0 / (16.0 * np.pi**2)

# ------------------------------------------------------------
# Six layers — metadata for the chain visualization
# ------------------------------------------------------------
LAYERS = [
    {"id": 1, "name": "FDLM/WIN",   "color": "#d62728",
     "short": "w = −1"},
    {"id": 2, "name": "DME",        "color": "#ff7f0e",
     "short": "γ"},
    {"id": 3, "name": "Core",       "color": "#9467bd",
     "short": "L[ε]"},
    {"id": 4, "name": "EFT",        "color": "#1f77b4",
     "short": "w, ζ, m_s"},
    {"id": 5, "name": "ENTROPIX",   "color": "#2ca02c",
     "short": "M1, M2"},
    {"id": 6, "name": "SYK/QIN",    "color": "#e377c2",
     "short": "antipode"},
]

# ------------------------------------------------------------
# Physics functions
# ------------------------------------------------------------
def epsilon_of_lambda(lam, eps0):
    return eps0 * np.exp(-2.0 * GAMMA * lam)

def vacuum_fraction(lam):
    return float(np.clip(1.0 - np.exp(-4.0 * GAMMA * lam), 0.0, 1.0))

def entropy_well(eps):
    return 1.0 - GAMMA * eps**2 + eps**4

def lyapunov(eps):
    return GAMMA * eps**2 + eps**4

def dL_dlambda(eps):
    return -4.0 * GAMMA**2 * eps**2

def M1_residual(eps):
    return 4.0 * GAMMA**2 * eps**2 - 8.0 * GAMMA * eps**4

def M2_export(eps):
    return 4.0 * GAMMA**2 * eps**2

# ------------------------------------------------------------
# The widget
# ------------------------------------------------------------
def run_pipeline(lam=0.0, eps0=0.20, show_log=True):
    plt.close("all")

    # ---- Live state ----
    eps  = epsilon_of_lambda(lam, eps0)
    S    = entropy_well(eps)
    L    = lyapunov(eps)
    dL   = dL_dlambda(eps)
    M1   = M1_residual(eps)
    M2   = M2_export(eps)
    vac  = vacuum_fraction(lam)

    # Live EFT values — interpolate from bare WIN to full vacuum
    w_cur    = -1.0 + (W_VAC    + 1.0) * vac
