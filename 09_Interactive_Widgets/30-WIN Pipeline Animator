    play_button.button_style = ("warning" if _playing["state"]
                                else "success")
    if _playing["state"]:
        _advance()

def _advance():
    if not _playing["state"]:
        return
    new_lam = lam_slider.value + 0.05
    if new_lam > lam_slider.max:
        new_lam = lam_slider.min
    lam_slider.value = new_lam
    if _playing["state"]:
        import threading
        threading.Timer(0.10, _advance).start()

def _on_reset(b):
    _playing["state"] = False
    play_button.description = "▶  Play"
    play_button.button_style = "success"
    lam_slider.value = 0.0

play_button.on_click(_on_play)
reset_button.on_click(_on_reset)

_display(HBox([play_button, reset_button]))
