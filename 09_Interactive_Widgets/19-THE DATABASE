# ============================================================
# FIGURE BUILDER
# ============================================================
def build_figure(sort_by=None, ascending=False, highlight=None,
                 show_only=None):
    """Build the interactive database figure."""
    fig = make_subplots(
        rows=1, cols=2,
        column_widths=[0.55, 0.45],
        subplot_titles=(
            "Particles by m_f(r) and nearest reference",
            "Database structure: references vs perturbations",
        ),
        specs=[[{"type": "xy"}, {"type": "xy"}]],
        horizontal_spacing=0.10,
    )

    # Left panel: horizontal bar chart of m_f(r)
    sorted_df = df.sort_values("m_f", ascending=True)
    if show_only == "reference":
        sorted_df = sorted_df[sorted_df["type"] == "reference"]
    elif show_only == "perturbation":
        sorted_df = sorted_df[sorted_df["type"] == "perturbation"]

    for _, row in sorted_df.iterrows():
        is_ref = row["type"] == "reference"
        is_hi = (highlight == row["particle"])
        color = "#C44E52" if is_ref else "#888888"
        if is_hi:
            color = "#2E8B57"
        width = 3 if is_hi else 0
        fig.add_trace(go.Bar(
            y=[f"{row['particle']}"],
            x=[row["m_f"]],
            orientation="h",
            marker=dict(color=color,
                        line=dict(width=width, color="#222")),
            hovertemplate=(
                f"<b>{row['particle']}</b><br>"
                f"({row['n1']},{row['n2']})<br>"
                f"support = {row['support']}<br>"
                f"entropy = {row['entropy']:.1f}<br>"
                f"m_f = {row['m_f']:.4f}<br>"
                f"nearest = kL/2^{row['nearest_target_n']}<br>"
                f"perturbation = {row['pert_rel_%']:+.2f}%<br>"
                f"N/4 = {row['N4']}<br>"
                f"charge = {row['charge']:+.4f}"
                "<extra></extra>"
            ),
            showlegend=False,
        ), row=1, col=1)

    # Add vertical lines for the four reference targets
    for n in [0, 1, 2, 3]:
        target = kL / (2**n)
        fig.add_shape(
            type="line", x0=target, x1=target, y0=-0.5,
            y1=len(sorted_df)-0.5,
            line=dict(color="#DDD", width=1.5, dash="dot"),
            row=1, col=1,
        )

    # Right panel: scatter of perturbation vs m_f, with references at 0
    for _, row in df.iterrows():
        is_ref = row["type"] == "reference"
        is_hi = (highlight == row["particle"])
        color = "#C44E52" if is_ref else "#888888"
        if is_hi:
            color = "#2E8B57"
        size = 18 if is_hi else (14 if is_ref else 10)
        symbol = "circle" if is_ref else "circle-open"
        fig.add_trace(go.Scatter(
            x=[row["m_f"]],
            y=[row["pert_rel_%"]],
            mode="markers+text",
            marker=dict(size=size, color=color, symbol=symbol,
                        line=dict(width=1.5, color="black")),
            text=[row["particle"]],
            textposition="top center",
            textfont=dict(size=10),
            hovertemplate=(
                f"<b>{row['particle']}</b><br>"
                f"m_f = {row['m_f']:.4f}<br>"
                f"perturbation = {row['pert_rel_%']:+.2f}%<br>"
                f"nearest = kL/2^{row['nearest_target_n']}"
                "<extra></extra>"
            ),
            showlegend=False,
        ), row=1, col=2)

    # Zero line for perturbations
    fig.add_shape(
        type="line", x0=0, x1=200, y0=0, y1=0,
        line=dict(color="#CCC", width=1), row=1, col=2,
    )

    # Axis labels
    fig.update_xaxes(title_text="m_f(r) [GeV]", range=[0, 200],
                     showgrid=True, gridcolor="#EEE", row=1, col=1)
    fig.update_yaxes(title_text="", row=1, col=1)
    fig.update_xaxes(title_text="m_f(r) [GeV]", range=[0, 200],
                     showgrid=True, gridcolor="#EEE", row=1, col=2)
    fig.update_yaxes(title_text="perturbation from nearest target [%]",
                     range=[-60, 60],
                     showgrid=True, gridcolor="#EEE", row=1, col=2)

    fig.update_layout(
        title=dict(
            text="<b>The Particle Spectrum Database</b><br>"
                 "<sub>Four references (red) at kL/2^n. "
                 "Nine perturbations (gray) stored without structure.</sub>",
            x=0.5, xanchor="center",
        ),
        height=640,
        margin=dict(l=60, r=40, t=100, b=60),
        plot_bgcolor="white",
        showlegend=False,
        hovermode="closest",
        barmode="overlay",
    )
    return fig

