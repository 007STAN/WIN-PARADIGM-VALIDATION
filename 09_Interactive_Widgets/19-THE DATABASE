             ("support", "support"),
             ("entropy", "entropy"),
             ("perturbation %", "pert_rel_%")],
    description="Sort by:",
    layout=widgets.Layout(width="300px"),
)

out = widgets.Output()

def render(change=None):
    with out:
        clear_output(wait=True)
        fig = build_figure(
            highlight=highlight_dropdown.value,
            show_only=show_only_dropdown.value,
        )
        fig.show()

highlight_dropdown.observe(render, names="value")
show_only_dropdown.observe(render, names="value")
sort_dropdown.observe(render, names="value")

