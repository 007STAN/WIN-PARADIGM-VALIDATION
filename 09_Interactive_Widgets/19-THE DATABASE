# ============================================================
# FRAMEWORK CONSTANTS
# ============================================================
d = 4
N = d * 2**d        # 64
H = 2**d            # 16
V = (d - 1) * 2**d  # 48
L = 8
kL = 38.442527

A = kL / 7.88
B = H + kL / 26
C = -kL * (d + 4.23)
r_e = 0.025954

def m_f(r):
    return A * (r / r_e)**B * np.exp(C * (r - r_e))

# ============================================================
# THE 14 MODES WITH ALL PROPERTIES
# ============================================================
# (n1, n2, particle, ratio, support, entropy, N4, charge)
DATA = [
    # support 64
    ((0, 4), "nu",   0.025277, 64, 6.0, 60.0,  0.0),
    ((4, 0), "e",    0.025954, 64, 6.0, 24.0, -1.0),
    # support 48
    ((1, 3), "u",    0.027005, 48, 5.5, 21.0,  2/3),
    ((1, 5), "d",    0.027909, 48, 5.5, 20.0, -1/3),
    ((3, 1), "s",    0.028405, 48, 5.5, 14.0, -1/3),
    ((3, 7), "mu",   0.029813, 48, 5.5, 14.0, -1.0),
    ((5, 7), "dark", 0.032000, 48, 5.5, 12.0,  0.0),  # dark photon
    ((7, 3), "c",    0.030461, 48, 5.5,  9.5,  2/3),
    ((7, 5), "tau",  0.031913, 48, 5.5,  9.0, -1.0),
    ((5, 1), "b",    0.033079, 48, 5.5,  7.5, -1/3),
    # support 32
    ((2, 2), "W",    0.033236, 32, 5.0,  2.0,  1.0),
    ((2, 6), "Z",    0.033262, 32, 5.0,  2.0,  0.0),
    ((6, 2), "H",    0.041677, 32, 5.0,  1.0,  0.0),
    ((6, 6), "t",    0.067489, 32, 5.0,  0.5,  2/3),
]

REFERENCE_PARTICLES = ["Z", "c", "d", "e"]

# Build a dataframe
rows = []
for (n1, n2), p, r, supp, ent, n4, q in DATA:
    w = m_f(r)
    # Nearest kL/2^n
    best_n = None; best_dist = np.inf
    for n in range(-4, 8):
        target = kL / (2**n)
        dist = abs(w - target)
        if dist < best_dist:
            best_dist = dist; best_n = n
    target = kL / (2**best_n)
    pert = w - target
    pert_rel = pert / target * 100
    is_ref = p in REFERENCE_PARTICLES
    rows.append({
        "particle": p,
        "n1": n1, "n2": n2,
        "support": supp,
        "entropy": ent,
        "ratio": r,
        "m_f": w,
        "nearest_target_n": best_n,
        "nearest_target": target,
        "perturbation": pert,
        "pert_rel_%": pert_rel,
        "N4": n4,
        "charge": q,
        "type": "reference" if is_ref else "perturbation",
    })

df = pd.DataFrame(rows)

