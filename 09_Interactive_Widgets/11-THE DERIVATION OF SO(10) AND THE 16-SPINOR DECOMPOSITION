def su3_dim(s):
    if "Q_L" in s["state"] or s["state"].startswith("u_R") or s["state"].startswith("d_R"):
        return 3
    return 1

def su2_dim(s):
    if "Q_L" in s["state"] or "L_L" in s["state"]:
        return 2
    return 1

grouped = defaultdict(lambda: {"count": 0, "states": []})
for s in states:
    key = (su3_dim(s), su2_dim(s), s["Y"])
    grouped[key]["count"] += 1
    grouped[key]["states"].append(s["state"])

print(f"{'SU(3)':>8} {'SU(2)':>8} {'Y':>8} {'count':>8} {'SM content':>20}")
print("-" * 78)
for key in sorted(grouped.keys(), key=lambda k: (-k[0], -k[1], float(k[2]))):
    su3, su2, Y = key
    count = grouped[key]["count"]
    if su3 == 3 and su2 == 2:
        content = "Quark doublet"
    elif su3 == 3 and su2 == 1:
        if Y == Fraction(2, 3):
            content = "Up singlet"
        else:
            content = "Down singlet"
    elif su3 == 1 and su2 == 2:
        content = "Lepton doublet"
    elif su3 == 1 and su2 == 1:
        if Y == Fraction(-1):
            content = "Electron singlet"
        elif Y == Fraction(0):
            content = "Neutrino singlet"
        else:
            content = "?"
    else:
        content = "?"
    Y_str = f"{Y.numerator}/{Y.denominator}" if Y.denominator > 1 else f"{Y.numerator}"
    print(f"{su3:>8} {su2:>8} {Y_str:>8} {count:>8} {content:>20}")

print()
