# ============================================================
# FRAMEWORK CONSTANTS
# ============================================================
d = 4
N = d * 2**d        # 64
H = 2**d            # 16
V = (d - 1) * 2**d  # 48
L = 8
kL = 38.442527

# Processing function coefficients
A = kL / 7.88
B = H + kL / 26
C = -kL * (d + 4.23)
r_e = 0.025954

def m_f(r):
    return A * (r / r_e)**B * np.exp(C * (r - r_e))

# ============================================================
# THE 13 PARTICLES (from the base-2 paper)
# ============================================================
particles = {
    "nu":  (0.025277, "light neutrino", 0),
    "e":   (0.025954, "electron", -1),
    "u":   (0.027005, "up", 2/3),
    "d":   (0.027909, "down", -1/3),
    "s":   (0.028405, "strange", -1/3),
    "mu":  (0.029813, "muon", -1),
    "c":   (0.030461, "charm", 2/3),
    "tau": (0.031913, "tau", -1),
    "b":   (0.033079, "bottom", -1/3),
    "W":   (0.033236, "W boson", 1),
    "Z":   (0.033262, "Z boson", 0),
    "H":   (0.041677, "Higgs", 0),
    "t":   (0.067489, "top", 2/3),
}

# ============================================================
# THE FOUR REFERENCES
# ============================================================
references = [
    ("Z", 0, kL),       # n = 0
    ("c", 1, kL / 2),   # n = 1
    ("d", 2, kL / 4),   # n = 2
    ("e", 3, kL / 8),   # n = 3
]

