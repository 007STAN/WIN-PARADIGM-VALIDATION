# ============================================================
# FIGURE BUILDER
# ============================================================

def build_figure():
    by_level = {}
    for n in CHAIN:
        by_level.setdefault(n["level"], []).append(n)

    pos = {}
    for lvl, nodes in by_level.items():
        n = len(nodes)
        for i, node in enumerate(nodes):
            y = (i - (n - 1) / 2) * 1.0
            pos[node["id"]] = (lvl * 2.2, y)

    edge_x, edge_y = [], []
    for a, b in EDGES:
        x0, y0 = pos[a]
        x1, y1 = pos[b]
        edge_x += [x0, x1, None]
        edge_y += [y0, y1, None]

    edge_trace = go.Scatter(
        x=edge_x, y=edge_y,
        line=dict(width=1.2, color="#BBBBBB"),
        hoverinfo="none", mode="lines", showlegend=False,
    )

    node_x, node_y, node_text, node_hover = [], [], [], []
    node_color, node_size = [], []

    for n in CHAIN:
        x, y = pos[n["id"]]
        node_x.append(x)
        node_y.append(y)
        node_text.append(n["label"])
        node_hover.append(
            f"<b>{n['label'].replace(chr(10),' ')}</b><br>"
            f"<i>{n['eq']}</i><br><br>"
            f"<b>Status:</b> {STATUS_LABEL[n['status']]}<br><br>"
            f"{n['exp']}<br><br>"
            f"<span style='color:#888'>Source: {n['src']}</span>"
        )
        node_color.append(STATUS_COLOR[n["status"]])
        node_size.append(28)

    node_trace = go.Scatter(
        x=node_x, y=node_y,
        mode="markers+text",
        text=node_text,
        textposition="middle right",
        textfont=dict(size=10),
        hovertext=node_hover,
        hoverinfo="text",
        marker=dict(
            size=node_size,
            color=node_color,
            line=dict(width=2, color="black"),
        ),
        showlegend=False,
    )

    # Legend via dummy traces
    legend_traces = []
    for status in ["verified", "interpretive", "unverified",
                   "falsified", "fitted"]:
        legend_traces.append(go.Scatter(
            x=[None], y=[None], mode="markers",
            marker=dict(size=14, color=STATUS_COLOR[status],
                        line=dict(width=1, color="black")),
            name=STATUS_LABEL[status], showlegend=True,
        ))

    fig = go.Figure(data=[edge_trace, node_trace] + legend_traces)

    fig.update_layout(
        title=dict(
            text="<b>WIN Paradigm — Derivation Chain (v2)</b><br>"
                 "<sub>Color indicates verification status. "
                 "Hover any node for details.</sub>",
            x=0.5, xanchor="center",
        ),
        showlegend=True,
        legend=dict(orientation="h", yanchor="bottom", y=-0.08,
                    xanchor="center", x=0.5),
        hovermode="closest",
        margin=dict(l=20, r=20, t=80, b=60),
        xaxis=dict(showgrid=False, zeroline=False, showticklabels=False),
        yaxis=dict(showgrid=False, zeroline=False, showticklabels=False,
                   scaleanchor="x", scaleratio=0.6),
        plot_bgcolor="white",
        height=880,
        dragmode="pan",
    )
    return fig

