def show_node(node_id):
    detail.clear_output()
    if node_id is None:
        return
    n = next(x for x in CHAIN if x["id"] == node_id)

    preds = [a for a, b in EDGES if b == node_id]
    succs = [b for a, b in EDGES if a == node_id]
    pred_labels = {x["id"]: x["label"].replace("\n", " ") for x in CHAIN}
    pred_str = ", ".join(pred_labels[p] for p in preds) or "-"
    succ_str = ", ".join(pred_labels[s] for s in succs) or "-"

    with detail:
        display(HTML(f"""
        <div style="border-left:6px solid {CAT_COLOR[n['cat']]};
                    padding:14px 18px; margin:10px 0;
                    background:#FAFAFA; border-radius:6px;
                    font-family: -apple-system, system-ui, sans-serif;">
          <div style="font-size:11px; color:#888; letter-spacing:1px;
                      text-transform:uppercase;">
            {CAT_LABEL[n['cat']]} &middot; Level {n['level']}
          </div>
          <h2 style="margin:4px 0 6px 0; color:#222;">
            {n['label'].replace(chr(10), ' ')}
          </h2>
          <div style="font-size:16px; font-family: 'Cambria Math', serif;
                      background:#FFF; padding:10px 14px;
                      border:1px solid #EEE; border-radius:4px;
                      display:inline-block; margin-bottom:10px;">
            {n['eq']}
          </div>
          <p style="font-size:14px; line-height:1.55; color:#333; margin:8px 0;">
            {n['exp']}
          </p>
          <div style="font-size:12px; color:#555; margin-top:10px;">
            <b>Predecessors:</b> {pred_str}<br>
            <b>Successors:</b> {succ_str}<br>
            <b>Source:</b> <code>{n['src']}</code>
          </div>
        </div>
        """))

