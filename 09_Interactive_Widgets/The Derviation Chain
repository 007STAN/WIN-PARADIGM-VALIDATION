# ============================================================
# FIGURE BUILDER
# ============================================================

def build_figure(highlight=None):
    """Build a Plotly figure of the derivation chain.

    Layout is a layered DAG (left-to-right by 'level').
    If `highlight` is a node id, that node and its neighbors are emphasized.
    """
    by_level = {}
    for n in CHAIN:
        by_level.setdefault(n["level"], []).append(n)

    pos = {}
    for lvl, nodes in by_level.items():
        n = len(nodes)
        for i, node in enumerate(nodes):
            y = (i - (n - 1) / 2) * 1.0
            pos[node["id"]] = (lvl * 2.2, y)

    if highlight:
        neighbors = {highlight}
        for a, b in EDGES:
            if a == highlight: neighbors.add(b)
            if b == highlight: neighbors.add(a)
    else:
        neighbors = {n["id"] for n in CHAIN}

    # --- Edges ---
    edge_x, edge_y = [], []
    for a, b in EDGES:
        x0, y0 = pos[a]
        x1, y1 = pos[b]
        edge_x += [x0, x1, None]
        edge_y += [y0, y1, None]

    edge_trace = go.Scatter(
        x=edge_x, y=edge_y,
        line=dict(width=1.2, color="#BBBBBB"),
        hoverinfo="none", mode="lines", showlegend=False,
    )

    # --- Nodes ---
    node_x, node_y, node_text, node_hover = [], [], [], []
    node_color, node_size = [], []
    node_line_width, node_line_color = [], []

    for n in CHAIN:
        x, y = pos[n["id"]]
        node_x.append(x)
        node_y.append(y)
        node_text.append(n["label"])
        node_hover.append(
            f"<b>{n['label'].replace(chr(10),' ')}</b><br>"
            f"<i>{n['eq']}</i><br><br>"
            f"{n['exp']}<br><br>"
            f"<span style='color:#888'>Source: {n['src']}</span>"
        )
        if n["id"] in neighbors:
            node_color.append(CAT_COLOR[n["cat"]])
            node_size.append(28)
            node_line_width.append(2)
            node_line_color.append("black")
        else:
            node_color.append("#E8E8E8")
            node_size.append(18)
            node_line_width.append(1)
            node_line_color.append("#CCCCCC")

    node_trace = go.Scatter(
        x=node_x, y=node_y,
        mode="markers+text",
        text=node_text,
        textposition="middle right",
        textfont=dict(size=10),
        hovertext=node_hover,
        hoverinfo="text",
        marker=dict(
            size=node_size,
            color=node_color,
            line=dict(
                width=node_line_width,
                color=node_line_color,
            ),
        ),
        showlegend=False,
    )

    # --- Legend ---
    legend_traces = []
    for cat, color in CAT_COLOR.items():
        legend_traces.append(go.Scatter(
            x=[None], y=[None], mode="markers",
            marker=dict(size=12, color=color),
            name=CAT_LABEL[cat], showlegend=True,
        ))

    fig = go.Figure(data=[edge_trace, node_trace] + legend_traces)

    fig.update_layout(
        title=dict(
            text="<b>WIN Paradigm - Derivation Chain</b><br>"
                 "<sub>Photon -> d=4 -> SO(10) -> N=64 -> 14 particles. "
                 "Hover a node for details.</sub>",
            x=0.5, xanchor="center",
        ),
        showlegend=True,
        legend=dict(orientation="h", yanchor="bottom", y=-0.05,
                    xanchor="center", x=0.5),
        hovermode="closest",
        margin=dict(l=20, r=20, t=80, b=40),
        xaxis=dict(showgrid=False, zeroline=False, showticklabels=False,
                   title=""),
        yaxis=dict(showgrid=False, zeroline=False, showticklabels=False,
                   title="", scaleanchor="x", scaleratio=0.6),
        plot_bgcolor="white",
        height=850,
        dragmode="pan",
    )
    return fig

