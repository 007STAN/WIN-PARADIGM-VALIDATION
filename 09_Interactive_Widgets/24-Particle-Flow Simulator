             f"m_s(λ)    = {ms_eff:.6e}  eV [vac {MS_VAC:.4e}]",
             fontsize=8.5, family="monospace")
    ax7.text(0.34, 0.04,
             f"H_loc/H_CMB = {H_BOOST:.10f}   α = {1/(16*np.pi**2):.8f}",
             fontsize=8.5, family="monospace")

    # Column 3
    ax7.text(0.68, 0.86, "⑤ ENTROPIX/MESA", fontsize=10,
             fontweight="bold", color="#2ca02c")
    ax7.text(0.68, 0.76,
             f"M1  ∂I_eff/∂λ  = {M1r:+.4e}   {'✓' if m1_ok else '✗'}",
             fontsize=8.5, family="monospace",
             color="green" if m1_ok else "red")
