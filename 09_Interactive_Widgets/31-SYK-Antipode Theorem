import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle
from scipy.linalg import eigh
from itertools import combinations
from ipywidgets import interact, IntSlider, Dropdown, Checkbox

# ------------------------------------------------------------
# Framework constants
# ------------------------------------------------------------
L = 8
N_MAJORANA = 16

K14 = [(0,4),(4,0),(1,3),(1,5),(2,2),(2,6),(3,1),(3,7),
       (5,1),(5,7),(6,2),(6,6),(7,3),(7,5)]

def A(m):
    return ((-m[0]) % L, (-m[1]) % L)

PAIRS = []
for m in K14:
    am = A(m)
    if m < am:
        PAIRS.append((m, am))

SELF_PAIRED = [m for m in K14 if A(m) == m]

# ------------------------------------------------------------
# Jordan-Wigner Majoranas
# ------------------------------------------------------------
def build_majoranas(N):
    n_q = N // 2
    I2 = np.eye(2, dtype=complex)
    sx = np.array([[0,1],[1,0]], dtype=complex)
    sy = np.array([[0,-1j],[1j,0]], dtype=complex)
    sz = np.array([[1,0],[0,-1]], dtype=complex)
    def kt(mats):
        r = mats[0]
        for m in mats[1:]:
            r = np.kron(r, m)
        return r
    psis = []
    for j in range(n_q):
        pre = [sz]*j
        suf = [I2]*(n_q - j - 1)
        psis.append(kt(pre + [sx] + suf) / np.sqrt(2))
        psis.append(kt(pre + [sy] + suf) / np.sqrt(2))
    return psis

def build_syk(N, J=1.0, seed=42):
    rng = np.random.default_rng(seed)
    psis = build_majoranas(N)
    dim = psis[0].shape[0]
    H = np.zeros((dim, dim), dtype=complex)
    std = np.sqrt(6.0) * J / (N ** 1.5)
    for (i,j,k,l) in combinations(range(N), 4):
        H += rng.normal(0, std) * psis[i] @ psis[j] @ psis[k] @ psis[l]
    return H, psis

def positions(embedding, N=N_MAJORANA):
    pos = []
    if embedding == "row":
        for i in range(N):
            pos.append((i // L, i % L))
    elif embedding == "column":
        for i in range(N):
            pos.append((i % L, i // L))
    elif embedding == "diagonal":
        for i in range(8):
            pos.append((i, i))
        for i in range(8):
            pos.append(((i + 4) % 8, i))
    return pos

def build_bilinear(m, psis, pos):
    N = len(psis)
    n1, n2 = m
    f = np.array([np.exp(2j * np.pi * (n1*p[0] + n2*p[1]) / L) for p in pos])
    O = np.zeros_like(psis[0])
    for a in range(N):
        for b in range(a + 1, N):
            c = 2.0 * np.imag(f[a] * np.conj(f[b]))
            if abs(c) > 1e-14:
                O += c * (psis[a] @ psis[b])
    return O

def compute_all(H, psis, pos):
    E, V = eigh(H)
    V0 = V[:, 0]
    bilinears = {m: build_bilinear(m, psis, pos) for m in K14}
    w = {}
    for m in K14:
        Ov0 = bilinears[m] @ V0
        w[m] = float(np.vdot(Ov0, Ov0).real)
    ident = {}
    for m in K14:
        diff = bilinears[A(m)] + bilinears[m]
        ident[m] = float(np.max(np.abs(diff)))
    return E, V, V0, bilinears, w, ident

# ------------------------------------------------------------
# Cache
# ------------------------------------------------------------
_cache = {}

def get_data(seed, embedding):
    key = (seed, embedding)
    if key not in _cache:
        H, psis = build_syk(N_MAJORANA, seed=seed)
        pos = positions(embedding)
        E, V, V0, bilinears, w, ident = compute_all(H, psis, pos)
        _cache[key] = dict(E=E, V=V, V0=V0, w=w, ident=ident)
    return _cache[key]

# ============================================================
# Widget
# ============================================================
def run_widget(seed=42, embedding="row", show_energy=False):
    plt.close("all")
    data = get_data(seed, embedding)
    E, V0 = data["E"], data["V0"]
    w = data["w"]
    ident = data["ident"]

    fig = plt.figure(figsize=(17, 11), facecolor="white")
    fig.suptitle(
        f"The SYK-Antipode Theorem  ·  seed = {seed}  ·  "
        f"embedding = {embedding}   |   "
        f"$\\mathcal{{O}}_{{A(m)}} = -\\mathcal{{O}}_m$ exactly",
        fontsize=14, fontweight="bold", y=0.985,
    )

    # =========================================================
    # Panel 1 — Torus
    # =========================================================
    ax1 = fig.add_axes([0.04, 0.60, 0.30, 0.34])
    ax1.set_title("① The 14 torus modes at $\\lambda=4$",
                  fontsize=11, fontweight="bold", color="#1f77b4")
    ax1.set_xlim(-0.7, 7.7); ax1.set_ylim(-0.7, 7.7)
    ax1.set_aspect("equal")
    ax1.set_xticks(range(8)); ax1.set_yticks(range(8))
    ax1.grid(True, alpha=0.25)
    ax1.set_xlabel("$n_1$", fontsize=10)
    ax1.set_ylabel("$n_2$", fontsize=10)

    for i in range(8):
        for j in range(8):
            ax1.plot(i, j, ".", color="#dddddd", markersize=4)

    # Self-paired
    for (n1, n2) in SELF_PAIRED:
        ax1.scatter([n1], [n2], s=340, marker="X",
                    facecolor="white", edgecolor="#333",
                    linewidths=2.5, zorder=5)
        ax1.text(n1, n2, "0", fontsize=10, ha="center", va="center",
                 fontweight="bold", color="#333", zorder=6)

    # Mixed pairs
    colors = plt.cm.tab10(np.linspace(0, 1, len(PAIRS)))
    for k, (a, b) in enumerate(PAIRS):
        c = colors[k]
        ax1.scatter([a[0], b[0]], [a[1], b[1]],
                    s=260, c=[c], edgecolors="black",
                    linewidths=1.8, zorder=5)
        ax1.text(a[0], a[1], f"{a[0]},{a[1]}", fontsize=6.5,
                 ha="center", va="center", color="white",
                 fontweight="bold", zorder=6)
        ax1.text(b[0], b[1], f"{b[0]},{b[1]}", fontsize=6.5,
                 ha="center", va="center", color="white",
                 fontweight="bold", zorder=6)
        ax1.annotate("", xy=b, xytext=a,
                     arrowprops=dict(arrowstyle="<->", color=c,
                                     lw=1.4, alpha=0.6,
                                     connectionstyle="arc3,rad=0.18"),
                     zorder=3)

    ax1.text(0.03, 0.03,
             f"6 pairs (colored)\n2 self-paired (X, weight = 0)",
             transform=ax1.transAxes, fontsize=8,
             family="monospace", va="bottom",
             bbox=dict(boxstyle="round", facecolor="#e6f0fa", alpha=0.9))

    # =========================================================
    # Panel 2 — Spectral weights
    # =========================================================
    ax2 = fig.add_axes([0.37, 0.60, 0.60, 0.34])
    ax2.set_title(f"② Spectral weight $w_m$ by antipode pair  (seed = {seed})",
                  fontsize=11, fontweight="bold", color="#2ca02c")

    labels = []
    left_vals = []
    right_vals = []
    left_colors = []
    for k, (a, b) in enumerate(PAIRS):
        labels.append(f"{a} ↔ {b}")
        left_vals.append(w[a])
        right_vals.append(w[b])
        left_colors.append(colors[k])
    for m in SELF_PAIRED:
        labels.append(f"{m}  (self)")
        left_vals.append(w[m])
        right_vals.append(0.0)
        left_colors.append("#888888")

    y = np.arange(len(labels))
    width = 0.36

    ax2.barh(y - width/2, left_vals, width,
             color=left_colors, edgecolor="black", linewidth=1.0,
             label="$w_m$")
    ax2.barh(y + width/2, right_vals, width,
             color=left_colors, alpha=0.55,
             edgecolor="black", linewidth=1.0, label="$w_{A(m)}$")

    for i, (a, b) in enumerate(PAIRS):
        diff = abs(w[a] - w[b])
        row_max = max(left_vals[i], right_vals[i], 1e-6)
        ax2.text(row_max * 1.02, y[i],
                 f"|Δ| = {diff:.2e}", fontsize=7,
                 family="monospace", va="center", color="#333")

    for j, m in enumerate(SELF_PAIRED):
        i = len(PAIRS) + j
        ax2.text(max(left_vals[i], 0.5), y[i], "O_m = 0",
                 fontsize=8, family="monospace", va="center", color="#333")

    ax2.set_yticks(y)
    ax2.set_yticklabels(labels, fontsize=8.5, family="monospace")
    ax2.set_xlabel("$w_m = \\langle 0 | \\mathcal{O}_m^\\dagger \\mathcal{O}_m | 0 \\rangle$",
                   fontsize=10)
    ax2.grid(True, alpha=0.3, axis="x")
    ax2.legend(fontsize=9, loc="lower right")

    ax2.text(0.98, 0.97,
             "For every pair:  $w_m = w_{A(m)}$  exactly",
             transform=ax2.transAxes, fontsize=10,
             ha="right", va="top", color="#2ca02c", fontweight="bold",
             bbox=dict(boxstyle="round", facecolor="#e6fae6", alpha=0.9))

    # =========================================================
    # Panel 3 — Operator identity check
    # =========================================================
    ax3 = fig.add_axes([0.04, 0.30, 0.30, 0.24])
    ax3.set_title("③ Operator identity  $\\|\\mathcal{O}_{A(m)} + \\mathcal{O}_m\\|$",
                  fontsize=10.5, fontweight="bold", color="#d62728")

    # ---- FIX: iterate over members of each pair ----
    labels3 = [str(a) for (a, b) in PAIRS]
    max_diff = [max(ident[a], ident[b]) for (a, b) in PAIRS]

    ax3.barh(np.arange(len(labels3)), max_diff,
             color="#d62728", edgecolor="black", linewidth=1.0)
    ax3.axvline(1e-10, color="green", ls="--", lw=1.5, alpha=0.7,
                label="noise floor")
    ax3.set_yticks(np.arange(len(labels3)))
    ax3.set_yticklabels(labels3, fontsize=8, family="monospace")
    ax3.set_xlabel("max matrix element", fontsize=9)
    ax3.set_xscale("symlog", linthresh=1e-15)
    ax3.grid(True, alpha=0.3, axis="x")
    ax3.legend(fontsize=8, loc="lower right")

    worst = max(max_diff)
    ax3.text(0.98, 0.03,
             f"worst: {worst:.2e}",
             transform=ax3.transAxes, fontsize=8.5,
             ha="right", va="bottom", family="monospace",
             color="#d62728",
             bbox=dict(boxstyle="round", facecolor="#ffe6e6", alpha=0.9))

    # =========================================================
    # Panel 4 — Spectrum
    # =========================================================
    ax4 = fig.add_axes([0.37, 0.30, 0.60, 0.24])
    ax4.set_title(f"④ SYK$_4$ spectrum (N = {N_MAJORANA}, seed = {seed})",
                  fontsize=11, fontweight="bold", color="#9467bd")

    ax4.plot(np.arange(len(E)), E, ".", color="#9467bd",
             markersize=4, alpha=0.6)
    ax4.axhline(E[0], color="red", ls="--", lw=1.2, alpha=0.7,
                label=f"$E_0$ = {E[0]:.4f}")
    if show_energy and len(E) > 50:
        ax4.axhline(E[50], color="orange", ls="--", lw=1.2,
                    alpha=0.7, label=f"$E_{{50}}$ = {E[50]:.4f}")

    ax4.set_xlabel("state index", fontsize=9)
    ax4.set_ylabel("energy", fontsize=9)
    ax4.grid(True, alpha=0.3)
    ax4.legend(fontsize=8, loc="upper left")

    ax_inset = ax4.inset_axes([0.55, 0.40, 0.42, 0.55])
    n_inset = min(50, len(E))
    ax_inset.plot(np.arange(n_inset), E[:n_inset], "o-",
                  color="#9467bd", markersize=4, lw=1)
    ax_inset.set_title(f"low-energy zoom", fontsize=7.5)
    ax_inset.tick_params(labelsize=7)
    ax_inset.grid(True, alpha=0.3)

    # =========================================================
    # Panel 5 — Instability across seeds (row embedding)
    # =========================================================
    ax5 = fig.add_axes([0.04, 0.02, 0.92, 0.24])
    ax5.set_title("⑤ Per-realization instability: no stable visible/hidden labeling",
                  fontsize=11, fontweight="bold", color="#ff7f0e")
    ax5.set_xlim(-0.5, 11.5)
    ax5.set_ylim(-0.7, 14.7)
    ax5.set_xlabel("seed 42 → 51", fontsize=9)
    ax5.grid(True, alpha=0.15)

    seeds = list(range(42, 52))
    visible_matrix = np.zeros((14, len(seeds)))

    for j, s in enumerate(seeds):
        if (s, "row") not in _cache:
            H, psis = build_syk(N_MAJORANA, seed=s)
            pos = positions("row")
            _, _, _, _, w_s, _ = compute_all(H, psis, pos)
            _cache[(s, "row")] = dict(w=w_s)
        w_s = _cache[(s, "row")]["w"]
        order = sorted(K14, key=lambda m: -w_s[m])
        top7 = set(order[:7])
        for i, m in enumerate(K14):
            visible_matrix[i, j] = 1.0 if m in top7 else 0.0

    for i in range(14):
        for j in range(len(seeds)):
            color = "#d62728" if visible_matrix[i, j] > 0 else "#f0f0f0"
            ax5.add_patch(Rectangle((j - 0.45, i - 0.45), 0.9, 0.9,
                                     facecolor=color, edgecolor="white",
                                     linewidth=0.8))
        ax5.text(len(seeds) + 0.15, i, str(K14[i]),
                 fontsize=8.5, family="monospace", va="center")
        nvis = int(visible_matrix[i].sum())
        ax5.text(len(seeds) + 1.5, i, f"{nvis}/10",
                 fontsize=8.5, family="monospace", va="center",
                 color="#d62728" if nvis < 10 else "#2ca02c",
                 fontweight="bold")

    ax5.set_xticks(range(len(seeds)))
    ax5.set_xticklabels([f"s{s}" for s in seeds], fontsize=8.5)
    ax5.set_yticks([])

    ax5.text(0.5, -0.35,
             "red = in top-7 by weight for that seed   ·   "
             "no mode appears in all 10   ·   "
             "12 of 14 appear at least once",
             transform=ax5.transAxes, fontsize=9,
             ha="center", va="top", style="italic", color="#333")

    plt.tight_layout(rect=[0, 0.03, 1, 0.96])
    plt.show()

# ============================================================
# Interactive widget
# ============================================================
interact(
    run_widget,
    seed=IntSlider(min=42, max=51, step=1, value=42,
                   description="SYK seed",
                   continuous_update=False,
                   style={"description_width": "110px"}),
    embedding=Dropdown(options=["row", "column", "diagonal"],
                        value="row",
                        description="Embedding",
                        style={"description_width": "110px"}),
    show_energy=Checkbox(value=False,
                         description="Show E_50 line",
                         indent=False),
)
