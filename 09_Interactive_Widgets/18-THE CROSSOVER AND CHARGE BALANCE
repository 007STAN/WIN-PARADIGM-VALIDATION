# Summary tables
def color_for_charge(q):
    return "#4C72B0" if q > 0 else ("#C44E52" if q < 0 else "#888")

def rows_for(entries):
    out = ""
    for p, r, q in entries:
        out += f"""<tr>
          <td style="padding:5px 12px; border-bottom:1px solid #EEE;"><b>{p}</b></td>
          <td style="padding:5px 12px; border-bottom:1px solid #EEE; font-family:monospace;">{r:.6f}</td>
          <td style="padding:5px 12px; border-bottom:1px solid #EEE;">{m_f(r):.4f}</td>
          <td style="padding:5px 12px; border-bottom:1px solid #EEE; color:{color_for_charge(q)};">{q:+.4f}</td>
        </tr>"""
    return out

