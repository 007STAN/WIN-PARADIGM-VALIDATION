        view = view.sort_values(["Shell (rule)", "Particle"])
    elif sort_key == "support_desc":
        view = view.sort_values(["Support", "Shell (rule)"],
                                ascending=[False, True])
    elif sort_key == "mass_asc":
        view = view.assign(
            mass_sort=view["Mass (GeV)"].apply(
                lambda x: -1 if pd.isna(x) else x
            )
        ).sort_values("mass_sort").drop(columns=["mass_sort"])
    elif sort_key == "particle":
        view = view.sort_values("Particle")
    elif sort_key == "n1":
        view = view.sort_values("(n1,n2)")

    rows_html = ""
    for _, r in view.iterrows():
        support_color = {64: "#C44E52", 48: "#4C72B0",
                         32: "#55A868"}.get(r["Support"], "#666")
        shell_color = {0.0: "#2E8B57", 1.0: "#4C72B0",
                       1.5: "#DD8452", 2.0: "#C44E52",
                       3.0: "#8E44AD"}.get(r["Shell (rule)"], "#666")
        mass = r["Mass (GeV)"]
        mass_str = f"{mass:.4g}" if not pd.isna(mass) else "—"
