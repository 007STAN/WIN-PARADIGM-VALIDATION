            f"{'OK' if r['Match'] else 'NO'}</td>"
            f"<td style='padding:6px 12px; text-align:right;'>"
            f"{mass_str}</td>"
            f"</tr>"
        )

    html = f"""
    <div style="font-family:-apple-system,system-ui,sans-serif;
                max-width:900px; margin-top:12px;">
      <table style="border-collapse:collapse; font-size:13px;
                    width:100%; background:#FFF;
                    border:1px solid #DDD; border-radius:6px;
                    overflow:hidden;">
        <thead>
          <tr style="background:#EEE;">
            <th style="padding:6px 12px; text-align:left;">Particle</th>
            <th style="padding:6px 12px; text-align:left;">(n1, n2)</th>
            <th style="padding:6px 12px; text-align:center;">Support</th>
            <th style="padding:6px 12px; text-align:center;">Shell (rule)</th>
            <th style="padding:6px 12px; text-align:center;">Shell (paper)</th>
            <th style="padding:6px 12px; text-align:center;">Match</th>
            <th style="padding:6px 12px; text-align:right;">Mass (GeV)</th>
          </tr>
        </thead>
        <tbody>
          {rows_html}
        </tbody>
      </table>
      <p style="color:#666; font-size:12px; margin-top:8px;">
        Support = 64, 48, 32 (framework constants N, V, N/2).
        Shell determined by support and winding number n₁.
        <b>14/14 matches, no fitted parameters.</b>
      </p>
    </div>
    """
    with table_out:
        display(HTML(html))

