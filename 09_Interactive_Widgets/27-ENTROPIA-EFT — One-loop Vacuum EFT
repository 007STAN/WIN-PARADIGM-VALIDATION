    ax3.text(0.5, 0.02, f"= {Pi_eps:.12f}",
             ha="center", fontsize=11, family="monospace",
             color="#9467bd", fontweight="bold")

    # =========================================================
    # Panel ④ — Proca mass m_s(N)
    # =========================================================
    ax4 = fig.add_axes([0.04, 0.40, 0.29, 0.24])
    ax4.set_title("④ Proca mass   m_s(N) = (M_P/N) e^(−5N/3)",
                  fontsize=11, fontweight="bold", color="#2ca02c")

    N_range = np.arange(40, 101)
    ms_range = (M_P_eV / N_range) * np.exp(-5.0 * N_range / 3.0)

    ax4.semilogy(N_range, ms_range, "b-", lw=2.5, label="m_s(N)")
    ax4.axvline(64, color="gray", ls=":", alpha=0.5)

    # detection windows
    windows = [
        (1e-22, 1e-17, "CASPEr-Wind", "cyan", 0.25),
        (1e-23, 1e-18, "Eöt-Wash", "orange", 0.20),
        (1e-13, 1e-9, "DM Radio", "pink", 0.15),
    ]
    for low, high, label, color, alpha in windows:
        ax4.axhspan(low, high, alpha=alpha, color=color, label=label)

    ax4.axhline(ms_cur, color="gold", ls="-", lw=2, alpha=0.75)
    ax4.axvline(N, color="gold", ls="-", lw=2.5, alpha=0.9)
    ax4.scatter([N], [ms_cur], s=220, c="gold",
                edgecolors="black", linewidths=2, zorder=6,
                label=f"N = {N}:  {ms_cur:.4e} eV")

    ax4.set_xlabel("N (substrate size)", fontsize=9)
    ax4.set_ylabel("m_s (eV)", fontsize=9)
    ax4.set_ylim(1e-50, 1e0)
    ax4.grid(True, alpha=0.3, which="both")
    ax4.legend(fontsize=7, loc="upper right", ncol=1)

    # =========================================================
    # Panel ⑤ — H₀ boost + closed derivations summary
    # =========================================================
    ax5 = fig.add_axes([0.355, 0.40, 0.29, 0.24])
    ax5.set_title("⑤ H₀ boost + closed derivations",
                  fontsize=11, fontweight="bold", color="#e377c2")
    ax5.set_xlim(0, 1); ax5.set_ylim(0, 1)
    ax5.axis("off")

    ax5.text(0.5, 0.95,
             f"H_local / H_CMB = {H_boost_cur:.15f}",
             fontsize=10, ha="center", family="monospace",
             fontweight="bold", color="#e377c2")
    ax5.text(0.5, 0.85,
             f"= 1 + (γ − 0.5)/(2π)",
             fontsize=9, ha="center", family="monospace")
    boost_pct = (H_boost_cur - 1.0) * 100.0
    ax5.text(0.5, 0.75,
             f"boost = {boost_pct:+.5f} %",
             fontsize=10, ha="center", family="monospace",
             fontweight="bold", color="#e377c2")

    ax5.text(0.5, 0.62,
             f"T_B / T_A = {H_boost_cur:.12f}",
             fontsize=9, ha="center", family="monospace")
    ax5.text(0.5, 0.52,
             f"α = 1/(16π²) = {ALPHA_COEFF:.15f}",
             fontsize=9, ha="center", family="monospace")

    ax5.text(0.5, 0.38, "Five open problems closed by ENTROPIX",
             fontsize=9, ha="center", fontweight="bold", color="#2ca02c")
    problems = [
        "✓  w from strip integral",
        "✓  A1 (Proca) from substrate U(1)",
        "✓  Einstein eqs from entanglement",
        "✓  H₀ boost from CDL + Israel",
        "✓  three w-mechanisms distinguished",
