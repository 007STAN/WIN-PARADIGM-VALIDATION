             bbox=dict(boxstyle="round", facecolor="#fff3e6", alpha=0.9))

    # =========================================================
    # Panel ③ — Feynman diagram + live self-energy
    # =========================================================
    ax3 = fig.add_axes([0.67, 0.71, 0.29, 0.24])
    ax3.set_title("③ One-loop self-energy   Π_ε(0)",
