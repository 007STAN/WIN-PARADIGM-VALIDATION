# ============================================================
# WIN PARADIGM — Widget #27
# ENTROPIA-EFT — One-loop Vacuum EFT
# ============================================================
#
# Layer 4 of the WIN Paradigm.
#
# Physics from ENTROPIA-EFT and ENTROPIX papers:
#
#   One-loop self-energy:
#     Π_ε(0) = |O₀| g_ε² / (4π m_ε²)
#     with g_ε = (1−γ) m_ε  and  |O₀| = 2
#     →  Π_ε(0) = (1−γ)² / (2π)
#
#   Equation of state:
#     w = −1 − (1−γ)² / (2π) = −1.0140540788576648688…
#
#   Bulk viscosity:
#     ζH/ρ = (1−γ)² / (6π) = 0.004684692952555…
#
#   Proca mass (EDF running):
#     m_s = (M_P / N) · exp(−5N/3) = 9.0247…×10⁻²¹ eV
#
#   H₀ boost (CDL + Israel junction):
#     H_local / H_CMB = 1 + (γ − 0.5) / (2π) = 1.03228290398475…
#
#   Curvature-squared coefficient:
#     α = 1 / (16π²) = 0.006332573977646…
#
#   DESI DR2: Δχ² = 0.22 vs w = −1  →  σ(w) ≈ 0.030
#   DR3 + Euclid forecast: σ(w) ≈ 0.0045  →  > 3σ distinction
# ============================================================

import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Arc, Rectangle
import mpmath as mp
from ipywidgets import interact, FloatSlider, IntSlider, Checkbox

mp.mp.dps = 40

# ------------------------------------------------------------
# Strip integral → exact γ
# ------------------------------------------------------------
def I_closed(alpha):
    alpha = mp.mpf(alpha)
    a = mp.mpf(-0.5) + mp.mpf(1) / (2 * alpha)
    return (mp.mpf(1) / (2 * alpha)) * (mp.beta(a, mp.mpf(0.5)) - mp.mpf(1) / a)

I2_mp   = I_closed(2)
I2p_mp  = mp.diff(I_closed, mp.mpf(2), 2)
GAMMA_EXACT = float((2 * I2p_mp) / I2_mp)

# Other framework constants
M_P_eV = 1.220890e28
O0_MULT = 2
W_VAC_EXACT    = -1.0 - (1.0 - GAMMA_EXACT)**2 / (2.0 * np.pi)
ZETA_VAC_EXACT = (1.0 - GAMMA_EXACT)**2 / (6.0 * np.pi)
MS_VAC_EXACT   = (M_P_eV / 64) * np.exp(-5.0 * 64 / 3.0)
H_BOOST_EXACT  = 1.0 + (GAMMA_EXACT - 0.5) / (2.0 * np.pi)
ALPHA_COEFF    = 1.0 / (16.0 * np.pi**2)

# ENTROPIX 2-loop value
W_2LOOP = -1.02196979632972250720575349889666958931470376350400232664049

# DESI sensitivities
SIGMA_DR2 = 0.030
SIGMA_DR3 = 0.0045

# ------------------------------------------------------------
# The widget
# ------------------------------------------------------------
def run_eft(delta_gamma=0.0, g_shift_pct=0.0, N=64,
            show_2loop=False, show_dr2=True, show_forecast=True):
    plt.close("all")

    # ---- Live parameters ----
    gamma_cur = GAMMA_EXACT + delta_gamma
    one_minus = 1.0 - gamma_cur
    r = 1.0 + g_shift_pct / 100.0     # g_ε / ((1−γ) m_ε)

    # ---- Live EFT observables ----
    Pi_eps = O0_MULT * (r * one_minus)**2 / (4.0 * np.pi)
    w_cur    = -1.0 - Pi_eps
    zeta_cur = Pi_eps / 3.0

    M_P_eV = 1.220890e28
    ms_cur = (M_P_eV / N) * np.exp(-5.0 * N / 3.0)

    H_boost_cur = 1.0 + (gamma_cur - 0.5) / (2.0 * np.pi)
    alpha_cur   = 1.0 / (16.0 * np.pi**2)

    # ---- Live sensitivity checks ----
    sep_dr2 = abs(w_cur + 1.0) / SIGMA_DR2
    sep_dr3 = abs(w_cur + 1.0) / SIGMA_DR3

    fig = plt.figure(figsize=(17, 15), facecolor="white")
    fig.suptitle(
        f"ENTROPIA-EFT  ·  One-loop vacuum EFT   ·   "
        f"γ = {gamma_cur:.15f}   (exact: {GAMMA_EXACT:.15f})   ·   "
        f"w = {w_cur:.12f}",
        fontsize=13, fontweight="bold", y=0.985,
    )

    # =========================================================
    # Panel ① — w(γ) with DESI bands
    # =========================================================
    ax1 = fig.add_axes([0.04, 0.71, 0.29, 0.24])
    ax1.set_title("① Equation of state   w(γ)",
                  fontsize=11, fontweight="bold", color="#1f77b4")

    g_range = np.linspace(0.66, 0.74, 400)
    w_range = -1.0 - (1.0 - g_range)**2 / (2.0 * np.pi)

    ax1.plot(g_range, w_range, "b-", lw=2.5, label="w = −1 − (1−γ)²/(2π)")
    ax1.axhline(-1.0, color="red", ls="--", lw=1.5, alpha=0.7,
                label="w = −1  (ΛCDM)")

    if show_dr2:
        ax1.axhspan(w_cur - SIGMA_DR2, w_cur + SIGMA_DR2,
                    alpha=0.15, color="gray",
                    label=f"DR2  1σ  (σ={SIGMA_DR2:.3f})")

    if show_forecast:
        ax1.axhspan(w_cur - SIGMA_DR3, w_cur + SIGMA_DR3,
                    alpha=0.35, color="green",
                    label=f"DR3+Euclid  1σ  (σ={SIGMA_DR3:.4f})")

    ax1.axvline(GAMMA_EXACT, color="red", ls=":", lw=2,
                label=f"exact γ = {GAMMA_EXACT:.6f}")
    ax1.axvline(gamma_cur, color="gold", ls="-", lw=2.5, alpha=0.9,
                label=f"current γ")
    ax1.scatter([gamma_cur], [w_cur], s=220, c="gold",
                edgecolors="black", linewidths=2, zorder=6)

    ax1.set_xlabel("γ (stability coefficient)", fontsize=9)
    ax1.set_ylabel("w (equation of state)", fontsize=9)
    ax1.set_ylim(-1.025, -0.995)
    ax1.grid(True, alpha=0.3)
    ax1.legend(fontsize=7, loc="lower right")

    ax1.text(0.03, 0.96,
             f"w(γ) = {w_cur:.12f}\n"
             f"Δw  = {w_cur + 1.0:+.12f}\n"
             f"DR2: {sep_dr2:.2f}σ    DR3: {sep_dr3:.2f}σ",
             transform=ax1.transAxes, fontsize=8, va="top",
             family="monospace",
             bbox=dict(boxstyle="round", facecolor="#e6f0fa", alpha=0.9))

    # =========================================================
    # Panel ② — ζH/ρ(γ) with Euclid sensitivity
    # =========================================================
    ax2 = fig.add_axes([0.355, 0.71, 0.29, 0.24])
    ax2.set_title("② Bulk viscosity   ζH/ρ(γ)",
                  fontsize=11, fontweight="bold", color="#ff7f0e")

    zeta_range = (1.0 - g_range)**2 / (6.0 * np.pi)
    ax2.plot(g_range, zeta_range, color="#ff7f0e", lw=2.5,
             label="ζH/ρ = (1−γ)²/(6π)")

    ax2.axhline(0, color="red", ls="--", lw=1.5, alpha=0.7,
                label="ζH/ρ = 0  (ΛCDM)")

    if show_forecast:
        ax2.axhspan(zeta_cur - 0.0015, zeta_cur + 0.0015,
                    alpha=0.25, color="green",
                    label="Euclid σ ≈ 0.0015")

    ax2.axvline(GAMMA_EXACT, color="red", ls=":", lw=2)
    ax2.axvline(gamma_cur, color="gold", ls="-", lw=2.5, alpha=0.9)
    ax2.scatter([gamma_cur], [zeta_cur], s=220, c="gold",
                edgecolors="black", linewidths=2, zorder=6)

    ax2.set_xlabel("γ", fontsize=9)
    ax2.set_ylabel("ζH/ρ", fontsize=9)
    ax2.grid(True, alpha=0.3)
    ax2.legend(fontsize=7, loc="upper right")

    ax2.text(0.03, 0.96,
             f"ζH/ρ = {zeta_cur:.12f}\n"
             f"= (w+1)/3\n"
             f"SNR vs Euclid ≈ {zeta_cur/0.0015:.2f}",
             transform=ax2.transAxes, fontsize=8, va="top",
