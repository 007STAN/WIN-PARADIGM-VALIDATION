    y = 0.27
    for p in problems:
        ax5.text(0.06, y, p, fontsize=8, family="monospace", color="#2ca02c")
        y -= 0.052

    # =========================================================
    # Panel ⑥ — DESI forecast
    # =========================================================
    ax6 = fig.add_axes([0.67, 0.40, 0.29, 0.24])
    ax6.set_title("⑥ DESI DR2 vs DR3+Euclid forecast",
                  fontsize=11, fontweight="bold", color="#d62728")
    ax6.set_xlim(-1.05, -0.95)
    ax6.set_ylim(0, 1)
    ax6.set_yticks([])

    ax6.axvline(-1.0, color="red", ls="--", lw=2,
                label="w = −1  (ΛCDM)")
    ax6.axvline(w_cur, color="gold", ls="-", lw=2.5,
                label=f"prediction w = {w_cur:.4f}")

    # DR2 bands
    if show_dr2:
        y_dr2 = 0.72
        for k, alpha in [(3, 0.08), (2, 0.15), (1, 0.30)]:
            ax6.fill_betweenx([y_dr2 - 0.06, y_dr2 + 0.06],
                              w_cur - k * SIGMA_DR2, w_cur + k * SIGMA_DR2,
                              color="blue", alpha=alpha)
        ax6.text(w_cur, y_dr2 + 0.10,
                 f"DESI DR2   (σ={SIGMA_DR2:.3f})",
                 ha="center", fontsize=9, color="blue")

    # DR3 bands
    if show_forecast:
        y_dr3 = 0.30
        for k, alpha in [(3, 0.10), (2, 0.20), (1, 0.40)]:
            ax6.fill_betweenx([y_dr3 - 0.06, y_dr3 + 0.06],
                              w_cur - k * SIGMA_DR3, w_cur + k * SIGMA_DR3,
                              color="green", alpha=alpha)
        ax6.text(w_cur, y_dr3 + 0.10,
                 f"DR3 + Euclid   (σ={SIGMA_DR3:.4f})",
                 ha="center", fontsize=9, color="green")

    ax6.text(-1.0, 0.93, "w = −1", ha="center", fontsize=9,
             color="red", fontweight="bold")
    ax6.text(w_cur, 0.93, f"w = {w_cur:.4f}",
             ha="center", fontsize=9, color="gold", fontweight="bold")

    ax6.text(-1.0, 0.55,
             f"{sep_dr2:.2f}σ from ΛCDM", ha="center",
             fontsize=8, color="blue")
    ax6.text(-1.0, 0.13,
             f"{sep_dr3:.2f}σ from ΛCDM", ha="center",
             fontsize=8, color="green")

    ax6.set_xlabel("w (equation of state)", fontsize=9)
    ax6.grid(True, alpha=0.3, axis="x")
    ax6.legend(fontsize=7, loc="lower center")

    # 2-loop reference if requested
    if show_2loop:
        ax6.axvline(W_2LOOP, color="#8c564b", ls=":",
                    lw=1.5, alpha=0.8,
                    label=f"2-loop = {W_2LOOP:.4f}")
        ax6.legend(fontsize=7, loc="lower center")

    # =========================================================
    # Panel ⑦ — Live log
    # =========================================================
    ax7 = fig.add_axes([0.04, 0.02, 0.93, 0.33])
    ax7.axis("off")
    ax7.set_xlim(0, 1); ax7.set_ylim(0, 1)

    ax7.text(0.5, 0.98,
             f"Live EFT at γ = {gamma_cur:.15f},  N = {N},  "
             f"g_ε/m_ε = {r * one_minus:.12f}",
             fontsize=12, ha="center", fontweight="bold", color="#1f77b4")

    # Column 1 — inputs
    ax7.text(0.02, 0.85, "INPUTS", fontsize=10,
             fontweight="bold", color="#9467bd")
    ax7.text(0.02, 0.75,
             f"γ_exact           = {GAMMA_EXACT:.18f}",
             fontsize=8.5, family="monospace")
    ax7.text(0.02, 0.66,
             f"δγ (perturb)      = {delta_gamma:+.5f}",
             fontsize=8.5, family="monospace")
    ax7.text(0.02, 0.57,
             f"γ_current         = {gamma_cur:.18f}",
             fontsize=8.5, family="monospace", color="gold",
             fontweight="bold")
    ax7.text(0.02, 0.48,
             f"1 − γ             = {one_minus:.18f}",
             fontsize=8.5, family="monospace")
    ax7.text(0.02, 0.39,
             f"g_ε/m_ε shift     = {g_shift_pct:+.3f} %",
             fontsize=8.5, family="monospace")
    ax7.text(0.02, 0.30,
             f"r = g_ε / [(1−γ)m_ε] = {r:.6f}",
             fontsize=8.5, family="monospace")
    ax7.text(0.02, 0.21,
             f"|O₀|              = {O0_MULT}",
