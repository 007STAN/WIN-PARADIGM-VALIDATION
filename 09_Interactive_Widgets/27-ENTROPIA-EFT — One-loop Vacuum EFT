    ax7.text(0.34, 0.66,
             f"w          = {w_cur:.18f}",
             fontsize=8.5, family="monospace", color="#1f77b4",
             fontweight="bold")
    ax7.text(0.34, 0.57,
             f"w + 1      = {w_cur + 1.0:+.18f}",
             fontsize=8.5, family="monospace")
    ax7.text(0.34, 0.48,
             f"ζH/ρ       = {zeta_cur:.18f}",
             fontsize=8.5, family="monospace", color="#ff7f0e",
