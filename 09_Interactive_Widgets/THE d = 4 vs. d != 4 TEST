def partition_count(d):
    """Exact partition function p(d) for small d."""
    p_values = {
        1: 1, 2: 2, 3: 3, 4: 5, 5: 7, 6: 11,
        7: 15, 8: 22, 9: 30, 10: 42,
    }
    return p_values.get(d, None)

