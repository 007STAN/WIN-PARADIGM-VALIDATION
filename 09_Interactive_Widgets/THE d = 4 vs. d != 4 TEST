# ============================================================
# ANCHOR 2: kL FORMULA
# ============================================================
# kL = N*(d-1)/(d+1) + sin^2(theta_W) / (5.6 - d/(d+1)^2)
# where N = d * 2^d

def framework_constants(d):
    """N, H, V for a given d."""
    return {
        "N": d * 2**d,
        "H": 2**d,
        "V": (d - 1) * 2**d,
    }

def five_six(d):
    """5.6 = (N - 2d)/(2(d+1))."""
    N = d * 2**d
    return (N - 2*d) / (2 * (d + 1))

def five_four_four(d):
    """5.44 = 5.6 - d/(d+1)^2."""
    return five_six(d) - d / (d + 1)**2

def kL_formula(d, sin2):
    """kL formula for a given d."""
    N = d * 2**d
    return N * (d - 1) / (d + 1) + sin2 / five_four_four(d)

