        horizontal_spacing=0.10,
    )

    # --- Panel 1: p(d) vs d + 1 ---
    d_vals = [2, 3, 4, 5, 6, 7, 8]
    p_vals = [partition_count(dd) for dd in d_vals]
    d_plus_1 = [dd + 1 for dd in d_vals]

    fig.add_trace(go.Scatter(
        x=d_vals, y=p_vals,
        mode="lines+markers",
        line=dict(color="#4C72B0", width=2.5),
        marker=dict(size=12, color="#4C72B0"),
        name="p(d)",
        hovertemplate="d=%{x}<br>p(d)=%{y}<extra></extra>",
    ), row=1, col=1)
    fig.add_trace(go.Scatter(
        x=d_vals, y=d_plus_1,
        mode="lines+markers",
        line=dict(color="#DD8452", width=2.5, dash="dash"),
        marker=dict(size=12, color="#DD8452"),
        name="d + 1",
        hovertemplate="d=%{x}<br>d+1=%{y}<extra></extra>",
    ), row=1, col=1)
    # Highlight d = 4
    fig.add_trace(go.Scatter(
        x=[4], y=[5],
        mode="markers",
        marker=dict(size=20, color="#C44E52",
                    symbol="star",
                    line=dict(width=2, color="black")),
        name="d = 4",
        hovertemplate="d=4<br>p(4)=5<br>Match<extra></extra>",
    ), row=1, col=1)

    fig.update_xaxes(title_text="d", row=1, col=1,
                     tickvals=d_vals)
    fig.update_yaxes(title_text="p(d), d+1", row=1, col=1)

    # --- Panel 2: kL(d) vs d ---
    d_vals_2 = list(kL_values.keys())
    kL_vals = [kL_values[dd] for dd in d_vals_2]

    fig.add_trace(go.Bar(
        x=d_vals_2, y=kL_vals,
        marker=dict(color=["#4C72B0" if dd != 4 else "#C44E52"
                           for dd in d_vals_2]),
        text=[f"{kv:.2f}" for kv in kL_vals],
        textposition="outside",
        showlegend=False,
        hovertemplate="d=%{x}<br>kL=%{y:.4f}<extra></extra>",
    ), row=1, col=2)

    fig.add_hline(
        y=kL_observed,
        line=dict(color="#2E8B57", dash="dash", width=1.5),
        annotation_text=f"observed = {kL_observed:.3f}",
        annotation_position="top right",
        row=1, col=2,
    )

    fig.update_xaxes(title_text="d", row=1, col=2,
                     tickvals=d_vals_2)
    fig.update_yaxes(title_text="kL", row=1, col=2)

    # --- Panel 3: combined ---
    both_agree = []
    for dd in d_vals_2:
        p_dd = partition_count(dd)
        a1 = (p_dd == dd + 1)
        a2 = abs(kL_values[dd] - kL_observed) / kL_observed < 1e-4
        both_agree.append(1 if (a1 and a2) else 0)

    fig.add_trace(go.Bar(
        x=d_vals_2, y=both_agree,
        marker=dict(color=["#C44E52" if b else "#CCCCCC"
                           for b in both_agree]),
        text=["YES" if b else "no" for b in both_agree],
        textposition="outside",
        showlegend=False,
        hovertemplate="d=%{x}<br>both anchors agree=%{y}<extra></extra>",
    ), row=1, col=3)

    fig.update_xaxes(title_text="d", row=1, col=3,
                     tickvals=d_vals_2)
    fig.update_yaxes(title_text="both anchors agree",
                     range=[0, 1.3],
                     tickvals=[0, 1],
                     ticktext=["no", "yes"],
                     row=1, col=3)

    fig.update_layout(
        title=dict(
            text="<b>Widget 12 -- The d = 4 vs. d != 4 Test</b><br>"
                 "<sub>Two independent anchors select d = 4: the "
                 "combinatorial anchor p(4) = 5 and the kL anchor "
                 "kL(4) = 38.44.</sub>",
            x=0.5, xanchor="center",
        ),
        height=520,
        margin=dict(l=60, r=40, t=110, b=60),
        plot_bgcolor="white",
        showlegend=False,
    )
    return fig

fig = build_figure()
