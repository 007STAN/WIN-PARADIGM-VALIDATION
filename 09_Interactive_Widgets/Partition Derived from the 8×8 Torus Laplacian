import numpy as np
import ipywidgets as widgets
from IPython.display import display, HTML
import plotly.graph_objects as go
from plotly.subplots import make_subplots
import plotly.io as pio
pio.renderers.default = "colab"
from collections import defaultdict

L = 8

def lam(n1, n2, L=8):
    return 4.0 - 2.0 * np.cos(2 * np.pi * n1 / L) \
               - 2.0 * np.cos(2 * np.pi * n2 / L)

# ============================================================
# STEP 1 — Full spectrum
# ============================================================

modes = [dict(n1=n1, n2=n2, lam=lam(n1, n2))
         for n1 in range(L) for n2 in range(L)]
for m in modes:
    m["lam_round"] = round(m["lam"], 6)

groups = defaultdict(list)
for m in modes:
    groups[m["lam_round"]].append(m)
spectrum = [dict(lam=k, deg=len(v)) for k, v in sorted(groups.items())]

print("=" * 74)
print("Step 1 — Full 5-point Laplacian spectrum on the 8x8 torus")
print("=" * 74)
print(f"{'lambda':>10} {'degeneracy':>12}")
for s in spectrum:
    print(f"{s['lam']:>10.4f} {s['deg']:>12}")
print(f"{'TOTAL':>10} {sum(s['deg'] for s in spectrum):>12}")

# ============================================================
# STEP 2 — The 14 modes at lambda = 4
# ============================================================

multiplet = sorted([m for m in modes if abs(m["lam"] - 4.0) < 1e-6],
                   key=lambda m: (m["n1"], m["n2"]))

print()
print("=" * 74)
print(f"Step 2 — The {len(multiplet)} modes at lambda = 4")
print("=" * 74)
print(f"{'idx':>4} {'(n1,n2)':>10} {'cos1':>10} {'cos2':>10} {'sum':>8}")
print("-" * 74)
for i, m in enumerate(multiplet):
    c1 = np.cos(np.pi * m["n1"] / 4)
    c2 = np.cos(np.pi * m["n2"] / 4)
    print(f"{i:>4} {'('+str(m['n1'])+','+str(m['n2'])+')':>10} "
          f"{c1:>10.4f} {c2:>10.4f} {c1+c2:>8.4f}")

# ============================================================
# STEP 3 — Chiral 7 + 7 split
# ============================================================

left, right = [], []
for m in multiplet:
    c1 = np.cos(np.pi * m["n1"] / 4)
    c2 = np.cos(np.pi * m["n2"] / 4)
    s = c1 - c2
    if s > 1e-6:
        left.append(m)
    elif s < -1e-6:
        right.append(m)
    else:
        if (m["n1"] - m["n2"]) % 8 < 4:
            left.append(m)
        else:
            right.append(m)

print()
print("=" * 74)
print(f"Step 3 — Chiral split: left = {len(left)}, right = {len(right)}")
print("=" * 74)
print(f"Left:  {[(m['n1'], m['n2']) for m in left]}")
print(f"Right: {[(m['n1'], m['n2']) for m in right]}")

# ============================================================
# STEP 4 — The number 3 from distinct |cos| values
# ============================================================

abs_cos = set()
for m in multiplet:
    a = round(abs(np.cos(np.pi * m["n1"] / 4)), 6)
    b = round(abs(np.cos(np.pi * m["n2"] / 4)), 6)
    abs_cos.add(a)
    abs_cos.add(b)

print()
print("=" * 74)
print("Step 4 — Distinct |cos| values in the 14-mode multiplet")
print("=" * 74)
print(f"  |cos| values: {sorted(abs_cos)}")
print(f"  Count = {len(abs_cos)}")
print()
print("The equation lambda = 4 requires cos(a) + cos(b) = 0,")
print("which forces |cos(a)| = |cos(b)|. So the 14 modes are")
print("classified by which |cos| value they share — and there are")
print(f"exactly {len(abs_cos)} such values on Z_8.")
print(f"  3 = number of distinct |cos| values = generations.")

# ============================================================
# STEP 5 — D4 orbit structure
# ============================================================

def orbit_key(m):
    a = round(abs(np.cos(np.pi * m["n1"] / 4)), 6)
    b = round(abs(np.cos(np.pi * m["n2"] / 4)), 6)
    return tuple(sorted([a, b]))

orbits = defaultdict(list)
for m in multiplet:
    orbits[orbit_key(m)].append(m)

print()
print("=" * 74)
print("Step 5 — D4 orbit structure of the 14 modes")
print("=" * 74)
for key in sorted(orbits.keys()):
    ms = orbits[key]
    print(f"  |cos| pair = {key}:  {len(ms)} modes -> "
          f"{[(m['n1'], m['n2']) for m in ms]}")
print(f"  Total: {sum(len(v) for v in orbits.values())}")

# ============================================================
# FIGURE
# ============================================================

def build_figure():
    fig = make_subplots(
        rows=1, cols=3,
        column_widths=[0.33, 0.34, 0.33],
        subplot_titles=(
            "Full spectrum (14 at lambda = 4)",
            "14 modes at lambda = 4 on the torus",
            "Chiral split: 7 left, 7 right",
        ),
        specs=[[{"type": "xy"}, {"type": "xy"}, {"type": "xy"}]],
        horizontal_spacing=0.09,
    )
    xs = [s["lam"] for s in spectrum]
    ys = [s["deg"] for s in spectrum]
    colors = ["#C44E52" if abs(s["lam"] - 4.0) < 1e-6
              else "#4C72B0" for s in spectrum]
    fig.add_trace(go.Bar(
        x=xs, y=ys,
        marker=dict(color=colors, line=dict(width=0)),
        text=[f"lambda={s['lam']:.4f}<br>deg={s['deg']}"
              for s in spectrum],
        hoverinfo="text", showlegend=False,
    ), row=1, col=1)
    fig.update_xaxes(title_text="lambda", row=1, col=1,
                     showgrid=True, gridcolor="#EEE")
    fig.update_yaxes(title_text="degeneracy", row=1, col=1,
                     showgrid=True, gridcolor="#EEE")

    fig.add_trace(go.Scatter(
        x=[m["n1"] for m in multiplet],
        y=[m["n2"] for m in multiplet],
        mode="markers+text",
        text=[f"({m['n1']},{m['n2']})" for m in multiplet],
        textposition="top center",
        textfont=dict(size=9),
        marker=dict(size=16, color="#C44E52",
                    line=dict(width=1, color="black")),
        hoverinfo="text", showlegend=False,
    ), row=1, col=2)
    fig.update_xaxes(title_text="n1", range=[-1, 8],
                     tickvals=list(range(8)), row=1, col=2)
    fig.update_yaxes(title_text="n2", range=[-1, 8],
                     tickvals=list(range(8)),
                     scaleanchor="x", scaleratio=1, row=1, col=2)

    fig.add_trace(go.Scatter(
        x=[m["n1"] for m in left], y=[m["n2"] for m in left],
        mode="markers", name=f"Left ({len(left)})",
        marker=dict(size=18, color="#2E8B57",
                    line=dict(width=1, color="black")),
        hovertemplate="LEFT (%{x},%{y})<extra></extra>",
    ), row=1, col=3)
    fig.add_trace(go.Scatter(
        x=[m["n1"] for m in right], y=[m["n2"] for m in right],
        mode="markers", name=f"Right ({len(right)})",
        marker=dict(size=18, color="#C44E52", symbol="square",
                    line=dict(width=1, color="black")),
        hovertemplate="RIGHT (%{x},%{y})<extra></extra>",
    ), row=1, col=3)
    fig.update_xaxes(title_text="n1", range=[-1, 8],
                     tickvals=list(range(8)), row=1, col=3)
    fig.update_yaxes(title_text="n2", range=[-1, 8],
                     tickvals=list(range(8)),
                     scaleanchor="x", scaleratio=1, row=1, col=3)

    fig.update_layout(
        title=dict(
            text="<b>14 / 7 / 7 / 3 derived from the 8x8 torus "
                 "Laplacian</b><br>"
                 "<sub>No fitted parameters. The numbers come from "
                 "the cosine arithmetic on Z_8.</sub>",
            x=0.5, xanchor="center",
        ),
        height=520,
        margin=dict(l=60, r=40, t=100, b=60),
        plot_bgcolor="white",
        legend=dict(orientation="h", yanchor="bottom", y=-0.18,
                    xanchor="center", x=0.5),
    )
    return fig

fig = build_figure()
fig.show()

