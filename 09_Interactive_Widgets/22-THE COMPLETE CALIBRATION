# ---------- Build a FigureWidget once ----------
def build_figure_widget():
    fig = make_subplots(
        rows=2, cols=2,
        column_widths=[0.55, 0.45],
        row_heights=[0.55, 0.45],
        subplot_titles=(
            "Eight sectors: empirical input count",
            "Total empirical inputs: WIN vs SM",
            "Processor summary",
            "Boundary",
        ),
        specs=[[{"type": "xy"}, {"type": "xy"}],
               [{"type": "xy"}, {"type": "xy"}]],
        horizontal_spacing=0.14,
        vertical_spacing=0.18,
    )

    labels = [s["label"] for s in SECTORS]
    inputs = [s["input_count"] for s in SECTORS]
    colors = ["#2E8B57" if s["derived"] else "#8E44AD" for s in SECTORS]

    # Bar chart 1: sectors
    fig.add_trace(go.Bar(
        y=labels, x=inputs, orientation="h",
        marker=dict(color=colors, line=dict(width=1, color="#333")),
        text=[str(i) for i in inputs], textposition="outside",
        hoverinfo="skip", showlegend=False,
    ), row=1, col=1)

    # Bar chart 2: comparison
    fig.add_trace(go.Bar(
        x=["Standard Model", "WIN Paradigm"],
        y=[26, total_inputs],
        marker=dict(color=["#888888", "#2E8B57"],
                    line=dict(width=1, color="#333")),
        text=[str(26), str(total_inputs)], textposition="outside",
        hoverinfo="skip", showlegend=False,
    ), row=1, col=2)

    # Text annotations on bottom-left (processor summary)
    summary_lines = [
        ("HARDWARE", "8x8 torus", "derived", "#2E8B57"),
        ("STATE", "14 modes", "derived", "#2E8B57"),
        ("CLOCK", "Wick rotation", "characterized", "#DAA520"),
        ("FUNCTION", "m_f(r)", "derived", "#2E8B57"),
        ("DATABASE", "4 refs + 9 perts", "stored", "#8E44AD"),
        ("READOUT", "N/4 = f(m_f)", "derived", "#2E8B57"),
    ]
    y_positions = np.linspace(0.9, 0.1, len(summary_lines))
    for (comp, desc, status, color), y in zip(summary_lines, y_positions):
        fig.add_annotation(
            x=0.02, y=y, xref="x3 domain", yref="y3 domain",
            text=f"<b>{comp}</b>", showarrow=False, align="left",
            font=dict(size=13, color=color))
        fig.add_annotation(
            x=0.35, y=y, xref="x3 domain", yref="y3 domain",
            text=desc, showarrow=False, align="left",
            font=dict(size=12, color="#333"))
        fig.add_annotation(
            x=0.98, y=y, xref="x3 domain", yref="y3 domain",
            text=status, showarrow=False, align="right",
            font=dict(size=11, color=color))

    # Boundary text
    boundary_text = (
        "<b>DERIVED (7 of 8 sectors)</b><br>"
        "  8x8 torus, 14-mode multiplet<br>"
        "  Gauge group SO(10)<br>"
        "  Generation count 3<br>"
        "  Mirror symmetry, 7/32 residual<br>"
        "  kL, Higgs mass, Weinberg angle<br>"
        "  Kinetic mixing epsilon<br>"
        "  Four references at kL/2^n<br>"
        "  Processing function m_f(r)<br>"
        "<br>"
        "<b>STORED (particle spectrum)</b><br>"
        "  9 perturbation values<br>"
        "  13 shape parameters<br>"
        "  22 total empirical inputs<br>"
        "  vs SM's 26 parameters"
    )
    fig.add_annotation(
        x=0.05, y=0.95, xref="x4 domain", yref="y4 domain",
        text=boundary_text, showarrow=False, align="left",
        font=dict(size=11, color="#333"),
        bgcolor="white", bordercolor="#888", borderwidth=1)

    fig.update_xaxes(title_text="empirical inputs", row=1, col=1)
    fig.update_yaxes(showgrid=False, row=1, col=1)
    fig.update_xaxes(showgrid=False, row=1, col=2)
    fig.update_yaxes(title_text="parameter count", range=[0, 32],
                     row=1, col=2)
    fig.update_xaxes(visible=False, row=2, col=1)
    fig.update_yaxes(visible=False, row=2, col=1)
    fig.update_xaxes(visible=False, row=2, col=2)
    fig.update_yaxes(visible=False, row=2, col=2)

    fig.update_layout(
        title=dict(
            text="<b>The Complete Calibration</b><br>"
                 "<sub>Seven of eight sectors fully derived. "
                 "Particle spectrum: 4 references + 9 stored "
                 "perturbations. Total empirical input: 22 numbers.</sub>",
            x=0.5, xanchor="center"),
        height=800,
        margin=dict(l=60, r=40, t=100, b=60),
        plot_bgcolor="white",
        showlegend=False,
        hovermode="closest",
        bargap=0.15,
    )
    return fig

fig_widget = go.FigureWidget(build_figure_widget())

# ---------- Dropdown with in-place color update ----------
dropdown = widgets.Dropdown(
    options=[("-- none --", None)] +
            [(s["label"], s["id"]) for s in SECTORS],
    description="Highlight:",
    layout=widgets.Layout(width="340px"),
)

def update_highlight(change):
    hid = change["new"]
    new_colors = []
    for s in SECTORS:
        if hid is not None and s["id"] == hid:
            new_colors.append("#DD8452")
        elif s["derived"]:
            new_colors.append("#2E8B57")
        else:
            new_colors.append("#8E44AD")
    # In-place update of the first bar trace
    fig_widget.data[0].marker.color = tuple(new_colors)

dropdown.observe(update_highlight, names="value")

