def min_cost_for_base(base, n_max=4):
    costs = []
    for n in range(n_max):
        target = kL / (base**n)
        if target <= 0:
            costs.append(None)
            continue
        best = 1e9
        for name, ratio, mass, charge, ptype in particles:
            m = m_f(ratio)
            cost = abs(m - target) / target
            if cost < best:
                best = cost
        costs.append(best * 100)
    return costs

bases_to_test = {
    "2": 2.0, "4/3": 4/3, "3/2": 1.5, "1.4": 1.4,
    "1.1": 1.1, "sqrt(2)": np.sqrt(2), "1.6": 1.6,
    "5/4": 1.25, "phi": (1+np.sqrt(5))/2, "1.2": 1.2,
}

results = []
for name, base in bases_to_test.items():
    costs = min_cost_for_base(base, 4)
    costs = [c for c in costs if c is not None]
    if costs:
        mean_c = np.mean(costs)
        results.append((mean_c, name, base, costs))

results.sort()
print(f"{'rank':>5} {'base':>10} {'mean cost %':>14} {'costs (n=0..3)':>32}")
print("-" * 84)
