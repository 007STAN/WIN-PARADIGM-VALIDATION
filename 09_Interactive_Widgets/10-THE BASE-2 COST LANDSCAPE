def build_figure():
    fig = make_subplots(
        rows=1, cols=2,
        column_widths=[0.52, 0.48],
        subplot_titles=(
            "Transition cost for all 13 framework modes",
            "Cost vs mass",
        ),
        specs=[[{"type": "xy"}, {"type": "xy"}]],
        horizontal_spacing=0.12,
    )

    # Left panel: cost by particle
    names_sorted = [row[0] for row in cost_landscape_sorted]
    costs_sorted = [row[5] for row in cost_landscape_sorted]
    colors_sorted = [
        "#C44E52" if row[0] in ["Z", "c", "d", "e"] else "#4C72B0"
        for row in cost_landscape_sorted
    ]

    fig.add_trace(go.Bar(
        x=names_sorted,
        y=costs_sorted,
        marker=dict(color=colors_sorted),
        text=[f"{c:.2f}%" for c in costs_sorted],
        textposition="outside",
        showlegend=False,
        hovertemplate="<b>%{x}</b><br>cost = %{y:.4f}%<extra></extra>",
    ), row=1, col=1)

    fig.update_xaxes(title_text="particle", tickangle=-45, row=1, col=1)
    fig.update_yaxes(title_text="transition cost (%)", row=1, col=1)

    # Right panel: cost vs mass
    masses = [row[6] if row[6] > 0 else 1e-9 for row in cost_landscape]
    costs_vs_mass = [row[5] for row in cost_landscape]
    names_vs_mass = [row[0] for row in cost_landscape]
    colors_vs_mass = [
        "#C44E52" if row[0] in ["Z", "c", "d", "e"] else "#4C72B0"
        for row in cost_landscape
    ]

    fig.add_trace(go.Scatter(
        x=masses,
        y=costs_vs_mass,
        mode="markers+text",
        text=names_vs_mass,
        textposition="top center",
        marker=dict(size=14, color=colors_vs_mass,
                    line=dict(width=1, color="black")),
        showlegend=False,
        hovertemplate="<b>%{text}</b><br>mass = %{x:.4g} GeV<br>"
                      "cost = %{y:.4f}%<extra></extra>",
    ), row=1, col=2)

    fig.update_xaxes(title_text="mass (GeV, log scale)", type="log", row=1, col=2)
    fig.update_yaxes(title_text="transition cost (%)", row=1, col=2)

    fig.update_layout(
        title=dict(
            text="<b>Widget 10 — The Base-2 Cost Landscape</b><br>"
                 "<sub>Five particles have transition cost under 5% to a "
                 "kL/2^n target. The other eight have costs 7.6% to 28.6%.</sub>",
            x=0.5, xanchor="center",
        ),
        height=560,
        margin=dict(l=70, r=40, t=100, b=80),
        plot_bgcolor="white",
    )
    return fig

fig = build_figure()
fig.show()

