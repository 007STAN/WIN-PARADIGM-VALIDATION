def nearest_kL_target(m, n_range=range(-10, 11)):
    best_n = None
    best_target = None
    best_cost = 1e9
    for n in n_range:
        target = kL / (2**n)
        if target <= 0:
            continue
        cost = abs(m - target) / target * 100
        if cost < best_cost:
            best_cost = cost
            best_n = n
            best_target = target
    return best_n, best_target, best_cost

cost_landscape = []
