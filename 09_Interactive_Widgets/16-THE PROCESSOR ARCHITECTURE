# ============================================================
# BUILD THE PROCESSOR DIAGRAM
# ============================================================

def build_architecture_figure(highlight=None):
    fig = go.Figure()

    # Layout: hexagon of components around a central label
    # Center at (0, 0), components at radius 2.5
    angles = {
        "hardware": np.pi / 2,           # top
        "state": np.pi / 2 - 2*np.pi/6,  # upper right
        "clock": np.pi / 2 - 4*np.pi/6,  # lower right
        "function": np.pi / 2 - 6*np.pi/6,  # bottom
        "database": np.pi / 2 - 8*np.pi/6,  # lower left
        "readout": np.pi / 2 - 10*np.pi/6,  # upper left
    }
    positions = {k: (2.5*np.cos(a), 2.5*np.sin(a))
                 for k, a in angles.items()}

    # Draw the arrows between components (processor pipeline)
    pipeline = ["hardware", "state", "clock", "function",
                "database", "readout", "hardware"]
    for i in range(len(pipeline) - 1):
        x0, y0 = positions[pipeline[i]]
        x1, y1 = positions[pipeline[i+1]]
        fig.add_trace(go.Scatter(
            x=[x0, x1], y=[y0, y1],
            mode="lines",
            line=dict(color="#BBBBBB", width=2),
            hoverinfo="none", showlegend=False,
        ))

    # Draw each component as a node
    for comp in COMPONENTS:
        x, y = positions[comp["id"]]
        is_highlight = (highlight == comp["id"])
        size = 60 if is_highlight else 45
        border = 4 if is_highlight else 2
        fig.add_trace(go.Scatter(
            x=[x], y=[y],
            mode="markers+text",
            marker=dict(
                size=size,
                color=STATUS_COLOR[comp["status"]],
                line=dict(width=border, color="black"),
            ),
            text=[comp["label"]],
            textposition="middle center",
            textfont=dict(size=10, color="white"),
            hovertext=(
                f"<b>{comp['label']}</b><br>"
                f"<i>{comp['subtitle']}</i><br><br>"
                f"<b>Status:</b> {STATUS_LABEL[comp['status']]}<br><br>"
                f"<b>Role:</b> {comp['role']}<br><br>"
                f"<b>How:</b> {comp['how']}"
            ),
            hoverinfo="text",
            showlegend=False,
        ))

    # Add the center label
    fig.add_trace(go.Scatter(
        x=[0], y=[0],
        mode="markers+text",
        marker=dict(size=10, color="white"),
        text=["<b>WIN</b><br>PROCESSOR"],
        textposition="middle center",
        textfont=dict(size=14, color="#222"),
        hoverinfo="skip",
        showlegend=False,
    ))

    # Add the output arrow pointing up
    fig.add_annotation(
        x=0, y=1.7, text="<b>OUTPUT</b><br>SM particle spectrum",
        showarrow=False, font=dict(size=11, color="#555"),
    )

    # Legend
    for status in ["derived", "characterized", "partially-stored"]:
        fig.add_trace(go.Scatter(
            x=[None], y=[None], mode="markers",
            marker=dict(size=14, color=STATUS_COLOR[status],
                        line=dict(width=1, color="black")),
            name=STATUS_LABEL[status], showlegend=True,
        ))

    fig.update_layout(
        title=dict(
            text="<b>The WIN Vacuum as a Calibration-Based Processor</b><br>"
                 "<sub>Hover any component for details. "
                 "Click a component name below to see its full derivation.</sub>",
            x=0.5, xanchor="center",
        ),
        showlegend=True,
        legend=dict(orientation="h", yanchor="bottom", y=-0.08,
                    xanchor="center", x=0.5),
        hovermode="closest",
        margin=dict(l=20, r=20, t=90, b=60),
        xaxis=dict(range=[-4, 4], showgrid=False, zeroline=False,
                   showticklabels=False),
        yaxis=dict(range=[-4, 4], showgrid=False, zeroline=False,
                   showticklabels=False, scaleanchor="x", scaleratio=1),
        plot_bgcolor="white",
        height=720,
        dragmode="pan",
    )
    return fig

