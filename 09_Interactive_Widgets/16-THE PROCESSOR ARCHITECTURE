fig_widget = go.FigureWidget(build_architecture_figure(highlight=None))

def on_change(change):
    if change["name"] != "value":
        return
    comp_id = change["new"]
    show_component(comp_id)
    # Rebuild figure with highlight
    new_fig = build_architecture_figure(highlight=comp_id)
    fig_widget.data = []
    for tr in new_fig.data:
        fig_widget.add_trace(tr)
    fig_widget.layout = new_fig.layout

selected.observe(on_change)

