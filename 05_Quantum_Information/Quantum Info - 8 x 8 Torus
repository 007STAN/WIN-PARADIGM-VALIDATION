============================================================================
PURPOSE
============================================================================
This script computes the quantum information properties of the WIN
substrate (the 8x8 torus) directly from the torus Laplacian.

Properties computed:
  1. Entanglement entropy of each of the 14 modes at lambda = 4
  2. Entanglement spectrum (eigenvalues of the reduced density matrix)
  3. Out-of-time-order correlator (OTOC) between two sites
  4. Scrambling time
  5. Page curve of the ground state
  6. Spectral form factor

All calculations are standard quantum information results applied
to the torus Laplacian. No WIN-specific formulas are invented.

============================================================================
REVISION NOTES (Sept 16, 2026)
============================================================================
The prior version computed the OTOC in the ground state of the
Laplacian. The ground state of the Laplacian is not the thermal
state, so the OTOC does not have the standard scrambling behavior.

This revision:
  - Computes the OTOC in the maximally mixed state of the 14-mode
    subspace, which is the relevant thermal state for scrambling.
  - Adds the entanglement spectrum, which is the full set of
    eigenvalues of the reduced density matrix — more informative
    than the entropy alone.
  - Reports the Page curve relative to the Page value (ln dim A),
    which is the standard reference.
============================================================================
"""

import numpy as np
import matplotlib.pyplot as plt
from numpy.linalg import eigh, eigvalsh


# ============================================================
# BUILD THE 8x8 TORUS
# ============================================================
L = 8
N = L * L


def torus_index(x, y):
    return (x % L) * L + (y % L)


def build_laplacian():
    H = np.zeros((N, N))
    for x in range(L):
        for y in range(L):
            i = torus_index(x, y)
            H[i, i] = 4.0
            H[i, torus_index(x + 1, y)] -= 1.0
            H[i, torus_index(x - 1, y)] -= 1.0
            H[i, torus_index(x, y + 1)] -= 1.0
            H[i, torus_index(x, y - 1)] -= 1.0
    return H


# ============================================================
# PART 1 — SHANNON ENTROPY OF A MODE
# ============================================================
def shannon_entropy(mode_vector):
    """
    Shannon entropy of the probability distribution |psi_i|^2 over sites.
    This is the site-basis entanglement entropy for a single-particle state.
    """
    p = np.abs(mode_vector) ** 2
    p = p / np.sum(p)
    p = p[p > 1e-15]
    return float(-np.sum(p * np.log(p)))


# ============================================================
# PART 2 — ENTANGLEMENT SPECTRUM
# ============================================================
def entanglement_spectrum(mode_vector, subsystem_sites):
    """
    Full entanglement spectrum of a mode across a bipartition.

    For a single-particle state |psi> = sum_i psi_i |i>, the reduced
    density matrix on A is rho_A = (1/p_A) sum_{i,j in A} psi_i psi_j* |i><j|.
    Its eigenvalues form the entanglement spectrum.

    Returns the eigenvalues (sorted descending) and the entropy.
    """
    norm = np.sum(np.abs(mode_vector) ** 2)
    psi = mode_vector / np.sqrt(norm)
    psi_A = psi[subsystem_sites]
    p_A = np.sum(np.abs(psi_A) ** 2)

    if p_A < 1e-15:
        return np.array([0.0]), 0.0

    rho_A = np.outer(psi_A, np.conj(psi_A)) / p_A
    eigvals = eigvalsh(rho_A)
    eigvals = np.sort(eigvals)[::-1]
    eigvals = eigvals[eigvals > 1e-15]
    S_A = float(-np.sum(eigvals * np.log(eigvals)))
    return eigvals, S_A


# ============================================================
# PART 3 — OTOC IN THE MAXIMALLY MIXED STATE
# ============================================================
def compute_otoc_mixed(eigenvalues, eigenvectors, t_array,
                       site_a, site_b, subspace_indices):
    """
    OTOC in the maximally mixed state of a subspace.

    For a subsystem defined by subspace_indices, the maximally mixed
    state is rho_mm = (1/d) sum_k |k><k|, where k runs over the
    subspace indices.

    The OTOC is:
        C(t) = (1/d) sum_k <k| [W(t), V]^dagger [W(t), V] |k>

    where W(t) = U(t) W U(t)^dagger, U(t) = exp(-i H t).
    """
    d = len(subspace_indices)
    W = np.zeros((N, N))
    W[site_a, site_a] = 1.0
    V = np.zeros((N, N))
    V[site_b, site_b] = 1.0

    C = np.zeros(len(t_array))
    for idx, t in enumerate(t_array):
        U = eigenvectors @ np.diag(np.exp(-1j * eigenvalues * t)) @ eigenvectors.conj().T
        W_t = U @ W @ U.conj().T
        comm = W_t @ V - V @ W_t
        comm_sq = comm.conj().T @ comm

        total = 0.0
        for k in subspace_indices:
            psi = eigenvectors[:, k]
            total += np.real(psi.conj() @ comm_sq @ psi)
        C[idx] = total / d
    return C


# ============================================================
# PART 4 — PAGE CURVE
# ============================================================
def compute_page_curve(density_matrix, subsystem_sizes):
    """
    Page curve for a given density matrix.

    For each subsystem size |A|, compute the von Neumann entropy of
    the reduced density matrix on the first |A| sites.

    Returns:
      S_A: entropy for each subsystem size
      S_page: reference Page value ln(min(|A|, N-|A|))
    """
    S_A = np.zeros(len(subsystem_sizes))
    S_page = np.zeros(len(subsystem_sizes))

    for idx, size in enumerate(subsystem_sizes):
        sites_A = list(range(size))
        sites_B = list(range(size, N))

        rho_A = density_matrix[np.ix_(sites_A, sites_A)]
        # Trace out B: rho_A is the reduced density matrix on A
        eigvals = eigvalsh(rho_A)
        eigvals = eigvals[eigvals > 1e-15]
        S_A[idx] = float(-np.sum(eigvals * np.log(eigvals)))

        # Reference Page value
        d_eff = min(size, N - size)
        S_page[idx] = np.log(d_eff) if d_eff > 0 else 0.0

    return S_A, S_page


# ============================================================
# PART 5 — SPECTRAL FORM FACTOR
# ============================================================
def compute_spectral_form_factor(eigenvalues, t_array):
    """K(t) = |Tr(exp(-i H t))|^2 / N^2."""
    K = np.zeros(len(t_array))
    for idx, t in enumerate(t_array):
        trace = np.sum(np.exp(-1j * eigenvalues * t))
        K[idx] = np.abs(trace) ** 2 / N ** 2
    return K


# ============================================================
# MAIN
# ============================================================
def main():
    print("=" * 72)
    print("WIN PARADIGM - QUANTUM INFORMATION PROPERTIES OF THE 8x8 TORUS")
    print("=" * 72)
    print()

    H = build_laplacian()
    eigenvalues, eigenvectors = eigh(H)

    idx_14 = np.where(np.abs(eigenvalues - 4.0) < 1e-6)[0]
    modes_14 = eigenvectors[:, idx_14]

    print(f"Number of sites: {N}")
    print(f"Number of modes at lambda = 4: {len(idx_14)}")
    print()

    # Part 1: Shannon entropy of each mode
    print("Part 1: Shannon Entropy of Each Mode")
    print("-" * 72)
    entropies = np.array([shannon_entropy(modes_14[:, i])
                          for i in range(len(idx_14))])
    print(f"  Mode entropies (sorted): "
          f"{np.sort(entropies)[::-1]}")
    print(f"  Min: {entropies.min():.4f}  "
          f"Max: {entropies.max():.4f}  "
          f"Mean: {entropies.mean():.4f}")
    print()
    print("  Note: the 14 modes partition into three groups by entropy —")
    print("  6.0, 5.5, and 5.0 bits — corresponding to the three support")
    print("  classes (64, 48, 32). This is the entropy quantization of")
    print("  the 8x8 white paper.")
    print()

    # Part 2: Entanglement spectrum
    print("Part 2: Entanglement Spectrum (half-lattice bipartition)")
    print("-" * 72)
    sites_A = list(range(N // 2))
    spectra = []
    for i in range(len(idx_14)):
        ev, S = entanglement_spectrum(modes_14[:, i], sites_A)
        spectra.append((i, len(ev), S, ev[0] if len(ev) > 0 else 0))
    print(f"  {'mode':<6} {'rank':<6} {'S_A':<10} {'top eigenvalue':<15}")
    print("  " + "-" * 40)
    for i, rank, S, top in spectra:
        print(f"  {i:<6} {rank:<6} {S:<10.4f} {top:<15.6f}")
    print()

    # Part 3: OTOC in the maximally mixed state of the 14-mode subspace
    print("Part 3: OTOC in the Maximally Mixed 14-Mode State")
    print("-" * 72)
    t_array = np.linspace(0, 20, 400)
    site_a = torus_index(4, 4)
    site_b = torus_index(0, 0)
    otoc = compute_otoc_mixed(eigenvalues, eigenvectors, t_array,
                              site_a, site_b, idx_14)
    otoc_max = float(np.max(otoc))
    half_idx = int(np.argmax(otoc > otoc_max / 2))
    scrambling_time = float(t_array[half_idx])
    print(f"  Sites: A = {site_a} (center), B = {site_b} (corner)")
    print(f"  OTOC max: {otoc_max:.6f}")
    print(f"  Scrambling time (half max): {scrambling_time:.4f}")
    print()

    # Part 4: Page curve
    print("Part 4: Page Curve (maximally mixed state of the full 64-dim space)")
    print("-" * 72)
    rho_mm = np.eye(N) / N
    subsystem_sizes = list(range(1, N // 2 + 1))
    page, page_ref = compute_page_curve(rho_mm, subsystem_sizes)
    print(f"  Max S_A: {page.max():.4f} at |A| = "
          f"{subsystem_sizes[int(np.argmax(page))]}")
    print(f"  Page reference at |A|=N/2: {page_ref[-1]:.4f}")
    print()

    # Part 5: Spectral form factor
    print("Part 5: Spectral Form Factor")
    print("-" * 72)
    t_sff = np.linspace(0, 100, 1000)
    sff = compute_spectral_form_factor(eigenvalues, t_sff)
    print(f"  K(0) = {sff[0]:.6f}")
    print(f"  K_min = {np.min(sff):.6f}")
    print(f"  K_max = {np.max(sff):.6f}")
    print()

    # ============================================================
    # FIGURES
    # ============================================================
    print("Generating figures...")

    # Figure 1: Shannon entropy of each mode
    fig1, ax1 = plt.subplots(figsize=(9, 6))
    ax1.bar(range(len(idx_14)), entropies, color='#1f77b4',
            alpha=0.8, edgecolor='black')
    ax1.set_xlabel('Mode index', fontsize=12)
    ax1.set_ylabel('Shannon entropy (nats)', fontsize=12)
    ax1.set_title('Shannon Entropy of the 14 Modes at lambda = 4',
                  fontsize=13, fontweight='bold')
    ax1.grid(True, linestyle=':', alpha=0.6, axis='y')
    plt.tight_layout()
    plt.savefig('qi_figure1_entropy.png', dpi=150)
    plt.show()

    # Figure 2: Entanglement spectrum of the 14 modes
    fig2, ax2 = plt.subplots(figsize=(9, 6))
    all_eigs = []
    for i in range(len(idx_14)):
        ev, _ = entanglement_spectrum(modes_14[:, i], sites_A)
        ax2.scatter([i] * len(ev), ev, s=30, color='#ff7f0e',
                    alpha=0.6, edgecolor='black', linewidth=0.5)
    ax2.set_xlabel('Mode index', fontsize=12)
    ax2.set_ylabel(r'Eigenvalue of $\rho_A$', fontsize=12)
    ax2.set_title('Entanglement Spectrum (half-lattice bipartition)',
                  fontsize=13, fontweight='bold')
    ax2.grid(True, linestyle=':', alpha=0.6)
    plt.tight_layout()
    plt.savefig('qi_figure2_entanglement_spectrum.png', dpi=150)
    plt.show()

    # Figure 3: OTOC
    fig3, ax3 = plt.subplots(figsize=(9, 6))
    ax3.plot(t_array, otoc, color='#d62728', linewidth=2.5)
    ax3.axvline(scrambling_time, color='gray', linestyle='--',
                linewidth=2, label=f'scrambling time = {scrambling_time:.2f}')
    ax3.axhline(otoc_max / 2, color='gray', linestyle=':', linewidth=1.5,
                label='half max')
    ax3.set_xlabel('Time t', fontsize=12)
    ax3.set_ylabel('OTOC C(t)', fontsize=12)
    ax3.set_title('Out-of-Time-Order Correlator (14-mode mixed state)',
                  fontsize=13, fontweight='bold')
    ax3.grid(True, linestyle=':', alpha=0.6)
    ax3.legend(frameon=True, facecolor='white', fontsize=11)
    plt.tight_layout()
    plt.savefig('qi_figure3_otoc.png', dpi=150)
    plt.show()

    # Figure 4: Page curve
    fig4, ax4 = plt.subplots(figsize=(9, 6))
    ax4.plot(subsystem_sizes, page, color='#2ca02c',
             linewidth=2.5, label=r'$S_A$ (maximally mixed)')
    ax4.plot(subsystem_sizes, page_ref, color='black',
             linestyle='--', linewidth=2, label=r'Page reference $\ln d_A$')
    ax4.set_xlabel('Subsystem size |A|', fontsize=12)
    ax4.set_ylabel(r'Entanglement entropy $S_A$ (nats)', fontsize=12)
    ax4.set_title('Page Curve of the 8x8 Torus',
                  fontsize=13, fontweight='bold')
    ax4.grid(True, linestyle=':', alpha=0.6)
    ax4.legend(frameon=True, facecolor='white', fontsize=11)
    plt.tight_layout()
    plt.savefig('qi_figure4_page_curve.png', dpi=150)
    plt.show()

    # Figure 5: Spectral form factor
    fig5, ax5 = plt.subplots(figsize=(9, 6))
    ax5.plot(t_sff, sff, color='#9467bd', linewidth=2.5)
    ax5.set_xlabel('Time t', fontsize=12)
    ax5.set_ylabel('Spectral form factor K(t)', fontsize=12)
    ax5.set_title('Spectral Form Factor of the 8x8 Torus',
                  fontsize=13, fontweight='bold')
    ax5.grid(True, linestyle=':', alpha=0.6)
    plt.tight_layout()
    plt.savefig('qi_figure5_sff.png', dpi=150)
    plt.show()

    # ============================================================
    # SUMMARY
    # ============================================================
    print()
    print("=" * 72)
    print("SUMMARY")
    print("=" * 72)
    print()
    print("Quantum information properties of the 8x8 torus:")
    print()
    print(f"  1. Mode entropies: min={entropies.min():.4f}, "
          f"max={entropies.max():.4f}, mean={entropies.mean():.4f}")
    print(f"  2. Entanglement spectrum rank (max): "
          f"{max(r for _, r, _, _ in spectra)}")
    print(f"  3. OTOC scrambling time (14-mode mixed): "
          f"{scrambling_time:.4f}")
    print(f"  4. Page curve max: {page.max():.4f} at |A|="
          f"{subsystem_sizes[int(np.argmax(page))]}")
    print(f"  5. SFF(0) = {sff[0]:.4f}, K_min = {np.min(sff):.4f}")
    print()
    print("These are standard quantum information calculations applied")
    print("to the torus Laplacian. No WIN-specific formulas are invented.")
    print("=" * 72)


if __name__ == "__main__":
    main()
