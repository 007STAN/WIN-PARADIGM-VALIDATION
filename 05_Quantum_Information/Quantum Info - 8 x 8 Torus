import numpy as np
import matplotlib.pyplot as plt
from numpy.linalg import eigh, eigvalsh

# ============================================================
# SUBSTRATE
# ============================================================
L = 8
N_sites = L * L

# Framework constants
d = 4
dim_Omega0 = 64
dim_Omega1 = 128
dim_Omega2 = 64
dim_Hodge = dim_Omega0 + dim_Omega1 + dim_Omega2   # 256

dim_lambda4 = 56                  # 9A₁ ⊕ 5A₂ ⊕ 7B₁ ⊕ 7B₂ ⊕ 14E
dim_visible = 14                  # Ω⁰|λ=4
dim_hidden = 42                   # Ω¹|λ=4 ⊕ Ω²|λ=4

# Hodge flat entropy at λ = 4 (Hodge flatness theorem, WIN v2 overview)
