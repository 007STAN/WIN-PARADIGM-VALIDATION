"""

import numpy as np
import matplotlib.pyplot as plt
from numpy.linalg import eigh, eigvalsh


# =============================================================================
# BUILD THE 8x8 TORUS
# =============================================================================
L = 8
N = L * L


def torus_index(x, y):
    return (x % L) * L + (y % L)


def build_laplacian():
    """Build the tight-binding Hamiltonian (Laplacian) on the torus."""
    H = np.zeros((N, N))
    for x in range(L):
        for y in range(L):
            i = torus_index(x, y)
            H[i, i] = 4.0
            H[i, torus_index(x + 1, y)] -= 1.0
            H[i, torus_index(x - 1, y)] -= 1.0
            H[i, torus_index(x, y + 1)] -= 1.0
            H[i, torus_index(x, y - 1)] -= 1.0
    return H


# =============================================================================
# PART 1 — ENTANGLEMENT ENTROPY OF EACH MODE
# =============================================================================
def entanglement_entropy(mode_vector, subsystem_size=None):
    """
    Compute the entanglement entropy of a mode between a subsystem A
    and its complement B.

    The mode is a vector in the 64-dimensional site basis.
    The reduced density matrix is obtained by tracing out B.

    For a single-particle state, the entanglement entropy is the
    Shannon entropy of the probability distribution over sites.
    """
    p = mode_vector ** 2
    p = p / np.sum(p)

    # Remove zero entries to avoid log(0)
    p = p[p > 1e-15]

    # Shannon entropy
    S = -np.sum(p * np.log(p))

    return S


def entanglement_entropy_bipartite(mode_vector, subsystem_sites):
    """
    Compute the bipartite entanglement entropy between subsystem A
    (given by subsystem_sites) and its complement B.

    For a single-particle state |ψ⟩ = Σ_i ψ_i |i⟩, the reduced
    density matrix on A is:
        ρ_A = (1/p_A) Σ_{i,j in A} ψ_i ψ_j* |i⟩⟨j|
    where p_A = Σ_{i in A} |ψ_i|².

    The entanglement entropy is:
        S_A = -Tr(ρ_A ln ρ_A)
    """
    # Normalize
    norm = np.sum(np.abs(mode_vector) ** 2)
    psi = mode_vector / np.sqrt(norm)

    # Project onto subsystem A
    psi_A = psi[subsystem_sites]
    p_A = np.sum(np.abs(psi_A) ** 2)

    if p_A < 1e-15:
        return 0.0

    # Reduced density matrix
    rho_A = np.outer(psi_A, np.conj(psi_A)) / p_A

    # Eigenvalues of rho_A
    eigvals = eigvalsh(rho_A)
    eigvals = eigvals[eigvals > 1e-15]

    # Entanglement entropy
    S_A = -np.sum(eigvals * np.log(eigvals))

    return S_A


# =============================================================================
# PART 2 — OUT-OF-TIME-ORDER CORRELATOR (OTOC)
# =============================================================================
def compute_otoc(eigenvalues, eigenvectors, t_array, site_a, site_b):
    """
    Compute the OTOC:
        C(t) = ⟨[W(t), V(0)]²⟩

    where W and V are local operators at sites a and b.

    For a single-particle system:
        W(t) = exp(iHt) W exp(-iHt)
        V(0) = V

    The OTOC is computed in the ground state of the system.
    """
    # Ground state
    ground_state = eigenvectors[:, 0]

    # Local operators (projectors onto sites a and b)
    W = np.zeros((N, N))
    W[site_a, site_a] = 1.0
    V = np.zeros((N, N))
    V[site_b, site_b] = 1.0

    # Time evolution
    C = np.zeros(len(t_array))
    for idx, t in enumerate(t_array):
        U = eigenvectors @ np.diag(np.exp(-1j * eigenvalues * t)) @ eigenvectors.conj().T
        U_dag = U.conj().T

        # W(t) = U W U†
        W_t = U @ W @ U_dag

        # Commutator [W(t), V]
        commutator = W_t @ V - V @ W_t

        # OTOC = ⟨ψ| [W(t), V]† [W(t), V] |ψ⟩
        C[idx] = np.real(ground_state.conj() @ commutator.conj().T @ commutator @ ground_state)

    return C


# =============================================================================
# PART 3 — PAGE CURVE OF THE 14-MODE SUBSPACE
# =============================================================================
def compute_page_curve(ground_state, subsystem_sizes):
    """
    Compute the Page curve for the ground state of the 14-mode subspace.

    The Page curve is the entanglement entropy S_A as a function of
    subsystem size |A|.

    For a random state in a d-dimensional Hilbert space, the Page curve is:
        S_A = ln(|A|) - |A|/(2d) + ...

    For the torus, we compute it numerically.
    """
    S_A = np.zeros(len(subsystem_sizes))
    for idx, size in enumerate(subsystem_sizes):
        # Choose the first `size` sites as subsystem A
        sites_A = list(range(size))
        S_A[idx] = entanglement_entropy_bipartite(ground_state, sites_A)

    return S_A


# =============================================================================
# PART 4 — SPECTRAL FORM FACTOR
# =============================================================================
def compute_spectral_form_factor(eigenvalues, t_array):
    """
    Compute the spectral form factor:
        K(t) = |Tr(exp(-iHt))|² / N²

    This measures the level statistics of the spectrum.
    """
    K = np.zeros(len(t_array))
    for idx, t in enumerate(t_array):
        trace = np.sum(np.exp(-1j * eigenvalues * t))
        K[idx] = np.abs(trace) ** 2 / N ** 2
    return K


# =============================================================================
# MAIN
# =============================================================================
def main():
    print("=" * 70)
    print("WIN PARADIGM — QUANTUM INFORMATION PROPERTIES OF THE 8×8 TORUS")
    print("=" * 70)
    print()

    # -------------------------------------------------------------------------
    # Build the substrate
    # -------------------------------------------------------------------------
    H = build_laplacian()
    eigenvalues, eigenvectors = eigh(H)

    # The 14 modes at λ = 4
    idx_14 = np.where(np.abs(eigenvalues - 4.0) < 1e-6)[0]
    modes_14 = eigenvectors[:, idx_14]

    print(f"Number of sites: {N}")
    print(f"Number of modes at λ = 4: {len(idx_14)}")
    print()

    # -------------------------------------------------------------------------
    # Part 1 — Entanglement entropy of each mode
    # -------------------------------------------------------------------------
    print("Part 1: Entanglement Entropy of Each Mode")
    print("-" * 70)

    entropies = []
    for i in range(14):
        S = entanglement_entropy(modes_14[:, i])
        entropies.append(S)

    entropies = np.array(entropies)
    entropies_sorted = np.sort(entropies)[::-1]

    print(f"  {'Mode':<8} {'Entropy':<12}")
    print("  " + "-" * 20)
    for i, S in enumerate(entropies_sorted):
        print(f"  {i:<8} {S:<12.6f}")
    print()

    # -------------------------------------------------------------------------
    # Part 2 — OTOC
    # -------------------------------------------------------------------------
    print("Part 2: Out-of-Time-Order Correlator (OTOC)")
    print("-" * 70)

    t_array = np.linspace(0, 10, 200)
    # Choose two sites: one near the center (4,4) and one at the edge (0,0)
    site_a = torus_index(4, 4)
    site_b = torus_index(0, 0)

    otoc = compute_otoc(eigenvalues, eigenvectors, t_array, site_a, site_b)

    # Find the scrambling time (when OTOC reaches half its max)
    otoc_max = np.max(otoc)
    half_max_idx = np.argmax(otoc > otoc_max / 2)
    scrambling_time = t_array[half_max_idx]

    print(f"  OTOC computed from site {site_a} to site {site_b}")
    print(f"  OTOC max: {otoc_max:.6f}")
    print(f"  Scrambling time (half max): {scrambling_time:.4f}")
    print()

    # -------------------------------------------------------------------------
    # Part 3 — Page curve
    # -------------------------------------------------------------------------
    print("Part 3: Page Curve of the 14-Mode Subspace")
    print("-" * 70)

    subsystem_sizes = list(range(1, N // 2 + 1))
    # Use the ground state of the torus (eigenvector 0)
    ground_state = eigenvectors[:, 0]

    page_curve = compute_page_curve(ground_state, subsystem_sizes)

    print(f"  Subsystem sizes: 1 to {N // 2}")
    print(f"  Max entropy: {np.max(page_curve):.6f}")
    print(f"  At subsystem size: {subsystem_sizes[np.argmax(page_curve)]}")
    print()

    # -------------------------------------------------------------------------
    # Part 4 — Spectral form factor
    # -------------------------------------------------------------------------
    print("Part 4: Spectral Form Factor")
    print("-" * 70)

    t_sff = np.linspace(0, 50, 500)
    sff = compute_spectral_form_factor(eigenvalues, t_sff)

    print(f"  SFF at t=0: {sff[0]:.6f}")
    print(f"  SFF min: {np.min(sff):.6f}")
    print(f"  SFF max: {np.max(sff):.6f}")
    print()

    # -------------------------------------------------------------------------
    # Figures
    # -------------------------------------------------------------------------
    print("Generating figures...")
    print()

    # Figure 1 — Entanglement entropy of each mode
    fig1, ax1 = plt.subplots(figsize=(9, 6))
    ax1.bar(range(14), entropies, color='#1f77b4', alpha=0.8, edgecolor='black')
    ax1.set_xlabel('Mode index', fontsize=12)
    ax1.set_ylabel('Entanglement entropy', fontsize=12)
    ax1.set_title('Entanglement Entropy of the 14 Modes at λ = 4',
                  fontsize=13, fontweight='bold')
    ax1.grid(True, linestyle=':', alpha=0.6, axis='y')
    plt.tight_layout()
    plt.savefig('qi_figure1_entanglement_entropy.png', dpi=150)
    plt.show()

    # Figure 2 — OTOC
    fig2, ax2 = plt.subplots(figsize=(9, 6))
    ax2.plot(t_array, otoc, color='#ff7f0e', linewidth=2.5)
    ax2.axvline(scrambling_time, color='red', linestyle='--', linewidth=2,
                label=f'Scrambling time = {scrambling_time:.2f}')
    ax2.axhline(otoc_max / 2, color='gray', linestyle=':', linewidth=1.5,
                label='Half max')
    ax2.set_xlabel('Time t', fontsize=12)
    ax2.set_ylabel('OTOC C(t)', fontsize=12)
    ax2.set_title('Out-of-Time-Order Correlator', fontsize=13, fontweight='bold')
    ax2.grid(True, linestyle=':', alpha=0.6)
    ax2.legend(frameon=True, facecolor='white', fontsize=11)
    plt.tight_layout()
    plt.savefig('qi_figure2_otoc.png', dpi=150)
    plt.show()

    # Figure 3 — Page curve
    fig3, ax3 = plt.subplots(figsize=(9, 6))
    ax3.plot(subsystem_sizes, page_curve, color='#2ca02c', linewidth=2.5)
    ax3.axvline(N // 4, color='red', linestyle='--', linewidth=1.5,
                alpha=0.7, label='N/4')
    ax3.axvline(N // 2, color='gray', linestyle=':', linewidth=1.5,
                alpha=0.7, label='N/2')
    ax3.set_xlabel('Subsystem size |A|', fontsize=12)
    ax3.set_ylabel('Entanglement entropy S_A', fontsize=12)
    ax3.set_title('Page Curve of the 8×8 Torus Ground State',
                  fontsize=13, fontweight='bold')
    ax3.grid(True, linestyle=':', alpha=0.6)
    ax3.legend(frameon=True, facecolor='white', fontsize=11)
    plt.tight_layout()
    plt.savefig('qi_figure3_page_curve.png', dpi=150)
    plt.show()

    # Figure 4 — Spectral form factor
    fig4, ax4 = plt.subplots(figsize=(9, 6))
    ax4.plot(t_sff, sff, color='#d62728', linewidth=2.5)
    ax4.set_xlabel('Time t', fontsize=12)
    ax4.set_ylabel('Spectral form factor K(t)', fontsize=12)
    ax4.set_title('Spectral Form Factor of the 8×8 Torus',
                  fontsize=13, fontweight='bold')
    ax4.grid(True, linestyle=':', alpha=0.6)
    plt.tight_layout()
    plt.savefig('qi_figure4_sff.png', dpi=150)
    plt.show()

    # -------------------------------------------------------------------------
    # Summary
    # -------------------------------------------------------------------------
    print("=" * 70)
    print("SUMMARY")
    print("=" * 70)
    print()
    print("Quantum information properties of the 8×8 torus:")
    print()
    print(f"  1. Entanglement entropy of the 14 modes:")
    print(f"     Min: {entropies.min():.4f}")
    print(f"     Max: {entropies.max():.4f}")
    print(f"     Mean: {entropies.mean():.4f}")
    print()
    print(f"  2. OTOC scrambling time: {scrambling_time:.4f}")
    print()
    print(f"  3. Page curve maximum: {np.max(page_curve):.4f}")
    print(f"     At subsystem size: {subsystem_sizes[np.argmax(page_curve)]}")
    print()
    print(f"  4. Spectral form factor:")
    print(f"     SFF(0): {sff[0]:.4f}")
    print(f"     SFF min: {np.min(sff):.4f}")
    print()
    print("These are standard quantum information calculations.")
    print("They are derived from the torus Laplacian.")
    print()
    print("=" * 70)


if __name__ == "__main__":
    main()
