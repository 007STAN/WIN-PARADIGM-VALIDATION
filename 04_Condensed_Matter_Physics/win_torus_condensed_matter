import numpy as np
import matplotlib.pyplot as plt
from numpy.linalg import eigh


# ============================================================
# BUILD THE 8x8 TORUS
# ============================================================
L = 8
N = L * L
t = 1.0


def torus_index(x, y):
    return (x % L) * L + (y % L)


def build_laplacian():
    """Tight-binding Hamiltonian (Laplacian) on the torus."""
    H = np.zeros((N, N))
    for x in range(L):
        for y in range(L):
            i = torus_index(x, y)
            H[i, i] = 4.0 * t
            H[i, torus_index(x + 1, y)] -= t
            H[i, torus_index(x - 1, y)] -= t
            H[i, torus_index(x, y + 1)] -= t
            H[i, torus_index(x, y - 1)] -= t
    return H


def build_laplacian_spin(spin_x, spin_y):
    """
    Build the Laplacian with a specific spin structure.

    spin_x = +1 (periodic) or -1 (anti-periodic) in x
    spin_y = +1 (periodic) or -1 (anti-periodic) in y
    """
    H = np.zeros((N, N))
    for x in range(L):
        for y in range(L):
            i = torus_index(x, y)
            H[i, i] = 4.0 * t

            nx = (x + 1) % L
            sign_x = spin_x if nx == 0 else 1
            H[i, torus_index(nx, y)] -= t * sign_x

            nx2 = (x - 1) % L
            sign_x2 = spin_x if x == 0 else 1
            H[i, torus_index(nx2, y)] -= t * sign_x2

            ny = (y + 1) % L
            sign_y = spin_y if ny == 0 else 1
            H[i, torus_index(x, ny)] -= t * sign_y

            ny2 = (y - 1) % L
            sign_y2 = spin_y if y == 0 else 1
            H[i, torus_index(x, ny2)] -= t * sign_y2
    return H


# ============================================================
# SPECTRUM AND DEGENERACY
# ============================================================
def spectrum_at_midpoint(H):
    """
    Compute the spectrum and the multiplicity at the mirror
    fixed point (lambda = 4) for an even-dimensional torus.
    """
    eigenvalues = eigh(H)[0]
    lam_max = eigenvalues.max()
    lam_min = eigenvalues.min()
    lam_mid = (lam_max + lam_min) / 2
    count = int(np.sum(np.abs(eigenvalues - lam_mid) < 1e-6))
    return eigenvalues, lam_mid, count


def unique_spectrum(eigenvalues):
    """Return (unique_values, multiplicities)."""
    vals, counts = np.unique(np.round(eigenvalues, 6), return_counts=True)
    return vals, counts


# ============================================================
# CHIRAL SPLIT OF THE 14 MODES
# ============================================================
def chiral_split(eigenvalues, eigenvectors, lam=4.0):
    """
    Compute the 7 + 7 chiral split of the 14 modes at lambda = 4.

    The chirality sign is the sign of the antisymmetric combination
    cos(pi*n1/4) - cos(pi*n2/4). For modes with this difference = 0,
    a secondary rule (n1 - n2) mod 8 < 4 is used.
    """
    idx = np.where(np.abs(eigenvalues - lam) < 1e-6)[0]
    left, right = [], []
    for k in idx:
        # Extract the winding numbers by looking at the mode structure
        # Instead, we use the standard analytic labels for lambda = 4
        pass
    return idx


# The 14 modes at lambda = 4, with their (n1, n2) quantum numbers
MODES_AT_4 = [
    (0, 4), (4, 0),
    (1, 3), (1, 5), (3, 1), (3, 7),
    (5, 1), (5, 7), (7, 3), (7, 5),
    (2, 2), (2, 6), (6, 2), (6, 6),
]


def chiral_counts():
    """Count left and right modes among the 14 at lambda = 4."""
    left, right = [], []
    for (n1, n2) in MODES_AT_4:
        c1 = np.cos(np.pi * n1 / 4)
        c2 = np.cos(np.pi * n2 / 4)
        s = c1 - c2
        if s > 1e-6:
            left.append((n1, n2))
        elif s < -1e-6:
            right.append((n1, n2))
        else:
            # Secondary rule for the zero modes
            if (n1 - n2) % 8 < 4:
                left.append((n1, n2))
            else:
                right.append((n1, n2))
    return left, right


# ============================================================
# PERTURBATION
# ============================================================
def perturbed_spectrum(epsilon=0.1, seed=42):
    """Add a symmetric random perturbation and return the new spectrum."""
    rng = np.random.default_rng(seed)
    H = build_laplacian()
    P = rng.normal(0, epsilon, (N, N))
    P = (P + P.T) / 2
    return eigh(H + P)[0]


