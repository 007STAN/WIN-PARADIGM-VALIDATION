# Entropy per orbit (bits)
ENTROPY = {"O0": 6.0, "O1": 5.5, "O2": 5.0}

# ============================================================
# BUILD THE 8×8 TORUS
# ============================================================
def torus_index(x, y):
    return (x % L) * L + (y % L)


def build_laplacian():
    """Tight-binding Hamiltonian (Laplacian) on the torus."""
    H = np.zeros((N_sites, N_sites))
    for x in range(L):
        for y in range(L):
            i = torus_index(x, y)
            H[i, i] = 4.0 * t
            H[i, torus_index(x + 1, y)] -= t
            H[i, torus_index(x - 1, y)] -= t
            H[i, torus_index(x, y + 1)] -= t
            H[i, torus_index(x, y - 1)] -= t
    return H


def build_laplacian_spin(spin_x, spin_y):
    """Laplacian with specified spin structure on the torus."""
    H = np.zeros((N_sites, N_sites))
    for x in range(L):
        for y in range(L):
            i = torus_index(x, y)
            H[i, i] = 4.0 * t

            nx = (x + 1) % L
            sign_x = spin_x if nx == 0 else 1
            H[i, torus_index(nx, y)] -= t * sign_x

            nx2 = (x - 1) % L
            sign_x2 = spin_x if x == 0 else 1
            H[i, torus_index(nx2, y)] -= t * sign_x2

            ny = (y + 1) % L
            sign_y = spin_y if ny == 0 else 1
            H[i, torus_index(x, ny)] -= t * sign_y

            ny2 = (y - 1) % L
            sign_y2 = spin_y if y == 0 else 1
            H[i, torus_index(x, ny2)] -= t * sign_y2
    return H


def spectrum_at_midpoint(H):
    eigenvalues = eigh(H)[0]
    lam_mid = (eigenvalues.max() + eigenvalues.min()) / 2
    count = int(np.sum(np.abs(eigenvalues - lam_mid) < 1e-6))
    return eigenvalues, lam_mid, count


def unique_spectrum(eigenvalues):
    vals, counts = np.unique(np.round(eigenvalues, 6), return_counts=True)
    return vals, counts


# ============================================================
# D₄ ORBIT AND SUPPORT STRUCTURE
# ============================================================
def orbit_for_mode(n1, n2):
    """Return the orbit label for a mode."""
    if (n1, n2) in ORBIT_O0: return "O0"
    if (n1, n2) in ORBIT_O1: return "O1"
    if (n1, n2) in ORBIT_O2: return "O2"
    return "?"


def particle_name(n1, n2):
    """Map mode coordinates to the particle label (from the mass map)."""
    table = {
        (0, 4): "ν", (4, 0): "e",
        (1, 3): "u", (1, 5): "d", (3, 1): "s", (3, 7): "μ",
        (5, 7): "dark", (7, 3): "c", (7, 5): "τ", (5, 1): "b",
        (2, 2): "W", (2, 6): "Z", (6, 2): "H", (6, 6): "t",
    }
    return table.get((n1, n2), "?")


# ============================================================
# CHIRAL SPLIT (placeholder — see status note)
# ============================================================
def chiral_counts():
    """
    Compute a candidate 7 + 7 chiral split of the 14 modes.

    STATUS: The chiral assignment used here (based on the sign of
    cos(π n₁/4) − cos(π n₂/4), with a secondary rule for zero modes)
    is a PLACEHOLDER. It is consistent with the framework's empirical
    assignments but is not derived from the Hodge Z₂ grading.

    Deriving chirality from the Hodge Z₂ grading is an OPEN problem
    (Tier 3 in the framework handoff). This widget reports the
    placeholder split as such and flags the open problem.
    """
    left, right = [], []
    for (n1, n2) in MODES_AT_4:
        s = np.cos(np.pi * n1 / 4) - np.cos(np.pi * n2 / 4)
        if s > 1e-6:
            left.append((n1, n2))
        elif s < -1e-6:
            right.append((n1, n2))
        else:
            if (n1 - n2) % 8 < 4:
                left.append((n1, n2))
            else:
                right.append((n1, n2))
    return left, right


# ============================================================
# PROCESSOR T SPLIT
# ============================================================
# The processor T = P_mesh + P_τ projects onto 10 fermions + 4 bosons.
# From the WIN v2 overview (Layer 6).
FERMIONS = ["ν", "e", "u", "d", "s", "μ", "c", "b", "t", "τ"]
