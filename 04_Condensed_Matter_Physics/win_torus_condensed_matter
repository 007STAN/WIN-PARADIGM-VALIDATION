import numpy as np
import matplotlib.pyplot as plt
from numpy.linalg import eigh


# =============================================================================
# BUILD THE 8x8 TORUS
# =============================================================================
L = 8                      # lattice size
N = L * L                  # number of sites
t = 1.0                    # hopping amplitude


def torus_index(x, y):
    """Periodic boundary conditions on the 8x8 torus."""
    return (x % L) * L + (y % L)


def build_laplacian():
    """Build the tight-binding Hamiltonian (Laplacian) on the torus."""
    H = np.zeros((N, N))
    for x in range(L):
        for y in range(L):
            i = torus_index(x, y)
            H[i, i] = 4.0 * t
            H[i, torus_index(x + 1, y)] -= t
            H[i, torus_index(x - 1, y)] -= t
            H[i, torus_index(x, y + 1)] -= t
            H[i, torus_index(x, y - 1)] -= t
    return H


# =============================================================================
# PART 1 — BAND STRUCTURE
# =============================================================================
def band_structure():
    """
    Compute the tight-binding band structure.

    On an infinite 2D square lattice, the dispersion is:
        E(kx, ky) = 4t - 2t cos(kx) - 2t cos(ky)

    On the 8x8 torus, kx and ky are quantized:
        kx, ky in {0, 2pi/8, ..., 2pi*7/8}
    """
    H = build_laplacian()
    eigenvalues, eigenvectors = eigh(H)
    return eigenvalues, eigenvectors


# =============================================================================
# PART 2 — DENSITY OF STATES
# =============================================================================
def density_of_states(eigenvalues, bins=64):
    """
    Compute the density of states (DOS) from the eigenvalues.
    """
    dos, edges = np.histogram(eigenvalues, bins=bins, density=True)
    centers = 0.5 * (edges[:-1] + edges[1:])
    return centers, dos


# =============================================================================
# PART 3 — THE 14-FOLD DEGENERACY AT λ = 4
# =============================================================================
def degeneracy_at_energy(eigenvalues, energy, tol=1e-6):
    """
    Count the number of eigenvalues at the given energy (within tolerance).
    """
    mask = np.abs(eigenvalues - energy) < tol
    return np.sum(mask), np.where(mask)[0]


# =============================================================================
# PART 4 — FOUR SPIN STRUCTURES
# =============================================================================
def build_laplacian_spin(spin_x, spin_y):
    """
    Build the Laplacian with a specific spin structure.

    spin_x = +1 for periodic, -1 for anti-periodic in x
    spin_y = +1 for periodic, -1 for anti-periodic in y

    For anti-periodic boundary conditions, the hopping across the boundary
    picks up a factor of -1.
    """
    H = np.zeros((N, N))
    for x in range(L):
        for y in range(L):
            i = torus_index(x, y)
            H[i, i] = 4.0 * t

            # Hopping in x
            nx = (x + 1) % L
            if nx == 0:
                # Boundary crossing
                sign_x = spin_x
            else:
                sign_x = 1
            j = torus_index(nx, y)
            H[i, j] -= t * sign_x

            nx2 = (x - 1) % L
            if x == 0:
                sign_x2 = spin_x
            else:
                sign_x2 = 1
            j2 = torus_index(nx2, y)
            H[i, j2] -= t * sign_x2

            # Hopping in y
            ny = (y + 1) % L
            if ny == 0:
                sign_y = spin_y
            else:
                sign_y = 1
            k = torus_index(x, ny)
            H[i, k] -= t * sign_y

            ny2 = (y - 1) % L
            if y == 0:
                sign_y2 = spin_y
            else:
                sign_y2 = 1
            k2 = torus_index(x, ny2)
            H[i, k2] -= t * sign_y2
    return H


def spin_structure_counts():
    """
    Compute the mode counts at λ = 4 for each spin structure.
    """
    results = {}
    for sx, sy, label in [(+1, +1, '(+,+)'),
                          (+1, -1, '(+,−)'),
                          (-1, +1, '(−,+)'),
                          (-1, -1, '(−,−)')]:
        H = build_laplacian_spin(sx, sy)
        eigenvalues = eigh(H)[0]
        count, _ = degeneracy_at_energy(eigenvalues, 4.0)
        results[label] = count
    return results


# =============================================================================
# PART 5 — PERTURBATION
# =============================================================================
def perturbed_spectrum(epsilon=0.1, seed=42):
    """
    Add a small random perturbation to the Laplacian and compute the spectrum.
    """
    rng = np.random.default_rng(seed)
    H = build_laplacian()
    perturbation = rng.normal(0, epsilon, (N, N))
    perturbation = (perturbation + perturbation.T) / 2  # symmetrize
    H_perturbed = H + perturbation
    eigenvalues = eigh(H_perturbed)[0]
    return eigenvalues


