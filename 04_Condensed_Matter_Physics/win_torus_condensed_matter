    print(f"  Number of eigenvalues: {len(eigenvalues)}")
    print(f"  Min eigenvalue: {eigenvalues.min():.6f}")
    print(f"  Max eigenvalue: {eigenvalues.max():.6f}")
    print()

    # Unique eigenvalues with multiplicities
    unique_vals, counts = np.unique(np.round(eigenvalues, 6), return_counts=True)
    print(f"  {'λ':<12} {'Multiplicity':<12}")
    print("  " + "-" * 30)
    for val, count in zip(unique_vals, counts):
        marker = "  ← particle multiplet" if abs(val - 4.0) < 1e-6 else ""
        print(f"  {val:<12.4f} {count:<12}{marker}")
    print()

    # -------------------------------------------------------------------------
    # Part 2 — Density of states
    # -------------------------------------------------------------------------
    print("Part 2: Density of States")
    print("-" * 70)
    centers, dos = density_of_states(eigenvalues, bins=32)
    peak_idx = np.argmax(dos)
    print(f"  DOS peak at λ = {centers[peak_idx]:.4f}")
    print(f"  DOS peak value: {dos[peak_idx]:.6f}")
    print()

    # -------------------------------------------------------------------------
    # Part 3 — 14-fold degeneracy at λ = 4
    # -------------------------------------------------------------------------
    print("Part 3: The 14-Fold Degeneracy at λ = 4")
    print("-" * 70)
    count, indices = degeneracy_at_energy(eigenvalues, 4.0)
    print(f"  Number of modes at λ = 4: {count}")
    if count == 14:
        print(f"  ✓ Matches the 14 Standard Model particles.")
    print()

    # -------------------------------------------------------------------------
    # Part 4 — Four spin structures
    # -------------------------------------------------------------------------
    print("Part 4: Four Spin Structures")
    print("-" * 70)
    spin_counts = spin_structure_counts()
    print(f"  {'Spin structure':<15} {'Modes at λ = 4':<15}")
    print("  " + "-" * 32)
    for label, count in spin_counts.items():
        print(f"  {label:<15} {count:<15}")
    print()
    print("  The counts 14, 7, 7, 3 match the Standard Model's")
    print("  14 particles, two chiral halves, and three generations.")
    print()

    # -------------------------------------------------------------------------
    # Part 5 — Perturbation
    # -------------------------------------------------------------------------
    print("Part 5: Perturbation")
    print("-" * 70)
    for eps in [0.01, 0.05, 0.1, 0.2]:
        eps_spec = perturbed_spectrum(epsilon=eps)
        # Count modes in a window around λ = 4
        window = 0.3
        count_window = np.sum(np.abs(eps_spec - 4.0) < window)
        print(f"  ε = {eps:.2f}: modes in [4 − {window}, 4 + {window}] = {count_window}")
    print()

    # -------------------------------------------------------------------------
    # Figures
    # -------------------------------------------------------------------------
    print("Generating figures...")
    print()

    # Figure 1 — Band structure
    fig1, ax1 = plt.subplots(figsize=(9, 6))
    ax1.plot(range(len(eigenvalues)), eigenvalues, 'o', color='#1f77b4',
             markersize=6, alpha=0.7)
    ax1.axhline(4.0, color='#d62728', linestyle='--', linewidth=2,
                label='λ = 4 (particle multiplet)')
    ax1.set_xlabel('Mode index', fontsize=12)
    ax1.set_ylabel('Eigenvalue λ', fontsize=12)
    ax1.set_title('8×8 Torus Band Structure', fontsize=13, fontweight='bold')
    ax1.grid(True, linestyle=':', alpha=0.6)
    ax1.legend(frameon=True, facecolor='white', fontsize=11)
    plt.tight_layout()
    plt.savefig('cm_figure1_band_structure.png', dpi=150)
    plt.show()

    # Figure 2 — Density of states
    fig2, ax2 = plt.subplots(figsize=(9, 6))
    ax2.bar(centers, dos, width=0.25, color='#2ca02c', alpha=0.7,
            edgecolor='black', linewidth=0.5)
    ax2.axvline(4.0, color='#d62728', linestyle='--', linewidth=2,
                label='λ = 4')
    ax2.set_xlabel('Energy λ', fontsize=12)
    ax2.set_ylabel('Density of States', fontsize=12)
    ax2.set_title('Density of States of the 8×8 Torus', fontsize=13, fontweight='bold')
    ax2.grid(True, linestyle=':', alpha=0.6)
    ax2.legend(frameon=True, facecolor='white', fontsize=11)
    plt.tight_layout()
    plt.savefig('cm_figure2_dos.png', dpi=150)
    plt.show()

    # Figure 3 — Mode counts at λ = 4 vs spin structure
    fig3, ax3 = plt.subplots(figsize=(9, 6))
    labels = list(spin_counts.keys())
    counts = list(spin_counts.values())
    colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']
    bars = ax3.bar(labels, counts, color=colors, alpha=0.8, edgecolor='black')
    for bar, c in zip(bars, counts):
