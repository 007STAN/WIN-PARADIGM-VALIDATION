# MAIN
# =============================================================================
def main():
    print("=" * 70)
    print("WIN PARADIGM — CONDENSED MATTER PHYSICS OF THE 8×8 TORUS")
    print("=" * 70)
    print()

    # -------------------------------------------------------------------------
    # Part 1 — Band structure
    # -------------------------------------------------------------------------
    print("Part 1: Band Structure")
    print("-" * 70)
    eigenvalues, eigenvectors = band_structure()
