# ============================================================
# PERTURBATION
# ============================================================
def perturbed_spectrum(epsilon=0.1, seed=42):
    rng = np.random.default_rng(seed)
    H = build_laplacian()
    P = rng.normal(0, epsilon, (N_sites, N_sites))
    P = (P + P.T) / 2
    return eigh(H + P)[0]


