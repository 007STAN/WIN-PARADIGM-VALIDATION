    ax3.grid(True, linestyle=':', alpha=0.6, axis='y')
    ax3.set_ylim(0, 16)
    plt.tight_layout()
    plt.savefig('cm_figure3_spin_counts.png', dpi=150)
    plt.show()

    # Figure 4 — Perturbation effect on the degeneracy
    fig4, ax4 = plt.subplots(figsize=(9, 6))
    epsilons = [0.0, 0.01, 0.05, 0.1, 0.2]
    for eps in epsilons:
        if eps == 0.0:
            spec = eigenvalues
        else:
            spec = perturbed_spectrum(epsilon=eps)
        # Zoom in on the region around λ = 4
        mask = np.abs(spec - 4.0) < 1.0
        ax4.hist(spec[mask], bins=30, alpha=0.4, label=f'ε = {eps}')
    ax4.axvline(4.0, color='red', linestyle='--', linewidth=2, label='λ = 4')
    ax4.set_xlabel('Energy λ', fontsize=12)
    ax4.set_ylabel('Count', fontsize=12)
    ax4.set_title('Perturbation Effect on the 14-Fold Degeneracy',
                  fontsize=13, fontweight='bold')
    ax4.legend(frameon=True, facecolor='white', fontsize=10)
    ax4.grid(True, linestyle=':', alpha=0.6)
    plt.tight_layout()
    plt.savefig('cm_figure4_perturbation.png', dpi=150)
    plt.show()

    # -------------------------------------------------------------------------
    # Summary
    # -------------------------------------------------------------------------
    print("=" * 70)
    print("SUMMARY")
    print("=" * 70)
    print()
